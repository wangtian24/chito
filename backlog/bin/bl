#!/usr/bin/env python3
"""bl — a tiny local backlog: projects, tickets, a dependency DAG, leases, and an orchestrator.

SQLite at $BL_DB (default ~/.backlog/backlog.db). Stdlib only. Every write goes through here.
Part of chito (github.com/wangtian24/chito); design in backlog/docs/design.md.
"""
import argparse, json, os, re, shlex, signal, socket, sqlite3, subprocess, sys, time
from datetime import datetime, timedelta, timezone
from pathlib import Path

HOME = Path(os.environ.get("BL_HOME", Path.home() / ".backlog"))
DB = Path(os.environ.get("BL_DB", HOME / "backlog.db"))
LOGS = HOME / "logs"

STATES = ["backlog", "todo", "in_progress", "in_review", "done", "canceled", "failed"]
FINAL = ("done", "canceled")
SATISFIED = ("done", "canceled")          # states that unblock dependents
ACTIVE = ("todo", "in_progress", "in_review", "failed")   # what `run --until done` waits on

DEFAULTS = {
    "max_parallel": 3,          # per project
    "global_max_parallel": 6,   # tickets in flight across all projects and executors
    "daemon_enabled": True,
    "daemon_max_parallel": 6,   # daemon's share of the global cap
    "daemon_max_runs_per_day": 60,
    "orphan_policy": "adopt",   # adopt: a DSO session resumes stalled SO projects | daemon: run them as a queue | wait
    "adopt_after_minutes": 10,  # an SO project with ready tickets, no live owner and no activity this long gets adopted
    "orchestrate_min_ready": 1, # executor=auto (DSO): start an orchestrator session when this many tickets are ready (fewer: queue workers)
    "orchestrator_model": "opus",
    "brief_humans": True,       # the daemon prepares a briefing session for every unblocked human ticket
    "brief_model": "opus",
    "notify_human_cmd": "",     # how to tell the human a handoff is ready; empty = a macOS notification ($BL_MSG, $BL_TICKET, $BL_URL)
    "board_url": "http://localhost:8791/backlog",
    "quota_backoff_minutes": 30, # when a worker hits a usage limit and no reset time is given
    "quota_until": "",          # set automatically when a usage limit is hit; claims wait until then
    "max_attempts": 2,
    "lease_minutes": 30,
    "worker_timeout_minutes": 120,
    "model": "opus",            # default worker model; a ticket can set meta.model (e.g. sonnet) for simple work
    "worktree": True,
    "review": "ask",            # self | pr | ask
    "on_stuck": "wait",         # wait | exit
    "poll_seconds": 5,
    "notify_cmd": "",           # shell command; $BL_MSG holds the message
    "doc_hint": "Design docs (read these first)",  # how workers should fetch doc_slug docs, e.g. via your doc store's MCP
    "worker_cmd": (
        'claude -p "$(bl prompt $BL_TICKET)" --model "$BL_MODEL" '
        '--permission-mode bypassPermissions '
        '--append-system-prompt "You are a backlog worker for ticket $BL_TICKET. '
        'Follow the backlog-worker skill. Finish with bl done, bl fail or bl release."'
    ),
}

SCHEMA = """
PRAGMA foreign_keys=ON;
CREATE TABLE IF NOT EXISTS projects(
  key TEXT PRIMARY KEY, name TEXT NOT NULL, repo TEXT, doc_slug TEXT,
  status TEXT NOT NULL DEFAULT 'active', next_seq INTEGER NOT NULL DEFAULT 1,
  meta TEXT NOT NULL DEFAULT '{}', created TEXT NOT NULL, updated TEXT NOT NULL);
CREATE TABLE IF NOT EXISTS tickets(
  id INTEGER PRIMARY KEY, key TEXT UNIQUE NOT NULL,
  project TEXT NOT NULL REFERENCES projects(key),
  title TEXT NOT NULL, body TEXT NOT NULL DEFAULT '',
  state TEXT NOT NULL DEFAULT 'todo', priority INTEGER NOT NULL DEFAULT 2, estimate INTEGER,
  labels TEXT NOT NULL DEFAULT '[]', assignee TEXT, doc_slug TEXT,
  parent TEXT REFERENCES tickets(key), locks TEXT NOT NULL DEFAULT '[]',
  attempts INTEGER NOT NULL DEFAULT 0, max_attempts INTEGER,
  claimed_by TEXT, lease_until TEXT, result TEXT, meta TEXT NOT NULL DEFAULT '{}',
  created TEXT NOT NULL, updated TEXT NOT NULL, started TEXT, finished TEXT);
CREATE INDEX IF NOT EXISTS tickets_proj_state ON tickets(project, state);
CREATE TABLE IF NOT EXISTS deps(
  ticket TEXT NOT NULL REFERENCES tickets(key) ON DELETE CASCADE,
  blocker TEXT NOT NULL REFERENCES tickets(key) ON DELETE CASCADE,
  PRIMARY KEY(ticket, blocker), CHECK(ticket <> blocker));
CREATE INDEX IF NOT EXISTS deps_blocker ON deps(blocker);
CREATE TABLE IF NOT EXISTS events(
  id INTEGER PRIMARY KEY, ticket TEXT, project TEXT, kind TEXT NOT NULL, actor TEXT,
  body TEXT NOT NULL DEFAULT '', data TEXT NOT NULL DEFAULT '{}', at TEXT NOT NULL);
CREATE INDEX IF NOT EXISTS events_ticket ON events(ticket);
CREATE TABLE IF NOT EXISTS settings(
  scope TEXT NOT NULL, key TEXT NOT NULL, value TEXT NOT NULL, PRIMARY KEY(scope, key));
CREATE TABLE IF NOT EXISTS milestones(
  id INTEGER PRIMARY KEY, key TEXT UNIQUE NOT NULL, project TEXT NOT NULL REFERENCES projects(key),
  seq INTEGER NOT NULL, title TEXT NOT NULL, body TEXT NOT NULL DEFAULT '',
  trigger TEXT NOT NULL DEFAULT 'all',       -- all | deploy | manual
  gate TEXT,                                 -- ticket whose completion reaches the milestone (trigger=deploy)
  showcase_kind TEXT NOT NULL DEFAULT 'screenshot',  -- screenshot | demo | localhost | link | none
  showcase_ticket TEXT, showcases TEXT NOT NULL DEFAULT '[]', due TEXT,
  status TEXT NOT NULL DEFAULT 'planned',    -- planned | active | reached | showcased | canceled
  reached TEXT, created TEXT NOT NULL, updated TEXT NOT NULL);
CREATE TABLE IF NOT EXISTS runs(
  id INTEGER PRIMARY KEY, project TEXT, pid INTEGER, host TEXT, agent TEXT,
  started TEXT, heartbeat TEXT, ended TEXT, status TEXT);
"""


# ---------------------------------------------------------------- basics
def now():
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")

def later(minutes):
    return (datetime.now(timezone.utc) + timedelta(minutes=minutes)).strftime("%Y-%m-%dT%H:%M:%SZ")

def die(msg, code=1):
    print(f"bl: {msg}", file=sys.stderr)
    sys.exit(code)

def agent_id():
    if os.environ.get("BL_AGENT"):
        return os.environ["BL_AGENT"]
    sid = os.environ.get("CLAUDE_CODE_SESSION_ID")
    return f"cc:{sid[:8]}" if sid else f"user:{os.environ.get('USER', 'me')}"

def connect():
    DB.parent.mkdir(parents=True, exist_ok=True)
    c = sqlite3.connect(DB, timeout=30, isolation_level=None)
    c.row_factory = sqlite3.Row
    c.execute("PRAGMA journal_mode=WAL")
    c.execute("PRAGMA busy_timeout=30000")
    c.executescript(SCHEMA)
    cols = {r[1] for r in c.execute("PRAGMA table_info(events)")}
    if "session_id" not in cols:
        try:
            c.execute("ALTER TABLE events ADD COLUMN session_id TEXT")
        except sqlite3.OperationalError:
            pass  # another process added it first
    c.execute("CREATE INDEX IF NOT EXISTS events_session ON events(session_id)")
    migrate(c, "projects", {"executor": "TEXT NOT NULL DEFAULT 'session'", "owner": "TEXT", "owner_heartbeat": "TEXT",
                            "evergreen": "INTEGER NOT NULL DEFAULT 0", "instructions": "TEXT"})
    migrate(c, "runs", {"kind": "TEXT"})
    migrate(c, "tickets", {"milestone": "TEXT"})
    if c.execute("SELECT 1 FROM projects WHERE status='active' LIMIT 1").fetchone():
        try:
            c.execute("UPDATE projects SET status='executing' WHERE status='active'")
        except sqlite3.OperationalError:
            pass
    return c

def migrate(c, table, cols):
    have = {r[1] for r in c.execute(f"PRAGMA table_info({table})")}
    for name, decl in cols.items():
        if name not in have:
            try:
                c.execute(f"ALTER TABLE {table} ADD COLUMN {name} {decl}")
            except sqlite3.OperationalError:
                pass  # added concurrently

def session_id():
    """The Claude Code session running this command (None inside the orchestrator itself)."""
    if os.environ.get("BL_IN_ORCH"):
        return None
    return os.environ.get("CLAUDE_CODE_SESSION_ID") or None

class tx:
    """BEGIN IMMEDIATE … COMMIT: serializes writers across processes."""
    def __init__(self, c): self.c = c
    def __enter__(self):
        self.c.execute("BEGIN IMMEDIATE"); return self.c
    def __exit__(self, et, *_):
        self.c.execute("ROLLBACK" if et else "COMMIT")

def event(c, kind, ticket=None, project=None, body="", data=None, actor=None):
    if ticket and not project:
        r = c.execute("SELECT project FROM tickets WHERE key=?", (ticket,)).fetchone()
        project = r["project"] if r else None
    c.execute("INSERT INTO events(ticket,project,kind,actor,body,data,at,session_id) VALUES(?,?,?,?,?,?,?,?)",
              (ticket, project, kind, actor or agent_id(), body, json.dumps(data or {}), now(), session_id()))

def setting(c, key, project=None, labels=()):
    scopes = [f"label:{l}" for l in labels] + ([f"project:{project}"] if project else []) + ["global"]
    for s in scopes:
        r = c.execute("SELECT value FROM settings WHERE scope=? AND key=?", (s, key)).fetchone()
        if r:
            return json.loads(r["value"])
    return DEFAULTS.get(key)

def ticket(c, key):
    t = c.execute("SELECT * FROM tickets WHERE key=?", (key.upper(),)).fetchone()
    if not t:
        die(f"no ticket {key}")
    return t

def project_row(c, key):
    p = c.execute("SELECT * FROM projects WHERE key=?", (key.upper(),)).fetchone()
    if not p:
        die(f"no project {key}")
    return p

def out(args, obj, text):
    if getattr(args, "json", False):
        print(json.dumps(obj, indent=1, default=str))
    else:
        print(text)

def rowd(r):
    d = dict(r)
    for k in ("labels", "locks", "meta"):
        if k in d and isinstance(d[k], str):
            try: d[k] = json.loads(d[k])
            except Exception: pass
    return d

def csv(s):
    return [x.strip().upper() for x in s.split(",") if x.strip()] if s else []


# ---------------------------------------------------------------- graph rules
def blockers(c, key):
    return c.execute("SELECT b.* FROM deps d JOIN tickets b ON b.key=d.blocker WHERE d.ticket=? ORDER BY b.id",
                     (key,)).fetchall()

def dependents(c, key):
    return c.execute("SELECT t.* FROM deps d JOIN tickets t ON t.key=d.ticket WHERE d.blocker=? ORDER BY t.id",
                     (key,)).fetchall()

def would_cycle(c, tkt, blk):
    """Adding tkt→blk makes a cycle iff tkt is reachable from blk's blockers chain (blk waits on … tkt)."""
    r = c.execute("""WITH RECURSIVE up(k) AS (SELECT ? UNION SELECT d.blocker FROM deps d JOIN up ON d.ticket=up.k)
                     SELECT 1 FROM up WHERE k=? LIMIT 1""", (blk, tkt)).fetchone()
    return bool(r)

def add_dep(c, tkt, blk, force=False):
    tkt, blk = tkt.upper(), blk.upper()
    t, b = ticket(c, tkt), ticket(c, blk)
    if tkt == blk:
        die("a ticket cannot depend on itself")
    if would_cycle(c, tkt, blk):
        die(f"{tkt} → {blk} would create a cycle")
    if t["state"] == "in_progress" and b["state"] not in SATISFIED:
        if not force:
            die(f"{tkt} is in progress; pass --force to send it back to todo")
        c.execute("UPDATE tickets SET state='todo', claimed_by=NULL, lease_until=NULL, updated=? WHERE key=?", (now(), tkt))
        event(c, "state", tkt, body="in_progress → todo (new blocker added)")
    c.execute("INSERT OR IGNORE INTO deps(ticket, blocker) VALUES(?,?)", (tkt, blk))
    event(c, "dep", tkt, body=f"waits on {blk}")

READY_SQL = """
SELECT t.* FROM tickets t JOIN projects p ON p.key=t.project
WHERE t.state='todo' {proj} {mode}
  AND (t.assignee IS NULL OR t.assignee=:agent)
  AND NOT EXISTS (SELECT 1 FROM deps d JOIN tickets b ON b.key=d.blocker
                  WHERE d.ticket=t.key AND b.state NOT IN ('done','canceled'))
  AND NOT EXISTS (SELECT 1 FROM tickets r, json_each(r.locks) rl, json_each(t.locks) tl
                  WHERE r.state='in_progress' AND rl.value=tl.value)
  {only}
ORDER BY t.priority, t.id
"""

EXEC = "coalesce(json_extract(t.meta,'$.executor'), p.executor, 'session')"
MODE_SQL = {
    None: "",
    "session": f"AND p.status='executing' AND {EXEC}!='daemon'",
    "daemon": f"AND p.status='executing' AND ({EXEC}='daemon' OR (:adopt AND p.executor='session' AND {{orphan}}))",
    "auto1": "AND p.status='executing' AND p.executor='auto'",
    "adopt": f"AND p.status='executing' AND p.executor='session' AND {EXEC}!='daemon'",
}

def orphan_sql(c):
    """A session project whose owner stopped heartbeating and that has no live orchestrator."""
    return (f"(p.owner IS NOT NULL AND p.owner!='daemon' AND (p.owner_heartbeat IS NULL OR p.owner_heartbeat < "
            f"'{(datetime.now(timezone.utc) - timedelta(minutes=setting(c, 'lease_minutes'))).strftime('%Y-%m-%dT%H:%M:%SZ')}'))")

def ready(c, project=None, agent=None, only=None, mode=None):
    sql = READY_SQL.format(proj="AND t.project=:project" if project else "",
                           only="AND t.key=:only" if only else "",
                           mode=MODE_SQL[mode].replace("{orphan}", orphan_sql(c)))
    return c.execute(sql, {"project": project, "agent": agent or agent_id(), "only": only,
                           "adopt": 1 if setting(c, "orphan_policy") == "daemon" else 0}).fetchall()

def model_for(c, t):
    return json.loads(t["meta"]).get("model") or setting(c, "model", t["project"], json.loads(t["labels"]))

def finalize_projects(c):
    """Executing, non-evergreen projects with nothing left to do become done. Also refreshes milestones."""
    refresh_milestones(c)
    for p in c.execute("SELECT key FROM projects WHERE status='executing' AND evergreen=0").fetchall():
        n = c.execute("SELECT count(*) FROM tickets WHERE project=? AND state IN ('todo','in_progress','in_review','failed')",
                      (p["key"],)).fetchone()[0]
        done = c.execute("SELECT count(*) FROM tickets WHERE project=? AND state='done'", (p["key"],)).fetchone()[0]
        if n == 0 and done > 0:
            c.execute("UPDATE projects SET status='done', owner=NULL, updated=? WHERE key=?", (now(), p["key"]))
            event(c, "project", project=p["key"], body="executing → done (all tickets final)", actor="backlog")

SHOWCASE_DIR = HOME / "showcase"
SHOWCASE_HOW = {
    "screenshot": "Capture screenshots of the finished work (headless Playwright is fine). Save each image and record it: "
                  "`bl milestone showcase {m} --kind screenshot --file PATH --note \"what it shows\"`.",
    "demo": "Make a short demo: a GIF/video or a step-by-step walkthrough with screenshots. Record each piece with "
            "`bl milestone showcase {m} --kind demo --file PATH|--url URL --note \"...\"`.",
    "localhost": "Start the app locally on a free port and leave it running if the spec says so; otherwise record how to run it. "
                 "`bl milestone showcase {m} --kind localhost --url http://localhost:PORT --note \"how to start, what to try\"`.",
    "link": "Record the live link(s) where the result can be seen: `bl milestone showcase {m} --kind link --url URL --note \"...\"`.",
}

def milestone(c, key):
    m = c.execute("SELECT * FROM milestones WHERE key=?", (key.upper(),)).fetchone()
    if not m:
        die(f"no milestone {key}")
    return m

def ms_work(c, m):
    """The milestone's own tickets (excluding its showcase ticket)."""
    return c.execute("SELECT * FROM tickets WHERE milestone=? AND key IS NOT ? ORDER BY id",
                     (m["key"], m["showcase_ticket"])).fetchall()

def sync_showcase(c, m):
    """Keep the showcase ticket waiting on the right things, and out of the ready set until there is work."""
    st = m["showcase_ticket"]
    if not st:
        return
    t = c.execute("SELECT * FROM tickets WHERE key=?", (st,)).fetchone()
    if not t or t["state"] not in ("backlog", "todo"):
        return
    if m["trigger"] == "deploy" and m["gate"]:
        need = [m["gate"]]
    else:
        need = [w["key"] for w in ms_work(c, m) if w["state"] != "canceled"]
    for k in need:
        if not c.execute("SELECT 1 FROM deps WHERE ticket=? AND blocker=?", (st, k)).fetchone() and not would_cycle(c, st, k):
            c.execute("INSERT OR IGNORE INTO deps(ticket, blocker) VALUES(?,?)", (st, k))
    want = "todo" if need else "backlog"
    if t["state"] != want:
        c.execute("UPDATE tickets SET state=?, updated=? WHERE key=?", (want, now(), st))

def refresh_milestones(c, project=None):
    q, args = "SELECT * FROM milestones WHERE status NOT IN ('canceled','accepted')", []
    if project:
        q += " AND project=?"; args.append(project)
    for m in c.execute(q, args).fetchall():
        sync_showcase(c, m)
        work = ms_work(c, m)
        shows = json.loads(m["showcases"])
        st_t = c.execute("SELECT * FROM tickets WHERE key=?", (m["showcase_ticket"],)).fetchone() if m["showcase_ticket"] else None
        if m["trigger"] == "deploy":
            g = c.execute("SELECT state FROM tickets WHERE key=?", (m["gate"],)).fetchone() if m["gate"] else None
            reached = bool(g and g["state"] == "done")
        elif m["trigger"] == "manual":
            reached = m["reached"] is not None
        else:
            reached = bool(work) and all(w["state"] in ("done", "canceled") for w in work) and any(w["state"] == "done" for w in work)
        if reached and st_t and st_t["state"] == "done" and not shows and st_t["result"]:
            shows = [{"kind": "note", "note": st_t["result"], "ticket": st_t["key"], "at": now()}]
            c.execute("UPDATE milestones SET showcases=? WHERE key=?", (json.dumps(shows), m["key"]))
        showcase_done = m["showcase_kind"] == "none" or bool(shows) and (not st_t or st_t["state"] in ("done", "canceled"))
        if reached and showcase_done:
            new = "showcased" if shows else "reached"
        elif reached:
            new = "reached"
        elif any(w["state"] in ("in_progress", "in_review", "done") for w in work):
            new = "active"
        else:
            new = "planned"
        if new != m["status"]:
            c.execute("UPDATE milestones SET status=?, reached=CASE WHEN ? IN ('reached','showcased') THEN coalesce(reached, ?) ELSE reached END, "
                      "updated=? WHERE key=?", (new, new, now(), now(), m["key"]))
            event(c, "milestone", project=m["project"], body=f"{m['key']} {m['status']} → {new}: {m['title']}", actor="backlog")

def assign_milestone(c, tkey, mkey):
    if mkey:
        m = milestone(c, mkey)
        t = ticket(c, tkey)
        if m["project"] != t["project"]:
            die(f"{mkey} belongs to {m['project']}, not {t['project']}")
        c.execute("UPDATE tickets SET milestone=? WHERE key=?", (m["key"], tkey))
        sync_showcase(c, milestone(c, mkey))
    else:
        c.execute("UPDATE tickets SET milestone=NULL WHERE key=?", (tkey,))

def set_project_status(c, key, new, reason=""):
    p = project_row(c, key)
    if p["status"] == new:
        return
    c.execute("UPDATE projects SET status=?, updated=?" + (", owner=NULL" if new != "executing" else "") + " WHERE key=?",
              (new, now(), p["key"]))
    event(c, "project", project=p["key"], body=f"{p['status']} → {new}" + (f": {reason}" if reason else ""))

def reap(c):
    """Expired leases → back to todo (or failed when out of attempts)."""
    rows = c.execute("SELECT * FROM tickets WHERE state='in_progress' AND lease_until IS NOT NULL AND lease_until < ?",
                     (now(),)).fetchall()
    for t in rows:
        # A lapsed lease usually means the holder went away (closed session, usage limit, sleep), not that the
        # ticket is broken, so it doesn't use an attempt. Workers that exit without reporting do.
        release_ticket(c, t, "lease expired", count_failure=False, actor="reaper")

def release_ticket(c, t, reason, count_failure=False, actor=None):
    maxa = t["max_attempts"] or setting(c, "max_attempts", t["project"], json.loads(t["labels"]))
    if count_failure and t["attempts"] >= maxa:
        new = "failed"
    else:
        new = "todo"
    # a plain release (split / handoff / lease expiry / usage limit) gives the attempt back
    att = t["attempts"] if count_failure else max(0, t["attempts"] - 1)
    c.execute("UPDATE tickets SET state=?, attempts=?, claimed_by=NULL, lease_until=NULL, updated=?, "
              "finished=CASE WHEN ?='failed' THEN ? ELSE finished END WHERE key=?",
              (new, att, now(), new, now(), t["key"]))
    event(c, "state", t["key"], body=f"in_progress → {new}: {reason}", actor=actor)
    return new

QUOTA_RE = re.compile(r"(usage limit (?:reached|hit)|limit reached\||hit your (?:\w+ )?limit|out of (?:extra )?usage|rate_limit_error|overloaded_error|too many requests|\bstatus(?: code)?:? ?429\b|\b429 too many)", re.I)

def quota_until(c):
    q = setting(c, "quota_until") or ""
    return q if q and q > now() else None

def detect_quota(text):
    """Return (True, reset_iso or None) when worker output shows a usage/rate limit."""
    if not text or not QUOTA_RE.search(text):
        return False, None
    m = re.search(r"limit reached\|(\d{10})", text)
    if m:
        return True, datetime.fromtimestamp(int(m.group(1)), timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    m = re.search(r"resets?\s+(?:at\s+)?(\d{1,2})(?::(\d{2}))?\s*(am|pm)", text, re.I)
    if m:
        h = int(m.group(1)) % 12 + (12 if m.group(3).lower() == "pm" else 0)
        loc = datetime.now().astimezone()
        t = loc.replace(hour=h, minute=int(m.group(2) or 0), second=0, microsecond=0)
        if t <= loc:
            t += timedelta(days=1)
        return True, t.astimezone(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    return True, None

def note_quota(c, key, text, actor):
    """A worker stopped on a usage limit: pause all claims until the reset time and notify once."""
    _, reset = detect_quota(text)
    until = reset or later(setting(c, "quota_backoff_minutes"))
    cur = setting(c, "quota_until") or ""
    if until > cur:
        c.execute("INSERT OR REPLACE INTO settings VALUES('global','quota_until',?)", (json.dumps(until),))
    line = next((l for l in reversed(text.splitlines()) if QUOTA_RE.search(l)), "")[:200]
    event(c, "quota", key, body=f"usage limit hit; claims paused until {until}: {line}", actor=actor, data={"until": until})
    return until

def log_tail(lf_name, n=6000):
    try:
        with open(lf_name, "rb") as f:
            f.seek(0, 2); size = f.tell(); f.seek(max(0, size - n))
            return f.read().decode("utf-8", "replace")
    except Exception:
        return ""

def claim(c, project=None, key=None, agent=None, lease=None, force=False, mode="session"):
    agent = agent or agent_id()
    with tx(c):
        reap(c)
        if not force and quota_until(c):
            return None, f"paused for usage limit until {quota_until(c)} (bl quota clear to retry now)"
        if not force and mode == "daemon":
            if not setting(c, "daemon_enabled"):
                return None, "daemon paused"
            dmax = setting(c, "daemon_max_parallel")
            if c.execute("SELECT count(*) FROM tickets WHERE state='in_progress' AND claimed_by LIKE 'daemon:%'").fetchone()[0] >= dmax:
                return None, f"daemon cap reached ({dmax})"
            today = datetime.now(timezone.utc).strftime("%Y-%m-%dT00:00:00Z")
            runs = c.execute("SELECT count(*) FROM events WHERE kind='claim' AND actor LIKE 'daemon:%' AND at>=?", (today,)).fetchone()[0]
            if runs >= setting(c, "daemon_max_runs_per_day"):
                return None, f"daemon daily limit reached ({runs})"
        if not force:
            gmax = setting(c, "global_max_parallel")
            if c.execute("SELECT count(*) FROM tickets WHERE state='in_progress'").fetchone()[0] >= gmax:
                return None, f"global cap reached ({gmax} in progress)"
            if project:
                pmax = setting(c, "max_parallel", project)
                if c.execute("SELECT count(*) FROM tickets WHERE state='in_progress' AND project=?",
                             (project,)).fetchone()[0] >= pmax:
                    return None, f"project cap reached ({pmax} in progress in {project})"
        rows = ready(c, project, agent, key, None if force else mode)
        if not rows:
            if not force and project:
                pr = c.execute("SELECT status, executor FROM projects WHERE key=?", (project,)).fetchone()
                if pr and pr["status"] != "executing":
                    return None, f"project {project} is {pr['status']} (bl project start {project})"
                if pr and mode == "session" and pr["executor"] == "daemon":
                    return None, f"project {project} is run by the daemon (bl project set {project} executor=session to take over)"
            return None, "nothing ready"
        t = rows[0]
        if mode == "session" and not force:
            # the claiming session/orchestrator owns the project while it works it
            owner = os.environ.get("BL_OWNER") or agent
            c.execute("UPDATE projects SET owner=?, owner_heartbeat=? WHERE key=? AND executor='session'",
                      (owner, now(), t["project"]))
        mins = lease or setting(c, "lease_minutes", t["project"], json.loads(t["labels"]))
        c.execute("UPDATE tickets SET state='in_progress', claimed_by=?, attempts=attempts+1, lease_until=?, "
                  "started=coalesce(started, ?), updated=? WHERE key=? AND state='todo'",
                  (agent, later(mins), now(), now(), t["key"]))
        event(c, "claim", t["key"], body=f"claimed by {agent} (attempt {t['attempts'] + 1})", actor=agent)
        return ticket(c, t["key"]), None


# ---------------------------------------------------------------- commands
def cmd_init(a):
    c = connect()
    print(f"ok {DB}")

def cmd_project(a):
    c = connect()
    if a.action == "add":
        key = a.key.upper()
        with tx(c):
            c.execute("INSERT INTO projects(key,name,repo,doc_slug,status,executor,evergreen,created,updated) "
                      "VALUES(?,?,?,?,'planning',?,?,?,?)",
                      (key, a.name or key, os.path.expanduser(a.repo) if a.repo else None, a.doc,
                       a.executor or "session", 1 if a.evergreen else 0, now(), now()))
            if a.review:
                c.execute("INSERT OR REPLACE INTO settings VALUES(?,?,?)", (f"project:{key}", "review", json.dumps(a.review)))
            event(c, "created", project=key, body=f"project {key}")
        print(key)
    elif a.action == "ls":
        rows = c.execute("""SELECT p.*, (SELECT json_group_object(state, n) FROM
                 (SELECT state, count(*) n FROM tickets WHERE project=p.key GROUP BY state)) counts
                 FROM projects p ORDER BY key""").fetchall()
        out(a, [rowd(r) for r in rows],
            "\n".join(f"{r['key']:16} {r['status']:9} {r['executor']:7}{' evergreen' if r['evergreen'] else ''}  {r['name']}  {r['counts']}  {r['repo'] or ''}"
                      for r in rows) or "(no projects)")
    elif a.action in ("start", "pause", "resume", "plan", "archive", "done"):
        new = {"start": "executing", "resume": "executing", "pause": "paused", "plan": "planning",
               "archive": "archived", "done": "done"}[a.action]
        with tx(c):
            set_project_status(c, a.key, new, " ".join(([a.name] if a.name else []) + a.fields))
        print(new)
    elif a.action == "set":
        p = project_row(c, a.key)
        fields = ([a.name] if a.name else []) + a.fields   # `name` is positional for `add`; here it is the first field
        if not fields or any("=" not in f for f in fields):
            die("usage: bl project set KEY field=value ...")
        with tx(c):
            for kv in fields:
                k, v = kv.split("=", 1)
                if k not in ("name", "repo", "doc_slug", "status", "executor", "evergreen", "instructions"):
                    die(f"unknown project field {k}")
                if k == "executor" and v not in ("daemon", "session", "auto"):
                    die("executor must be session (SO: you start an orchestrator), auto (DSO: the daemon starts orchestrator sessions) or daemon (DQ: queue)")
                if k == "instructions" and v == "-":
                    v = sys.stdin.read().strip()
                if k == "evergreen":
                    v = 1 if v.lower() in ("1", "true", "yes", "on") else 0
                c.execute(f"UPDATE projects SET {k}=?, updated=? WHERE key=?", (v if v != "" else None, now(), p["key"]))
                event(c, "project", project=p["key"], body=f"{k}={v}" if k != "instructions" else f"instructions updated: {(v or '(cleared)')[:200]}")
        print("ok")

def cmd_add(a):
    c = connect()
    proj = project_row(c, a.project)["key"]
    body = Path(a.file).read_text() if a.file else (a.body or "")
    if body == "-":
        body = sys.stdin.read()
    if a.state not in STATES:
        die(f"state must be one of {STATES}")
    with tx(c):
        seq = c.execute("UPDATE projects SET next_seq=next_seq+1 WHERE key=? RETURNING next_seq-1", (proj,)).fetchone()[0]
        key = f"{proj}-{seq}"
        meta = {}
        if a.review: meta["review"] = a.review
        if a.size: meta["size"] = a.size
        if a.model: meta["model"] = a.model
        if a.executor: meta["executor"] = a.executor
        if c.execute("SELECT status FROM projects WHERE key=?", (proj,)).fetchone()["status"] == "done" and a.state == "todo":
            set_project_status(c, proj, "executing", f"new ticket {key}")
        c.execute("""INSERT INTO tickets(key,project,title,body,state,priority,estimate,labels,assignee,doc_slug,parent,
                     locks,max_attempts,meta,created,updated) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)""",
                  (key, proj, a.title, body, a.state, a.priority, a.estimate,
                   json.dumps([l.strip() for l in (a.labels or "").split(",") if l.strip()]),
                   a.assignee, a.doc, a.parent.upper() if a.parent else None,
                   json.dumps([l.strip() for l in (a.lock or "").split(",") if l.strip()]),
                   a.max_attempts, json.dumps(meta), now(), now()))
        event(c, "created", key, proj, body=a.title)
        for b in csv(a.after):
            add_dep(c, key, b)
        for d in csv(a.blocks):
            add_dep(c, d, key, force=a.force)
        if a.milestone:
            assign_milestone(c, key, a.milestone)
    out(a, {"key": key}, key)

def fmt_line(t, extra=""):
    lab = json.loads(t["labels"])
    who = f" @{t['claimed_by']}" if t["claimed_by"] else (f" ({t['assignee']})" if t["assignee"] else "")
    return f"{t['key']:9} {t['state']:11} p{t['priority']} {t['title']}{who}{' [' + ','.join(lab) + ']' if lab else ''}{extra}"

def cmd_ls(a):
    c = connect()
    q, p = "SELECT * FROM tickets WHERE 1=1", []
    if a.project:
        q += " AND project=?"; p.append(a.project.upper())
    if a.state:
        q += f" AND state IN ({','.join('?' * len(a.state.split(',')))})"; p += a.state.split(",")
    elif not a.all:
        q += " AND state NOT IN ('done','canceled')"
    if a.mine:
        q += " AND claimed_by=?"; p.append(agent_id())
    if a.assignee:
        q += " AND assignee=?"; p.append(a.assignee)
    rows = c.execute(q + " ORDER BY project, priority, id", p).fetchall()
    if a.ready:
        rk = {r["key"] for r in ready(c, a.project.upper() if a.project else None)}
        rows = [r for r in rows if r["key"] in rk]
    def extra(t):
        bs = [b["key"] for b in blockers(c, t["key"]) if b["state"] not in SATISFIED]
        return f"  ⟵ {','.join(bs)}" if bs and t["state"] == "todo" else ""
    out(a, [rowd(r) for r in rows], "\n".join(fmt_line(r, extra(r)) for r in rows) or "(none)")

def cmd_show(a):
    c = connect()
    t = ticket(c, a.key)
    bl_ = blockers(c, t["key"]); de = dependents(c, t["key"])
    evs = c.execute("SELECT * FROM events WHERE ticket=? ORDER BY id", (t["key"],)).fetchall()
    d = rowd(t)
    d["blockers"] = [{"key": b["key"], "state": b["state"], "title": b["title"], "result": b["result"]} for b in bl_]
    d["dependents"] = [{"key": x["key"], "state": x["state"], "title": x["title"]} for x in de]
    d["events"] = [dict(e) for e in evs]
    lines = [f"{t['key']}  {t['title']}", f"state={t['state']} priority={t['priority']} attempts={t['attempts']}"
             f"{' claimed_by=' + t['claimed_by'] + ' lease_until=' + t['lease_until'] if t['claimed_by'] else ''}",
             f"labels={t['labels']} locks={t['locks']} assignee={t['assignee']} doc={t['doc_slug']} meta={t['meta']}"]
    if bl_: lines.append("waits on: " + ", ".join(f"{b['key']}({b['state']})" for b in bl_))
    if de: lines.append("blocks:   " + ", ".join(f"{x['key']}({x['state']})" for x in de))
    lines += ["", t["body"] or "(no body)"]
    if t["result"]: lines += ["", "RESULT: " + t["result"]]
    if evs:
        lines += ["", "events:"] + [f"  {e['at']} {e['kind']:8} {e['actor']}: {e['body']}" for e in evs[-15:]]
    out(a, d, "\n".join(lines))

def cmd_next(a):
    c = connect()
    with tx(c):
        reap(c)
    rows = ready(c, a.project.upper() if a.project else None)
    out(a, [rowd(r) for r in rows], "\n".join(fmt_line(r) for r in rows) or "(nothing ready)")

def levels(c, project):
    """Topological waves of the not-yet-final tickets, assuming each one succeeds."""
    rows = c.execute("SELECT * FROM tickets WHERE project=? ORDER BY priority, id", (project,)).fetchall()
    by = {r["key"]: r for r in rows}
    pending = {k for k, r in by.items() if r["state"] not in FINAL + ("backlog",)}
    deps = {k: {d["blocker"] for d in c.execute("SELECT blocker FROM deps WHERE ticket=?", (k,))} for k in pending}
    done = set()
    def ok(b):  # outside-of-project or final blockers count as done; unknown external ones as pending
        if b in done: return True
        if b in by: return by[b]["state"] in SATISFIED
        r = c.execute("SELECT state FROM tickets WHERE key=?", (b,)).fetchone()
        return r and r["state"] in SATISFIED
    waves = []
    while pending:
        w = [k for k in pending if all(ok(b) for b in deps[k])]
        if not w:
            waves.append(sorted(pending, key=lambda k: by[k]["id"])); break   # blocked externally
        w.sort(key=lambda k: (by[k]["priority"], by[k]["id"]))
        waves.append(w); done |= set(w); pending -= set(w)
    return waves, by

def cmd_graph(a):
    c = connect()
    proj = project_row(c, a.project)["key"]
    if a.mermaid:
        rows = c.execute("SELECT * FROM tickets WHERE project=? AND (? OR state NOT IN ('canceled'))", (proj, a.all)).fetchall()
        keys = {r["key"] for r in rows}
        lines = ["graph TD"]
        for r in rows:
            title = r["title"].replace('"', "'")
            lines.append(f'  {r["key"].replace("-", "_")}["{r["key"]} {title}<br/><i>{r["state"]}</i>"]:::{r["state"]}')
        for d in c.execute("SELECT * FROM deps"):
            if d["ticket"] in keys:
                lines.append(f'  {d["blocker"].replace("-", "_")} --> {d["ticket"].replace("-", "_")}')
        lines += ["  classDef done fill:#d4edda,stroke:#28a745", "  classDef in_progress fill:#fff3cd,stroke:#e0a800",
                  "  classDef failed fill:#f8d7da,stroke:#dc3545", "  classDef in_review fill:#d1ecf1,stroke:#17a2b8",
                  "  classDef backlog fill:#eee,stroke:#999,color:#777", "  classDef canceled fill:#eee,stroke:#ccc,color:#aaa",
                  "  classDef todo fill:#fff,stroke:#555"]
        print("\n".join(lines)); return
    waves, by = levels(c, proj)
    fin = [k for k, r in by.items() if r["state"] in FINAL]
    if fin:
        print(f"final ({len(fin)}): " + ", ".join(fin))
    bk = [k for k, r in by.items() if r["state"] == "backlog"]
    if bk:
        print(f"backlog, not scheduled ({len(bk)}): " + ", ".join(bk))
    for i, w in enumerate(waves):
        print(f"wave {i + 1}:")
        for k in w:
            bs = [d["blocker"] for d in c.execute("SELECT blocker FROM deps WHERE ticket=?", (k,))]
            print("  " + fmt_line(by[k], f"  ⟵ {','.join(bs)}" if bs else ""))

def cmd_dep(a):
    c = connect()
    with tx(c):
        if a.action == "add":
            for b in csv(a.blocker):
                add_dep(c, a.ticket, b, force=a.force)
        else:
            for b in csv(a.blocker):
                c.execute("DELETE FROM deps WHERE ticket=? AND blocker=?", (a.ticket.upper(), b))
                event(c, "dep", a.ticket.upper(), body=f"no longer waits on {b}")
    print("ok")

def cmd_claim(a):
    c = connect()
    proj = a.project.upper() if a.project else None
    key = a.key.upper() if a.key else None
    if key and not proj:
        proj = ticket(c, key)["project"]
    t, why = claim(c, proj, key, lease=a.lease, force=a.force)
    if not t:
        if a.json: print(json.dumps({"claimed": None, "reason": why}))
        else: print(f"(no claim: {why})")
        sys.exit(3)
    out(a, rowd(t), fmt_line(t))

def own_check(t, a):
    if t["state"] != "in_progress":
        die(f"{t['key']} is {t['state']}, not in_progress")
    if t["claimed_by"] != agent_id() and not getattr(a, "force", False):
        die(f"{t['key']} is claimed by {t['claimed_by']}, not {agent_id()} (pass --force)")

def cmd_beat(a):
    c = connect()
    with tx(c):
        keys = [k.upper() for k in a.keys] or [r["key"] for r in c.execute(
            "SELECT key FROM tickets WHERE state='in_progress' AND claimed_by=?", (agent_id(),))]
        for k in keys:
            t = ticket(c, k)
            mins = a.lease or setting(c, "lease_minutes", t["project"], json.loads(t["labels"]))
            c.execute("UPDATE tickets SET lease_until=? WHERE key=? AND state='in_progress'", (later(mins), k))
    print("ok " + " ".join(keys))

def cmd_release(a):
    c = connect()
    with tx(c):
        t = ticket(c, a.key); own_check(t, a)
        new = release_ticket(c, t, a.reason or "released")
    print(new)

def review_policy(c, t):
    m = json.loads(t["meta"])
    return m.get("review") or setting(c, "review", t["project"], json.loads(t["labels"]))

def cmd_done(a):
    c = connect()
    with tx(c):
        t = ticket(c, a.key)
        if t["state"] == "in_review":
            new = "done"
        else:
            own_check(t, a)
            pol = "self" if a.final else review_policy(c, t)
            new = "done" if pol == "self" else "in_review"
        c.execute("UPDATE tickets SET state=?, result=coalesce(?, result), claimed_by=NULL, lease_until=NULL, updated=?, "
                  "finished=CASE WHEN ?='done' THEN ? ELSE finished END WHERE key=?",
                  (new, a.message, now(), new, now(), t["key"]))
        note = ""
        if new == "in_review" and review_policy(c, t) == "ask":
            note = " (no review policy for this repo: needs a human to approve, or set one with `bl config project:"\
                   f"{t['project']} review self|pr`)"
        event(c, "state", t["key"], body=f"{t['state']} → {new}{note}" + (f": {a.message}" if a.message else ""))
        finalize_projects(c)
    print(new + note)

def cmd_fail(a):
    c = connect()
    with tx(c):
        t = ticket(c, a.key); own_check(t, a)
        if a.message:
            event(c, "comment", t["key"], body="FAIL: " + a.message)
            c.execute("UPDATE tickets SET result=? WHERE key=?", ("FAILED: " + a.message, t["key"]))
        t = ticket(c, a.key)
        new = release_ticket(c, t, a.message or "failed", count_failure=True)
    print(new)

def cmd_comment(a):
    c = connect()
    with tx(c):
        t = ticket(c, a.key)
        event(c, "comment", t["key"], body=" ".join(a.text))
    print("ok")

def cmd_move(a):
    c = connect()
    if a.state not in STATES:
        die(f"state must be one of {STATES}")
    with tx(c):
        t = ticket(c, a.key)
        fin = now() if a.state in FINAL + ("failed",) else None
        c.execute("UPDATE tickets SET state=?, claimed_by=NULL, lease_until=NULL, updated=?, finished=? WHERE key=?",
                  (a.state, now(), fin, t["key"]))
        if a.state == "todo" and a.reset:
            c.execute("UPDATE tickets SET attempts=0 WHERE key=?", (t["key"],))
        event(c, "state", t["key"], body=f"{t['state']} → {a.state}" + (f": {a.reason}" if a.reason else ""))
        if a.state == "todo" and project_row(c, t["project"])["status"] == "done":
            set_project_status(c, t["project"], "executing", f"{t['key']} reopened")
        finalize_projects(c)
    print(a.state)

def cmd_set(a):
    c = connect()
    allowed = {"title", "body", "priority", "estimate", "assignee", "doc_slug", "parent", "max_attempts", "result"}
    with tx(c):
        t = ticket(c, a.key)
        meta = json.loads(t["meta"])
        for kv in a.fields:
            k, v = kv.split("=", 1)
            if k in ("labels", "locks"):
                c.execute(f"UPDATE tickets SET {k}=? WHERE key=?", (json.dumps([x for x in v.split(",") if x]), t["key"]))
            elif k in allowed:
                c.execute(f"UPDATE tickets SET {k}=? WHERE key=?", (v if v != "" else None, t["key"]))
            elif k == "milestone":
                assign_milestone(c, t["key"], v or None)
            elif k.startswith("meta.") or k in ("review", "size", "model", "executor"):
                mk = k[5:] if k.startswith("meta.") else k
                if v == "": meta.pop(mk, None)
                else:
                    try: meta[mk] = json.loads(v)
                    except Exception: meta[mk] = v
            else:
                die(f"unknown field {k}")
        c.execute("UPDATE tickets SET meta=?, updated=? WHERE key=?", (json.dumps(meta), now(), t["key"]))
        event(c, "edit", t["key"], body=" ".join(a.fields)[:300])
    print("ok")

def cmd_config(a):
    c = connect()
    scope = a.scope if a.scope == "global" or ":" in a.scope else f"project:{a.scope.upper()}"
    if a.key is None:
        rows = c.execute("SELECT * FROM settings WHERE scope=? ORDER BY key", (scope,)).fetchall()
        eff = {k: setting(c, k, scope.split(":", 1)[1] if scope.startswith("project:") else None) for k in DEFAULTS}
        out(a, {"set": {r["key"]: json.loads(r["value"]) for r in rows}, "effective": eff},
            "\n".join(f"{k:24} {json.dumps(v)}{'  *' if any(r['key'] == k for r in rows) else ''}" for k, v in eff.items())
            + "\n(* set at this scope)")
        return
    with tx(c):
        if a.value is None:
            c.execute("DELETE FROM settings WHERE scope=? AND key=?", (scope, a.key))
        else:
            try: v = json.loads(a.value)
            except Exception: v = a.value
            c.execute("INSERT OR REPLACE INTO settings VALUES(?,?,?)", (scope, a.key, json.dumps(v)))
    print("ok")

def build_prompt(c, t, compact=False):
    p = project_row(c, t["project"])
    bl_ = blockers(c, t["key"])
    comments = c.execute("SELECT * FROM events WHERE ticket=? AND kind='comment' ORDER BY id DESC LIMIT 10",
                         (t["key"],)).fetchall()
    meta = json.loads(t["meta"])
    L = [f"# Backlog ticket {t['key']}: {t['title']}", "",
         f"Project {p['key']} ({p['name']}), repo: {p['repo'] or 'n/a'}. Attempt {t['attempts']}. "
         f"Review policy: {review_policy(c, t)}. Size hint: {meta.get('size', 'unspecified')}.", ""]
    if (p["instructions"] or "").strip():
        L += ["## Standing instructions for this project", p["instructions"].strip(), ""]
    docs = [d for d in (p["doc_slug"], t["doc_slug"]) if d]
    if docs:
        L.append(f"{setting(c, 'doc_hint', p['key'])}: " + ", ".join(docs)); L.append("")
    if not compact:
        L += ["## Spec", t["body"] or "(no body: the title is the spec)", ""]
        if bl_:
            L.append("## Upstream tickets (what they delivered)")
            for b in bl_:
                L.append(f"- {b['key']} [{b['state']}] {b['title']}: {b['result'] or '(no result recorded)'}")
            L.append("")
        if comments:
            L.append("## Notes on this ticket (newest first)")
            L += [f"- {e['at']} {e['actor']}: {e['body']}" for e in comments]
            L.append("")
        if t["milestone"]:
            m = c.execute("SELECT * FROM milestones WHERE key=?", (t["milestone"],)).fetchone()
            if m:
                L += [f"Milestone: {m['key']} {m['title']}" + (f" (due {m['due']})" if m["due"] else ""), ""]
        if meta.get("showcase_for"):
            m = c.execute("SELECT * FROM milestones WHERE key=?", (meta["showcase_for"],)).fetchone()
            if m:
                work = ms_work(c, m)
                L += [f"## Showcase for milestone {m['key']}: {m['title']}",
                      "This ticket produces the portfolio piece for the milestone: proof of what was built, for a human to look at.",
                      SHOWCASE_HOW.get(m["showcase_kind"], SHOWCASE_HOW["screenshot"]).format(m=m["key"]),
                      "Cover every ticket below that is done; say what changed and how to see it. Files are copied into the backlog's showcase folder.",
                      *[f"- {w['key']} [{w['state']}] {w['title']}: {(w['result'] or '')[:300]}" for w in work], ""]
        if t["parent"]:
            par = c.execute("SELECT title FROM tickets WHERE key=?", (t["parent"],)).fetchone()
            L += [f"Parent: {t['parent']} {par['title'] if par else ''}", ""]
    L += ["## Protocol (backlog-worker skill)",
          f"- Progress notes: `bl comment {t['key']} \"...\"`. Found more work: `bl add {p['key']} \"title\" --after {t['key']}` "
          f"(or `--blocks {t['key']}` then `bl release {t['key']} --reason split`). Don't widen your own scope.",
          f"- Finish with exactly one: `bl done {t['key']} -m \"what changed, PR url, how verified\"` | "
          f"`bl fail {t['key']} -m \"why, what to try next\"` | `bl release {t['key']} --reason ...`.",
          "- The -m text is what downstream tickets will see. Write it for the next agent.",
          "- Review policy self = test it yourself and merge per the repo's rules; pr = open the PR and stop; "
          "ask = open the PR and stop, a human decides.",
          "- Never deploy, spend money or push to main unless the spec says so."]
    return "\n".join(L)

def brief_prompt(c, t):
    p = project_row(c, t["project"])
    key = t["key"]
    return f"""{build_prompt(c, t)}

# You are preparing {key} for the human

{key} is assigned to the human: only they can do it (a review, a decision, a test, an answer). Your job in this
first turn is to make that as easy as possible, then hand over. You will be resumed later in this same session with
the human at the keyboard, so everything you learn now stays useful.

Now:
1. Gather the context: the spec above, what every upstream ticket delivered (its result, PR and branch), the design doc
   if there is one, and the repo ({p['repo'] or 'none'}). Read enough to explain it, not to redo it.
2. Make it easy to see: work out exactly how the human checks the work (a local preview URL and the command that starts
   it, a PR link, a screenshot, a file to open). If the spec asks for a local preview and it is safe and cheap, start it
   and leave it running; otherwise give the exact command.
3. Compile the handoff packet and record it. It is what the human reads on the board, so every field is required:
   - summary: what this is and what they decide, one or two sentences
   - see: {{"url": ..., "how": ...}}: exactly how to see it (the preview URL and the command that starts it)
   - links: PRs, the design doc, screenshots, each as {{"label": ..., "url": ...}}
   - done: EVERY ticket and PR delivered (workers' included), each as {{"title": ..., "ref": "#PR", "what": "what the human will see"}}.
     If nothing is built yet, say so in one item.
   - tests: concrete steps, each as {{"step": ..., "good": ..., "bad": ...}}
   - gaps: known gaps or limitations (may be empty)
   - questions: 1 to 3, the last one the decision (go / no-go, pick A / B), saying what each answer triggers
   Record it with a heredoc: `bl handoff {key} --packet - <<'EOF'` + the JSON + `EOF`. That moves the ticket to
   "awaiting" and notifies the human.
4. Your final message repeats the packet in readable form (preview, done and new, what to test, questions).

Do not mark the ticket done and do not change other tickets in this first turn.

When the human answers (in this session, later):
- First run `bl handoff {key} --phase discussing` so the board shows you are on it.
- Interview briefly if their answer is ambiguous; one question at a time.
- Turn every problem they report into a ticket: `bl add {p['key']} "<fix>" -b "<what they saw, where, what they expect>" --blocks {key}`
  (so this decision waits for the fixes), or `--after {key}` when it can follow.
- Record their words: `bl comment {key} "<decision and reasons>"`.
- When they give the decision, close it: `bl resolve {key} -m "<decision, by the human, and what follows>"`.
  If fixes were filed first, leave {key} open; it comes back to them when the fixes land."""

HANDOFF_FIELDS = {
    "summary": "one or two sentences: what this is and what you decide",
    "see": "how to see it: {\"url\": \"http://localhost:4810\", \"how\": \"the command that starts it, sign-in notes\"}",
    "links": "[{\"label\": \"PR #213\", \"url\": \"https://...\"}] (PRs, design doc, screenshots)",
    "done": "[{\"title\": \"Brush levels\", \"ref\": \"#194\", \"what\": \"what the human will see\"}]: every ticket and PR delivered, workers' too",
    "tests": "[{\"step\": \"brush Faint, Some, Rugged on one stretch\", \"good\": \"...\", \"bad\": \"...\"}]",
    "gaps": "[\"known gap or limitation\"] (may be empty)",
    "questions": "[\"Go / no-go to merge PR #213 (merging deploys)?\", ...]: 1 to 3, the last one the decision",
}

def _obj(x, key, **extra):
    """A plain string becomes {key: string}; a dict passes through."""
    return x if isinstance(x, dict) else {key: str(x), **extra}

def normalize_packet(pk):
    """Briefing sessions often write links, done and tests as plain strings. The board needs objects."""
    out = dict(pk)
    links = []
    for x in pk.get("links") or []:
        if isinstance(x, dict):
            links.append(x)
        else:
            m = re.search(r"https?://\S+", str(x))
            if m:   # "https://x (what it is)" or "what it is: https://x"
                url = m.group(0).rstrip(").,;")
                label = (str(x).replace(m.group(0), "").strip(" -:()") or url)
                links.append({"label": label, "url": url})
            # a link with no URL (like "MC-PAYMENT-2 is waiting on this") is dropped
    out["links"] = links
    out["done"] = [_obj(x, "title") for x in pk.get("done") or []]
    out["tests"] = [_obj(x, "step") for x in pk.get("tests") or []]
    out["gaps"] = [str(x) for x in pk.get("gaps") or []]
    out["questions"] = [str(x) for x in pk.get("questions") or []]
    return out

def handoff_of(t):
    return json.loads(t["meta"]).get("handoff") or {}

def set_handoff(c, t, **kw):
    meta = json.loads(t["meta"])
    h = meta.get("handoff") or {}
    h.update({k: v for k, v in kw.items() if v is not None})
    h["updated"] = now()
    meta["handoff"] = h
    c.execute("UPDATE tickets SET meta=?, updated=? WHERE key=?", (json.dumps(meta), now(), t["key"]))
    return h

def notify_human(c, t, msg):
    url = f"{setting(c, 'board_url')}/{t['project']}/{t['key']}"
    env = {**os.environ, "BL_MSG": msg, "BL_TICKET": t["key"], "BL_URL": url, "BL_PROJECT": t["project"]}
    cmd = setting(c, "notify_human_cmd", t["project"])
    if cmd:
        subprocess.Popen(cmd, shell=True, env=env)
    elif sys.platform == "darwin":
        script = 'on run argv\ndisplay notification (item 1 of argv) with title "Backlog needs you" subtitle (item 2 of argv) sound name "Glass"\nend run'
        subprocess.Popen(["osascript", "-e", script, msg, t["key"]], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    proj_cmd = setting(c, "notify_cmd", t["project"])
    if proj_cmd:
        subprocess.Popen(proj_cmd, shell=True, env=env)

def cmd_handoff(a):
    """Record the handoff packet for a human ticket (or move its phase)."""
    c = connect()
    with tx(c):
        t = ticket(c, a.key)
        if t["assignee"] != "human" and not a.force:
            die(f"{t['key']} is not assigned to human")
        if a.packet:
            raw = sys.stdin.read() if a.packet == "-" else Path(a.packet).read_text()
            try:
                pk = json.loads(raw)
            except Exception as e:
                die(f"packet is not JSON: {e}")
            pk = normalize_packet(pk) if isinstance(pk, dict) else pk
            missing = [k for k in ("summary", "see", "done", "tests", "questions") if not pk.get(k)]
            if missing:
                die("packet is missing " + ", ".join(missing) + ". Fields:\n" + "\n".join(f"  {k}: {v}" for k, v in HANDOFF_FIELDS.items()))
            sid = session_id()
            h = set_handoff(c, t, packet=pk, phase="awaiting", session=sid or handoff_of(t).get("session"), ready_at=now())
            event(c, "handoff", t["key"], body=f"handoff ready: {pk['summary'][:200]}", data={"phase": "awaiting"})
            notify_human(c, t, pk["summary"][:180])
            print("awaiting: the human has been notified")
        elif a.phase:
            set_handoff(c, t, phase=a.phase, **({"answered_at": now()} if a.phase == "discussing" else {}))
            event(c, "handoff", t["key"], body=f"handoff phase: {a.phase}")
            print(a.phase)
        else:
            print(json.dumps(handoff_of(t), indent=1))

def cmd_brief_prompt(a):
    c = connect()
    print(brief_prompt(c, ticket(c, a.key)))

def cmd_resolve(a):
    """Close a human ticket with the human's decision (no claim needed)."""
    c = connect()
    with tx(c):
        t = ticket(c, a.key)
        if t["state"] in FINAL:
            die(f"{t['key']} is already {t['state']}")
        if t["assignee"] != "human" and not a.force:
            die(f"{t['key']} is not assigned to human; workers finish with bl done (or pass --force)")
        new = a.state
        c.execute("UPDATE tickets SET state=?, result=coalesce(?, result), claimed_by=NULL, lease_until=NULL, updated=?, finished=? WHERE key=?",
                  (new, a.message, now(), now(), t["key"]))
        event(c, "state", t["key"], body=f"{t['state']} → {new} (human decision)" + (f": {a.message}" if a.message else ""))
        if handoff_of(t):
            set_handoff(c, ticket(c, t["key"]), phase="done", decided_at=now())
        finalize_projects(c)
    print(new)

def orchestrator_prompt(c, proj, agent):
    p = project_row(c, proj)
    n = setting(c, "max_parallel", proj)
    docs = f"\nDesign doc: {p['doc_slug']} ({setting(c, 'doc_hint', proj)})." if p["doc_slug"] else ""
    ins = (p["instructions"] or "").strip()
    standing = (f"\n\n## Standing instructions from the user\nFollow these over the defaults below (the safety rule at the end still holds). Pass the ones that matter to each subagent.\n{ins}\n"
                if ins else "")
    return f"""# Backlog orchestrator for {proj}: {p['name']}

You are the orchestrator session for backlog project {proj} (repo: {p['repo'] or 'n/a'}). Nobody is watching; do not ask questions.{docs}
Your bl identity is {agent}; you own the project while you run. Read ~/.backlog/LOCAL.md first if it exists.{standing}
The user can change standing instructions while you run: `bl instructions {proj}` prints the current ones; check it at the start of every round.

Loop until nothing is ready and none of your tickets are in progress:
1. `bl next {proj} --json` lists ready tickets. `bl status` shows the rest.
2. Claim up to {n} at a time: `bl claim {proj} KEY --json` (exit 3 = cap reached or nothing ready; that's fine).
3. For every claimed ticket, dispatch one subagent (Agent tool), all in the same message so they run in parallel. Brief = the full output of `bl prompt KEY`, plus: "Follow the backlog-worker contract. Work in the repo's conventions. Finish with `bl done KEY -m ...`, `bl fail KEY -m ...` or `bl release KEY --reason ...` yourself." Use the ticket's `model` if it sets one (bl show KEY --json → meta.model), else opus. A ticket that is size xl may get its own subagents.
4. When subagents return, check each ticket (`bl show KEY --json`). If one is still in_progress, record the outcome from its report with bl done/fail.
5. Between rounds, use judgment: read what finished tickets delivered, tighten specs of downstream tickets (`bl set KEY body=...`, `bl comment`), add missing tickets (`bl add {proj} ... --after KEY`; no deploy tickets: deploys happen at milestones), and leave anything that needs a human to them (`--assignee human`).
6. Repeat. If claims stop with "paused for usage limit", stop: the daemon resumes the project later.

Never deploy, spend money or push to main unless a ticket says so and isn't assigned to human. End with a short summary of what got done and what is left."""

def cmd_instructions(a):
    c = connect()
    p = project_row(c, a.project)
    if a.set is not None:
        v = sys.stdin.read().strip() if a.set == "-" else a.set.strip()
        with tx(c):
            c.execute("UPDATE projects SET instructions=?, updated=? WHERE key=?", (v or None, now(), p["key"]))
            event(c, "project", project=p["key"], body=f"instructions updated: {(v or '(cleared)')[:200]}")
        print("ok"); return
    print((p["instructions"] or "").strip() or "(no standing instructions)")

def cmd_orchestrate_prompt(a):
    c = connect()
    print(orchestrator_prompt(c, project_row(c, a.project)["key"], os.environ.get("BL_AGENT") or agent_id()))

def cmd_quota(a):
    c = connect()
    with tx(c):
        if a.action == "clear":
            c.execute("DELETE FROM settings WHERE scope='global' AND key='quota_until'")
            event(c, "quota", body="cleared")
        elif a.action == "set":
            until = later(a.minutes or setting(c, "quota_backoff_minutes"))
            c.execute("INSERT OR REPLACE INTO settings VALUES('global','quota_until',?)", (json.dumps(until),))
            event(c, "quota", body=f"paused by hand until {until}")
    q = quota_until(c)
    print(f"paused for usage limit until {q}" if q else "no usage-limit pause")

def cmd_prompt(a):
    c = connect()
    print(build_prompt(c, ticket(c, a.key), compact=a.compact))

def worktree_for(c, t):
    p = project_row(c, t["project"])
    if not p["repo"]:
        if os.environ.get("BL_DAEMON"):
            d = HOME / "work" / t["key"]
            d.mkdir(parents=True, exist_ok=True)
            return str(d)
        return os.getcwd()
    repo = Path(p["repo"]).expanduser()
    if not setting(c, "worktree", p["key"], json.loads(t["labels"])):
        return str(repo)
    wt = repo.parent / f"{repo.name}-wt" / t["key"]
    if not wt.exists():
        wt.parent.mkdir(parents=True, exist_ok=True)
        branch = f"bl/{t['key'].lower()}"
        r = subprocess.run(["git", "-C", str(repo), "worktree", "add", str(wt), "-b", branch],
                           capture_output=True, text=True)
        if r.returncode:
            r = subprocess.run(["git", "-C", str(repo), "worktree", "add", str(wt), branch], capture_output=True, text=True)
        if r.returncode:
            die(f"worktree failed: {r.stderr.strip()}")
    return str(wt)

def cmd_worktree(a):
    c = connect()
    print(worktree_for(c, ticket(c, a.key)))

def cmd_status(a):
    c = connect()
    with tx(c):
        reap(c)
    projs = c.execute("SELECT * FROM projects WHERE status!='archived' ORDER BY key").fetchall()
    res, lines = [], []
    for p in projs:
        cnt = {r["state"]: r["n"] for r in c.execute("SELECT state, count(*) n FROM tickets WHERE project=? GROUP BY state", (p["key"],))}
        tot = sum(cnt.values())
        rd = ready(c, p["key"])
        human = c.execute("""SELECT key,title,state FROM tickets t WHERE project=? AND (state IN ('failed','in_review')
                 OR (state='todo' AND assignee='human' AND NOT EXISTS (SELECT 1 FROM deps d JOIN tickets b ON b.key=d.blocker
                     WHERE d.ticket=t.key AND b.state NOT IN ('done','canceled'))))""", (p["key"],)).fetchall()
        runs = c.execute("SELECT * FROM runs WHERE project=? AND status='running'", (p["key"],)).fetchall()
        orphan = bool(c.execute(f"SELECT 1 FROM projects p WHERE key=? AND status='executing' AND executor='session' AND {orphan_sql(c)}",
                                (p["key"],)).fetchone()) and not runs
        res.append({"project": p["key"], "status": p["status"], "executor": p["executor"], "evergreen": bool(p["evergreen"]),
                    "owner": p["owner"], "orphaned": orphan, "counts": cnt, "ready": [r["key"] for r in rd],
                    "needs_human": [dict(h) for h in human], "runs": [dict(r) for r in runs]})
        lines.append(f"{p['key']} [{p['status']}, {p['executor']}{', evergreen' if p['evergreen'] else ''}"
                     f"{', ORPHANED' if orphan else ''}]: {cnt.get('done', 0)}/{tot} done · " +
                     " ".join(f"{s}={cnt[s]}" for s in STATES if s in cnt and s != "done") +
                     (f" · ready: {','.join(r['key'] for r in rd[:6])}" if rd else "") +
                     (f" · run pid {runs[0]['pid']}" if runs else ""))
        nxt = c.execute("SELECT * FROM milestones WHERE project=? AND status IN ('planned','active','reached') ORDER BY seq LIMIT 1",
                        (p["key"],)).fetchone()
        if nxt:
            w = ms_work(c, nxt)
            lines.append(f"   next milestone: {nxt['key']} {nxt['title']} [{nxt['status']}, "
                         f"{sum(1 for x in w if x['state'] == 'done')}/{len(w)} done{', due ' + nxt['due'] if nxt['due'] else ''}]")
        for h in human:
            lines.append(f"   needs you: {h['key']} [{h['state']}] {h['title']}")
        for m in c.execute("SELECT * FROM milestones WHERE project=? AND status='showcased'", (p["key"],)).fetchall():
            lines.append(f"   needs you: review the showcase of {m['key']} {m['title']} (bl milestone accept|reopen {m['key']})")
    d = daemon_info(c)
    q = quota_until(c)
    head = (f"{'USAGE LIMIT: claims paused until ' + q + ' (bl quota clear) · ' if q else ''}"
            f"daemon: {'running' if d['alive'] else 'NOT running'}{'' if d['enabled'] else ' (paused)'} · "
            f"{d['workers']} working · {d['runs_today']} runs today · in flight {d['in_flight']}/{setting(c, 'global_max_parallel')}")
    if a.json:
        print(json.dumps({"daemon": d, "projects": res}, indent=1, default=str))
    else:
        print("\n".join([head] + lines) if lines else head)

def daemon_info(c):
    r = c.execute("SELECT * FROM runs WHERE kind='daemon' ORDER BY id DESC LIMIT 1").fetchone()
    alive = False
    if r and r["status"] == "running":
        try:
            os.kill(r["pid"], 0); alive = True
        except ProcessLookupError:
            alive = False
        except PermissionError:
            alive = True
    today = datetime.now(timezone.utc).strftime("%Y-%m-%dT00:00:00Z")
    return {"alive": alive, "pid": r["pid"] if r else None, "heartbeat": r["heartbeat"] if r else None,
            "enabled": bool(setting(c, "daemon_enabled")), "quota_until": quota_until(c),
            "workers": c.execute("SELECT count(*) FROM tickets WHERE state='in_progress' AND claimed_by LIKE 'daemon:%'").fetchone()[0],
            "in_flight": c.execute("SELECT count(*) FROM tickets WHERE state='in_progress'").fetchone()[0],
            "runs_today": c.execute("SELECT count(*) FROM events WHERE kind='claim' AND actor LIKE 'daemon:%' AND at>=?", (today,)).fetchone()[0]}

def cmd_log(a):
    c = connect()
    q, p = "SELECT * FROM events WHERE 1=1", []
    if a.project: q += " AND project=?"; p.append(a.project.upper())
    rows = c.execute(q + " ORDER BY id DESC LIMIT ?", p + [a.n]).fetchall()[::-1]
    out(a, [dict(r) for r in rows], "\n".join(f"{r['at']} {r['ticket'] or r['project'] or '':9} {r['kind']:8} {r['actor']}: {r['body']}" for r in rows))

def cmd_export(a):
    c = connect()
    p = project_row(c, a.project)
    rows = c.execute("SELECT * FROM tickets WHERE project=? ORDER BY priority, id", (p["key"],)).fetchall()
    cnt = {}
    for r in rows: cnt[r["state"]] = cnt.get(r["state"], 0) + 1
    L = [f"# Backlog: {p['name']} ({p['key']})", "",
         f"Exported {now()}. {cnt.get('done', 0)}/{len(rows)} done. " + ", ".join(f"{k} {v}" for k, v in cnt.items()), ""]
    if p["doc_slug"]: L += [f"Design doc: `{p['doc_slug']}`", ""]
    L += ["| Ticket | State | P | Title | Waits on | Result |", "|---|---|---|---|---|---|"]
    for r in rows:
        bs = ",".join(b["key"] for b in blockers(c, r["key"]))
        res = (r["result"] or "").replace("|", "\\|").replace("\n", " ")[:160]
        L.append(f"| {r['key']} | {r['state']} | {r['priority']} | {r['title'].replace('|', '/')} | {bs} | {res} |")
    L += ["", "```mermaid"]
    print("\n".join(L))
    a.mermaid, a.all = True, False
    cmd_graph(a)
    print("```")


# ---------------------------------------------------------------- milestones
def cmd_milestone(a):
    c = connect()
    act = a.action
    if act == "add":
        proj = project_row(c, a.target)["key"]
        if not a.title:
            die("usage: bl milestone add PROJ \"Title\" [--trigger all|deploy|manual] [--gate KEY] [--showcase KIND] [--due DATE]")
        if a.trigger == "deploy" and not a.gate:
            die("--trigger deploy needs --gate KEY (the deploy ticket)")
        with tx(c):
            n = c.execute("SELECT count(*) FROM milestones WHERE project=?", (proj,)).fetchone()[0] + 1
            key = f"{proj}-M{n}"
            while c.execute("SELECT 1 FROM milestones WHERE key=?", (key,)).fetchone():
                n += 1; key = f"{proj}-M{n}"
            seq = a.seq if a.seq is not None else (c.execute("SELECT coalesce(max(seq),0) FROM milestones WHERE project=?", (proj,)).fetchone()[0] + 1)
            c.execute("INSERT INTO milestones(key,project,seq,title,body,trigger,gate,showcase_kind,due,created,updated) VALUES(?,?,?,?,?,?,?,?,?,?,?)",
                      (key, proj, seq, a.title, a.body or "", a.trigger, a.gate.upper() if a.gate else None, a.showcase, a.due, now(), now()))
            if a.gate:
                ticket(c, a.gate)
                c.execute("UPDATE tickets SET milestone=coalesce(milestone, ?) WHERE key=?", (key, a.gate.upper()))
            if a.showcase != "none":
                tseq = c.execute("UPDATE projects SET next_seq=next_seq+1 WHERE key=? RETURNING next_seq-1", (proj,)).fetchone()[0]
                tk = f"{proj}-{tseq}"
                body = (f"Produce the showcase for milestone {key}: {a.title}.\n\nKind: {a.showcase}. "
                        f"Done when: the showcase is recorded with `bl milestone showcase {key} ...` and `bl done` summarizes it.")
                c.execute("""INSERT INTO tickets(key,project,title,body,state,priority,labels,meta,milestone,created,updated)
                             VALUES(?,?,?,?,'backlog',2,'["showcase"]',?,?,?,?)""",
                          (tk, proj, f"Showcase: {a.title}", body,
                           json.dumps({"showcase_for": key, **({"model": "sonnet"} if a.showcase in ("screenshot", "link") else {})}),
                           key, now(), now()))
                c.execute("UPDATE milestones SET showcase_ticket=? WHERE key=?", (tk, key))
                event(c, "created", tk, proj, body=f"Showcase: {a.title}")
            event(c, "milestone", project=proj, body=f"{key} created: {a.title} (trigger {a.trigger}, showcase {a.showcase})")
            refresh_milestones(c, proj)
        out(a, {"key": key}, key)
        return
    if act == "ls":
        proj = project_row(c, a.target)["key"]
        rows = c.execute("SELECT * FROM milestones WHERE project=? ORDER BY seq, id", (proj,)).fetchall()
        res = []
        for m in rows:
            w = ms_work(c, m)
            res.append({**rowd(m), "showcases": json.loads(m["showcases"]), "tickets": [x["key"] for x in w],
                        "done": sum(1 for x in w if x["state"] == "done")})
        out(a, res, "\n".join(f"{m['key']:16} {m['status']:9} {m['trigger']:7} {r['done']}/{len(r['tickets'])} "
                               f"{m['title']}{'  due ' + m['due'] if m['due'] else ''}{'  showcase: ' + str(len(r['showcases'])) if r['showcases'] else ''}"
                               for m, r in zip(rows, res)) or "(no milestones)")
        return
    m = milestone(c, a.target)
    if act == "show":
        w = ms_work(c, m)
        d = {**rowd(m), "showcases": json.loads(m["showcases"]), "tickets": [dict(x) for x in w]}
        lines = [f"{m['key']}  {m['title']}  [{m['status']}]", f"trigger={m['trigger']} gate={m['gate']} showcase={m['showcase_kind']} "
                 f"ticket={m['showcase_ticket']} due={m['due']} reached={m['reached']}", "", m["body"] or "", ""]
        lines += [f"  {x['key']:16} {x['state']:11} {x['title']}" for x in w]
        for sc in json.loads(m["showcases"]):
            lines.append(f"  showcase [{sc.get('kind')}] {sc.get('url') or sc.get('file') or ''} {sc.get('note', '')[:120]}")
        out(a, d, "\n".join(lines)); return
    with tx(c):
        if act == "showcase":
            entry = {"kind": a.kind or m["showcase_kind"], "at": now(), "by": agent_id()}
            if a.note: entry["note"] = a.note
            if a.url: entry["url"] = a.url
            if a.file:
                src = Path(a.file).expanduser()
                if not src.is_file():
                    die(f"no file {src}")
                dst_dir = SHOWCASE_DIR / m["key"]
                dst_dir.mkdir(parents=True, exist_ok=True)
                dst = dst_dir / f"{int(time.time())}-{src.name}"
                dst.write_bytes(src.read_bytes())
                entry["file"] = str(dst.relative_to(SHOWCASE_DIR))
            if len(entry) <= 3:
                die("give at least one of --file, --url, --note")
            shows = json.loads(m["showcases"]) + [entry]
            c.execute("UPDATE milestones SET showcases=?, updated=? WHERE key=?", (json.dumps(shows), now(), m["key"]))
            event(c, "milestone", project=m["project"], body=f"{m['key']} showcase added ({entry['kind']})", data=entry)
        elif act == "reach":
            c.execute("UPDATE milestones SET reached=coalesce(reached, ?), updated=? WHERE key=?", (now(), now(), m["key"]))
            if m["trigger"] != "manual":
                c.execute("UPDATE milestones SET trigger='manual' WHERE key=?", (m["key"],))
        elif act == "cancel":
            c.execute("UPDATE milestones SET status='canceled', updated=? WHERE key=?", (now(), m["key"]))
            event(c, "milestone", project=m["project"], body=f"{m['key']} canceled")
        elif act == "accept":
            c.execute("UPDATE milestones SET status='accepted', updated=? WHERE key=?", (now(), m["key"]))
            event(c, "milestone", project=m["project"], body=f"{m['key']} accepted" + (f": {a.note}" if a.note else ""))
        elif act == "reopen":
            c.execute("UPDATE milestones SET status='active', updated=? WHERE key=?", (now(), m["key"]))
            event(c, "milestone", project=m["project"], body=f"{m['key']} reopened" + (f": {a.note}" if a.note else ""))
        elif act == "set":
            fields = ([a.title] if a.title else []) + a.fields   # `title` is positional for `add`
            if not fields or any("=" not in f for f in fields):
                die("usage: bl milestone set KEY field=value ...")
            a.fields = fields
            for kv in fields:
                k, v = kv.split("=", 1)
                if k not in ("title", "body", "trigger", "gate", "due", "seq", "showcase_kind"):
                    die(f"unknown milestone field {k}")
                c.execute(f"UPDATE milestones SET {k}=?, updated=? WHERE key=?", (v if v != "" else None, now(), m["key"]))
            event(c, "milestone", project=m["project"], body=f"{m['key']} " + " ".join(a.fields))
        refresh_milestones(c, m["project"])
    print("ok")


# ---------------------------------------------------------------- workers (shared by bl run and the daemon)
def spawn_worker(c, t, ag, actor):
    """Start worker_cmd for a claimed ticket. Returns (Popen, logfile) or None (ticket released)."""
    try:
        cwd = worktree_for(c, t)
    except SystemExit:
        with tx(c):
            release_ticket(c, ticket(c, t["key"]), "could not create worktree", count_failure=True, actor=actor)
        return None
    LOGS.mkdir(parents=True, exist_ok=True)
    lf = open(LOGS / f"{t['key']}.{t['attempts']}.log", "w")
    env = {k: v for k, v in os.environ.items() if k not in ("BL_IN_ORCH", "CLAUDE_CODE_SESSION_ID", "BL_OWNER")}
    model = str(model_for(c, t))
    env = {**env, "BL_TICKET": t["key"], "BL_AGENT": ag, "BL_DB": str(DB), "BL_MODEL": model,
           "PATH": f"{Path(__file__).resolve().parent}:{os.environ.get('PATH', '')}"}
    cmd = setting(c, "worker_cmd", t["project"], json.loads(t["labels"]))
    pr = subprocess.Popen(cmd, shell=True, cwd=cwd, env=env, stdout=lf, stderr=subprocess.STDOUT, start_new_session=True)
    with tx(c):
        event(c, "spawn", t["key"], body=f"worker started in {cwd} (model {model})", actor=ag,
              data={"cwd": cwd, "log": lf.name, "pid": pr.pid, "model": model})
    return pr, lf

def collect_children(c, children, actor, project=None):
    """Handle finished / timed-out workers. children: key -> (Popen, agent, t0, logfile)."""
    for k, (pr, ag, t0, lf) in list(children.items()):
        t = ticket(c, k)
        if pr.poll() is not None:
            del children[k]; lf.close()
            if t["state"] == "in_progress" and t["claimed_by"] == ag:
                tail = log_tail(lf.name)
                hit, _ = detect_quota(tail)
                with tx(c):
                    if hit:
                        until = note_quota(c, k, tail, actor)
                        new = release_ticket(c, ticket(c, k), f"usage limit; retry after {until}", count_failure=False, actor=actor)
                    else:
                        new = release_ticket(c, ticket(c, k), f"worker exited ({pr.returncode}) without reporting",
                                             count_failure=True, actor=actor)
                notify(c, t["project"], f"{k}: usage limit hit, paused until {until}; ticket back to {new}" if hit
                       else f"{k} worker exited without reporting → {new}")
            else:
                notify(c, t["project"], f"{k} → {t['state']}: {(t['result'] or '')[:200]}")
        elif time.monotonic() - t0 > 60 * setting(c, "worker_timeout_minutes", t["project"]):
            try: os.killpg(pr.pid, signal.SIGTERM)
            except Exception: pr.terminate()
            notify(c, t["project"], f"{k} timed out; terminated")

def beat_children(c, children):
    with tx(c):
        for k, (pr, ag, *_r) in children.items():
            t = ticket(c, k)
            c.execute("UPDATE tickets SET lease_until=? WHERE key=? AND claimed_by=?",
                      (later(setting(c, "lease_minutes", t["project"])), k, ag))

def stop_children(c, children, actor, reason):
    for k, (pr, ag, t0, lf) in children.items():
        try: os.killpg(pr.pid, signal.SIGTERM)
        except Exception: pass
        with tx(c):
            t = ticket(c, k)
            if t["state"] == "in_progress" and t["claimed_by"] == ag:
                release_ticket(c, t, reason, actor=actor)


# ---------------------------------------------------------------- orchestrator
def notify(c, project, msg):
    print(f"[{now()}] {msg}", flush=True)
    cmd = setting(c, "notify_cmd", project)
    if cmd:
        subprocess.Popen(cmd, shell=True, env={**os.environ, "BL_MSG": msg, "BL_PROJECT": project or ""})

def cmd_run(a):
    c = connect()
    proj = project_row(c, a.project)["key"]
    if a.parallel:
        with tx(c):
            c.execute("INSERT OR REPLACE INTO settings VALUES(?,?,?)", (f"project:{proj}", "max_parallel", json.dumps(a.parallel)))
    if a.dry_run:
        waves, by = levels(c, proj)
        print(f"{proj}: max_parallel={setting(c, 'max_parallel', proj)} global={setting(c, 'global_max_parallel')} "
              f"review={setting(c, 'review', proj)} model={setting(c, 'model', proj)}")
        for i, w in enumerate(waves):
            runnable = [k for k in w if by[k]["state"] == "todo" and by[k]["assignee"] in (None, "")]
            gated = [k for k in w if k not in runnable]
            tag = lambda k: f"{k}:human" if by[k]["assignee"] == "human" else f"{k}:{by[k]['state']}"
            print(f"wave {i + 1}: {' '.join(runnable)}" + (f"   (not auto-run: {' '.join(tag(k) for k in gated)})" if gated else ""))
        return
    pr_ = project_row(c, proj)
    if pr_["executor"] == "daemon" and not a.force:
        die(f"{proj} is run by the daemon. Pause it or `bl project set {proj} executor=session` to run it here.")
    if pr_["status"] != "executing" and not a.force:
        die(f"{proj} is {pr_['status']}. Start it first: bl project start {proj}")
    LOGS.mkdir(parents=True, exist_ok=True)
    me = f"orch:{proj}:{os.getpid()}"
    launcher = session_id()
    os.environ["BL_IN_ORCH"] = "1"
    os.environ["BL_OWNER"] = me
    with tx(c):
        run_id = c.execute("INSERT INTO runs(project,pid,host,agent,started,heartbeat,status,kind) VALUES(?,?,?,?,?,?, 'running','orchestrator') RETURNING id",
                           (proj, os.getpid(), socket.gethostname(), me, now(), now())).fetchone()[0]
        c.execute("UPDATE projects SET owner=?, owner_heartbeat=? WHERE key=?", (me, now(), proj))
        event(c, "run", project=proj, body=f"run {run_id} started (pid {os.getpid()})", actor=me,
              data={"launcher_session": launcher})
    children = {}   # key -> (Popen, agent, started_monotonic, logfile)
    stopping = {"flag": False}

    def stop(*_):
        stopping["flag"] = True
    signal.signal(signal.SIGINT, stop); signal.signal(signal.SIGTERM, stop)
    stuck_reported = None
    status = "done"
    try:
        while not stopping["flag"]:
            with tx(c):
                reap(c)
            collect_children(c, children, me, proj)
            # spawn
            while len(children) < setting(c, "max_parallel", proj):
                ag = f"{me}:{len(children)}:{int(time.time()) % 100000}"
                t, why = claim(c, proj, agent=ag)
                if not t:
                    break
                got = spawn_worker(c, t, ag, me)
                if not got:
                    continue
                children[t["key"]] = (got[0], ag, time.monotonic(), got[1])
                notify(c, proj, f"{t['key']} started ({t['title']}), log {got[1].name}")
            beat_children(c, children)
            with tx(c):
                c.execute("UPDATE runs SET heartbeat=? WHERE id=?", (now(), run_id))
                c.execute("UPDATE projects SET owner=?, owner_heartbeat=? WHERE key=?", (me, now(), proj))
            # termination / stuck
            active = c.execute(f"SELECT key,state,assignee,title FROM tickets WHERE project=? AND state IN ({','.join('?' * len(ACTIVE))})",
                               (proj, *ACTIVE)).fetchall()
            if not active and not children:
                with tx(c):
                    finalize_projects(c)
                if a.until == "done":
                    notify(c, proj, f"{proj}: all tickets final. Done."); status = "done"; break
            elif not children and not ready(c, proj, me):
                sig = tuple(sorted((r["key"], r["state"]) for r in active))
                if sig != stuck_reported:
                    stuck_reported = sig
                    det = "; ".join(f"{r['key']} {r['state']}{' (human)' if r['assignee'] == 'human' else ''}" for r in active)
                    gcap = c.execute("SELECT count(*) FROM tickets WHERE state='in_progress'").fetchone()[0] >= setting(c, "global_max_parallel")
                    notify(c, proj, f"{proj} waiting: {'global cap reached by other projects; ' if gcap else ''}{det}")
                    if setting(c, "on_stuck", proj) == "exit" and not gcap:
                        status = "stuck"; break
            else:
                stuck_reported = None
            time.sleep(setting(c, "poll_seconds", proj))
        else:
            status = "stopped"
    finally:
        stop_children(c, children, me, "orchestrator stopped")
        with tx(c):
            c.execute("UPDATE runs SET ended=?, status=? WHERE id=?", (now(), status, run_id))
            c.execute("UPDATE projects SET owner=NULL WHERE key=? AND owner=?", (proj, me))
            event(c, "run", project=proj, body=f"run {run_id} {status}", actor=me)
    sys.exit(0 if status == "done" else 2)


# ---------------------------------------------------------------- daemon
DAEMON_LABEL = "com.chito.backlog-daemon"
PLIST = Path.home() / "Library" / "LaunchAgents" / f"{DAEMON_LABEL}.plist"
DLOGS = Path.home() / "Library" / "Logs" / "backlog"

def cmd_daemon(a):
    c = connect()
    if a.action == "status":
        d = daemon_info(c)
        rows = c.execute("SELECT key,title,claimed_by,started,meta FROM tickets WHERE state='in_progress' ORDER BY started").fetchall()
        if a.json:
            print(json.dumps({**d, "in_progress": [dict(r) for r in rows]}, indent=1)); return
        print(f"daemon {'running pid ' + str(d['pid']) if d['alive'] else 'NOT running'}"
              f"{'' if d['enabled'] else ' · PAUSED'} · heartbeat {d['heartbeat']} · {d['workers']} workers · "
              f"{d['runs_today']}/{setting(c, 'daemon_max_runs_per_day')} runs today · in flight {d['in_flight']}/{setting(c, 'global_max_parallel')}")
        for r in rows:
            print(f"  {r['key']:20} {r['claimed_by']:34} since {r['started']}  {r['title'][:60]}")
        return
    if a.action in ("pause", "resume"):
        with tx(c):
            c.execute("INSERT OR REPLACE INTO settings VALUES('global','daemon_enabled',?)", (json.dumps(a.action == "resume"),))
            event(c, "daemon", body=a.action)
        print("daemon " + ("resumed" if a.action == "resume" else "paused (running workers finish; nothing new starts)")); return
    if a.action == "install":
        DLOGS.mkdir(parents=True, exist_ok=True)
        path = ":".join([str(Path.home() / ".local" / "bin"), "/opt/homebrew/bin", "/usr/local/bin", "/usr/bin", "/bin", "/usr/sbin", "/sbin"])
        PLIST.write_text(f"""<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>{DAEMON_LABEL}</string>
  <key>ProgramArguments</key><array><string>{sys.executable}</string><string>{Path(__file__).resolve()}</string><string>daemon</string><string>run</string></array>
  <key>WorkingDirectory</key><string>{HOME}</string>
  <key>EnvironmentVariables</key><dict>
    <key>PATH</key><string>{path}</string><key>HOME</key><string>{Path.home()}</string><key>BL_DB</key><string>{DB}</string>
  </dict>
  <key>RunAtLoad</key><true/><key>KeepAlive</key><true/><key>ThrottleInterval</key><integer>15</integer>
  <key>StandardOutPath</key><string>{DLOGS}/daemon.log</string><key>StandardErrorPath</key><string>{DLOGS}/daemon.err.log</string>
</dict></plist>
""")
        uid = os.getuid()
        subprocess.run(["launchctl", "bootout", f"gui/{uid}/{DAEMON_LABEL}"], capture_output=True)
        r = subprocess.run(["launchctl", "bootstrap", f"gui/{uid}", str(PLIST)], capture_output=True, text=True)
        print(f"installed {PLIST}" + (f" (bootstrap: {r.stderr.strip()})" if r.returncode else "; running")); return
    if a.action == "uninstall":
        subprocess.run(["launchctl", "bootout", f"gui/{os.getuid()}/{DAEMON_LABEL}"], capture_output=True)
        if PLIST.exists(): PLIST.unlink()
        print("uninstalled"); return
    # ---- run
    import fcntl
    lock = open(HOME / "daemon.lock", "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        die("another daemon is already running", 0)
    me = f"daemon:{os.getpid()}"
    os.environ["BL_IN_ORCH"] = "1"
    os.environ["BL_DAEMON"] = "1"
    os.environ.pop("BL_OWNER", None)
    with tx(c):
        run_id = c.execute("INSERT INTO runs(project,pid,host,agent,started,heartbeat,status,kind) VALUES(NULL,?,?,?,?,?,'running','daemon') RETURNING id",
                           (os.getpid(), socket.gethostname(), me, now(), now())).fetchone()[0]
        event(c, "daemon", body=f"daemon started (pid {os.getpid()})", actor=me)
    print(f"[{now()}] {me} started; db {DB}", flush=True)
    children = {}
    orchs = {}   # project -> (Popen, agent, t0, logfile) for orchestrator sessions
    briefs = {}  # ticket -> (Popen, agent, t0, logfile) for briefing sessions
    with tx(c):
        for t in c.execute("SELECT key, meta FROM tickets WHERE meta LIKE '%\"pending\": true%'").fetchall():
            m = json.loads(t["meta"]); m.pop("brief", None)
            c.execute("UPDATE tickets SET meta=? WHERE key=?", (json.dumps(m), t["key"]))
    stopping = {"flag": False}
    def stop(*_): stopping["flag"] = True
    signal.signal(signal.SIGINT, stop); signal.signal(signal.SIGTERM, stop)
    seq = 0
    last_why = None
    paused_seen = quota_until(c)
    probe = None          # after a usage-limit pause: {"key": ticket, "t0": monotonic} until one worker proves the limit reset
    try:
        while not stopping["flag"]:
            with tx(c):
                reap(c)
                finalize_projects(c)
            q = quota_until(c)
            if q and q != paused_seen:
                paused_seen = q; probe = None
                notify(c, None, f"usage limit: all claims paused until {q}; the daemon resumes on its own")
            elif not q and paused_seen:
                paused_seen = None; probe = {"key": None, "t0": None}
                with tx(c):
                    event(c, "quota", body="pause over; probing with one worker", actor=me)
                notify(c, None, "usage-limit pause over; trying one worker before resuming fully")
            collect_children(c, children, me)
            if probe is not None:
                k = probe["key"]
                if k and (k not in children or time.monotonic() - probe["t0"] > 90) and not quota_until(c):
                    t = ticket(c, k)
                    if k in children or t["state"] != "todo":
                        probe = None
                        with tx(c):
                            event(c, "quota", body="resumed: the probe worker got through", actor=me)
                        notify(c, None, "usage limit reset confirmed; resuming at full capacity")
                    else:
                        probe["key"] = None   # it was released for another reason; probe again
            # fill slots, round-robin across projects: the project with the fewest of our workers goes first
            cap = setting(c, "daemon_max_parallel")
            if probe is not None:
                cap = len(children) + (0 if probe["key"] else 1)   # one canary at a time until the limit is known to be reset
            while setting(c, "daemon_enabled") and len(children) < cap:
                cands = ready(c, None, me, None, "daemon")
                if not cands:
                    break
                mine = {}
                for k in children:
                    pk = ticket(c, k)["project"]; mine[pk] = mine.get(pk, 0) + 1
                cands = sorted(cands, key=lambda t: (mine.get(t["project"], 0), t["priority"], t["id"]))
                seq += 1
                ag = f"{me}:{seq}"
                t, why = claim(c, cands[0]["project"], cands[0]["key"], agent=ag, mode="daemon")
                if not t:
                    if why != last_why:
                        print(f"[{now()}] not claiming: {why}", flush=True); last_why = why
                    break
                last_why = None
                got = spawn_worker(c, t, ag, me)
                if got:
                    children[t["key"]] = (got[0], ag, time.monotonic(), got[1])
                    if probe is not None and not probe["key"]:
                        probe.update(key=t["key"], t0=time.monotonic())
                    notify(c, t["project"], f"daemon started {t['key']} ({t['title']}) model {model_for(c, t)}" +
                           (" as the usage-limit probe" if probe is not None and probe["key"] == t["key"] else "") + f", log {got[1].name}")
            auto_projects(c, children, orchs, me, lambda: probe is not None)
            if probe is None:
                brief_humans(c, briefs, me)
            beat_children(c, children)
            with tx(c):
                for pk, (pr, ag, t0, lf) in orchs.items():
                    c.execute("UPDATE projects SET owner_heartbeat=? WHERE key=? AND owner=?", (now(), pk, ag))
                    c.execute("UPDATE tickets SET lease_until=? WHERE state='in_progress' AND claimed_by=?",
                              (later(setting(c, "lease_minutes")), ag))
                c.execute("UPDATE runs SET heartbeat=? WHERE id=?", (now(), run_id))
            time.sleep(setting(c, "poll_seconds"))
    finally:
        stop_children(c, children, me, "daemon stopped")
        for pk, (pr, ag, t0, lf) in orchs.items():
            try: os.killpg(pr.pid, signal.SIGTERM)
            except Exception: pass
            with tx(c):
                for t in c.execute("SELECT * FROM tickets WHERE state='in_progress' AND claimed_by=?", (ag,)).fetchall():
                    release_ticket(c, t, "daemon stopped", actor=me)
                c.execute("UPDATE projects SET owner=NULL WHERE key=? AND owner=?", (pk, ag))
        with tx(c):
            c.execute("UPDATE runs SET ended=?, status='stopped' WHERE id=?", (now(), run_id))
            event(c, "daemon", body="daemon stopped", actor=me)


def project_has_live_owner(c, p):
    if c.execute("SELECT 1 FROM runs WHERE project=? AND status='running' AND kind='orchestrator'", (p["key"],)).fetchone():
        return True
    if not p["owner"]:
        return False
    hb = p["owner_heartbeat"] or ""
    return hb > (datetime.now(timezone.utc) - timedelta(minutes=setting(c, "lease_minutes"))).strftime("%Y-%m-%dT%H:%M:%SZ")

def human_ready(c):
    return c.execute("""SELECT t.* FROM tickets t JOIN projects p ON p.key=t.project
        WHERE t.state='todo' AND t.assignee='human' AND p.status='executing'
          AND NOT EXISTS (SELECT 1 FROM deps d JOIN tickets b ON b.key=d.blocker
                          WHERE d.ticket=t.key AND b.state NOT IN ('done','canceled'))
        ORDER BY t.priority, t.id""").fetchall()

def brief_humans(c, briefs, me):
    """For every unblocked human ticket without one, start a briefing session: context, how to see it, the questions."""
    for k, (pr, ag, t0, lf) in list(briefs.items()):
        if pr.poll() is None:
            if time.monotonic() - t0 > 60 * 30:
                try: os.killpg(pr.pid, signal.SIGTERM)
                except Exception: pr.terminate()
            continue
        del briefs[k]; lf.close()
        tail = log_tail(lf.name)
        hit, _ = detect_quota(tail)
        with tx(c):
            t = ticket(c, k)
            meta = json.loads(t["meta"])
            sid = c.execute("SELECT session_id FROM events WHERE ticket=? AND actor=? AND session_id IS NOT NULL ORDER BY id DESC LIMIT 1",
                            (k, ag)).fetchone()
            if hit:
                note_quota(c, k, tail, me)
                meta.pop("brief", None)                       # try again after the pause
            elif sid:
                meta["brief"] = {"session": sid["session_id"], "at": now(), "log": lf.name}
                h = meta.get("handoff") or {}
                h["session"] = h.get("session") or sid["session_id"]
                if h.get("phase") == "preparing":   # the session never recorded a packet: hand over the chat anyway
                    h["phase"] = "awaiting"; h["ready_at"] = now()
                    meta["handoff"] = h
                    c.execute("UPDATE tickets SET meta=? WHERE key=?", (json.dumps(meta), k))
                    notify_human(c, t, "A briefing is ready (no packet; read the session)")
                meta["handoff"] = h
                event(c, "brief", k, body="briefing ready: resume its session to answer", actor=ag,
                      data={"session": sid["session_id"]})
            else:
                meta["brief"] = {"error": f"briefing exited ({pr.returncode}) without recording a session", "at": now(), "log": lf.name}
            c.execute("UPDATE tickets SET meta=? WHERE key=?", (json.dumps(meta), k))
        notify(c, t["project"], f"{k}: " + ("briefing ready; it needs you" if sid and not hit else "briefing did not finish"))
    if not setting(c, "brief_humans") or not setting(c, "daemon_enabled") or quota_until(c):
        return
    for t in human_ready(c):
        meta = json.loads(t["meta"])
        if t["key"] in briefs or meta.get("brief") or (meta.get("handoff") or {}).get("packet"):
            continue
        if len(briefs) >= 2:
            return
        p = project_row(c, t["project"])
        ag = f"brief:{t['key']}"
        cwd = p["repo"] if p["repo"] and Path(p["repo"]).exists() else str(HOME)
        LOGS.mkdir(parents=True, exist_ok=True)
        lf = open(LOGS / f"brief-{t['key']}-{int(time.time())}.log", "w")
        env = {k: v for k, v in os.environ.items() if k not in ("BL_IN_ORCH", "CLAUDE_CODE_SESSION_ID", "BL_TICKET", "BL_DAEMON", "BL_OWNER", "BL_ORCH_PROJECT")}
        env.update({"BL_AGENT": ag, "BL_DB": str(DB), "PATH": f"{Path(__file__).resolve().parent}:{os.environ.get('PATH', '')}"})
        model = str(setting(c, "brief_model", p["key"]))
        pr = subprocess.Popen(["claude", "-p", brief_prompt(c, t), "--model", model, "--permission-mode", "bypassPermissions",
                               "--append-system-prompt", f"You are preparing backlog ticket {t['key']} for the human: brief them and ask; don't decide for them."],
                              cwd=cwd, env=env, stdout=lf, stderr=subprocess.STDOUT, start_new_session=True)
        briefs[t["key"]] = (pr, ag, time.monotonic(), lf)
        with tx(c):
            meta["brief"] = {"pending": True, "at": now(), "log": lf.name}
            meta["handoff"] = {**(meta.get("handoff") or {}), "phase": "preparing", "updated": now()}
            c.execute("UPDATE tickets SET meta=? WHERE key=?", (json.dumps(meta), t["key"]))
            event(c, "brief", t["key"], body="preparing a briefing session for the human", actor=ag, data={"pid": pr.pid, "log": lf.name})
        notify(c, t["project"], f"{t['key']}: preparing a briefing for you ({t['title']})")

ORCH_QUICK_SECONDS = 60   # an orchestrator that fails faster than this did not get to work (login, flags, API errors)
ORCH_BACKOFF = {}          # project -> (crashes in a row, monotonic time before which no new orchestrator starts)

def auto_projects(c, children, orchs, me, probe_active=None):
    """executor=auto: 2+ ready tickets → one orchestrator session per project; 1 ready → run it as a queue worker."""
    # finished orchestrators
    for pk, (pr, ag, t0, lf) in list(orchs.items()):
        if pr.poll() is None:
            if time.monotonic() - t0 > 60 * setting(c, "worker_timeout_minutes", pk) * 3:
                try: os.killpg(pr.pid, signal.SIGTERM)
                except Exception: pr.terminate()
                notify(c, pk, f"{pk} orchestrator timed out; terminated")
            continue
        del orchs[pk]; lf.close()
        tail = log_tail(lf.name)
        hit, _ = detect_quota(tail) if pr.returncode != 0 else (False, None)
        # Quick and fruitless: failed fast, or exited fast while its tickets are still ready (it did no work).
        quick = not hit and time.monotonic() - t0 < ORCH_QUICK_SECONDS and \
            (pr.returncode != 0 or bool(ready(c, pk, me, None, "auto1")))
        with tx(c):
            left = c.execute("SELECT * FROM tickets WHERE state='in_progress' AND claimed_by=?", (ag,)).fetchall()
            until = note_quota(c, None, tail, me) if hit else None
            for t in left:
                release_ticket(c, t, "usage limit" if hit else f"orchestrator exited ({pr.returncode})", count_failure=not hit, actor=me)
            c.execute("UPDATE projects SET owner=NULL WHERE key=? AND owner=?", (pk, ag))
            event(c, "run", project=pk, body=f"orchestrator session ended ({pr.returncode})" + (f"; usage limit until {until}" if hit else ""), actor=ag)
        if quick:
            n = ORCH_BACKOFF.get(pk, (0, 0))[0] + 1
            wait = min(60, 2 ** (n - 1))
            ORCH_BACKOFF[pk] = (n, time.monotonic() + wait * 60)
            last = " / ".join(l.strip() for l in tail.strip().splitlines()[-3:])[:300] or "no output"
            with tx(c):
                event(c, "run", project=pk, body=f"orchestrator ended after under a minute ({pr.returncode}) with tickets still ready, {n} in a row; next try in {wait} min: {last}", actor=me)
            notify(c, pk, f"{pk}: orchestrator ended ({pr.returncode}) within a minute without working the ready tickets, {n} in a row; retrying in {wait} min. Log: {lf.name}. Last output: {last}")
            continue
        ORCH_BACKOFF.pop(pk, None)
        notify(c, pk, f"{pk} orchestrator session finished" + (f" (usage limit, paused until {until})" if hit else ""))
    if not setting(c, "daemon_enabled") or quota_until(c) or (probe_active and probe_active()):
        return
    adopt = setting(c, "orphan_policy") == "adopt"
    quiet_since = (datetime.now(timezone.utc) - timedelta(minutes=setting(c, "adopt_after_minutes"))).strftime("%Y-%m-%dT%H:%M:%SZ")
    for p in c.execute("SELECT * FROM projects WHERE status='executing' AND executor IN ('auto','session') ORDER BY key").fetchall():
        if p["key"] in orchs or project_has_live_owner(c, p):
            continue
        if ORCH_BACKOFF.get(p["key"], (0, 0))[1] > time.monotonic():
            continue
        adopting = p["executor"] == "session"
        if adopting:
            if not adopt:
                continue
            busy = c.execute("SELECT 1 FROM events WHERE project=? AND at>? LIMIT 1", (p["key"], quiet_since)).fetchone() or \
                   c.execute("SELECT 1 FROM tickets WHERE project=? AND state='in_progress' LIMIT 1", (p["key"],)).fetchone()
            if busy:
                continue
        rd = ready(c, p["key"], me, None, "adopt" if adopting else "auto1")
        if not rd:
            continue
        cap = setting(c, "daemon_max_parallel")
        if len(children) + len(orchs) >= cap:
            return
        if adopting or len(rd) >= setting(c, "orchestrate_min_ready", p["key"]):
            ag = f"orchs:{p['key']}:{int(time.time()) % 1000000}"
            cwd = p["repo"] if p["repo"] and Path(p["repo"]).exists() else str(HOME)
            LOGS.mkdir(parents=True, exist_ok=True)
            lf = open(LOGS / f"orchestrator-{p['key']}-{int(time.time())}.log", "w")
            env = {k: v for k, v in os.environ.items() if k not in ("BL_IN_ORCH", "CLAUDE_CODE_SESSION_ID", "BL_TICKET", "BL_DAEMON")}
            env.update({"BL_AGENT": ag, "BL_OWNER": ag, "BL_ORCH_PROJECT": p["key"], "BL_DB": str(DB),
                        "BL_MODEL": str(setting(c, "orchestrator_model", p["key"])),
                        "PATH": f"{Path(__file__).resolve().parent}:{os.environ.get('PATH', '')}"})
            prompt = orchestrator_prompt(c, p["key"], ag)
            pr = subprocess.Popen(["claude", "-p", prompt, "--model", env["BL_MODEL"], "--permission-mode", "bypassPermissions",
                                   "--append-system-prompt", f"You are the backlog orchestrator for {p['key']}. Keep going until nothing is ready."],
                                  cwd=cwd, env=env, stdout=lf, stderr=subprocess.STDOUT, start_new_session=True)
            orchs[p["key"]] = (pr, ag, time.monotonic(), lf)
            with tx(c):
                c.execute("UPDATE projects SET owner=?, owner_heartbeat=? WHERE key=?", (ag, now(), p["key"]))
                event(c, "run", project=p["key"], body=(f"daemon adopted the stalled project: " if adopting else "") +
                      f"orchestrator session started for {len(rd)} ready tickets", actor=ag,
                      data={"pid": pr.pid, "log": lf.name, "cwd": cwd, "adopted": adopting})
            notify(c, p["key"], f"{p['key']}: {'adopted (no live session); ' if adopting else ''}started an orchestrator session for {len(rd)} ready tickets, log {lf.name}")
        else:
            ag = f"{me}:a{int(time.time()) % 100000}"
            t, why = claim(c, p["key"], rd[0]["key"], agent=ag, mode="auto1")
            if not t:
                continue
            got = spawn_worker(c, t, ag, me)
            if got:
                children[t["key"]] = (got[0], ag, time.monotonic(), got[1])
                notify(c, p["key"], f"daemon started {t['key']} ({t['title']}) as a single ticket")


# ---------------------------------------------------------------- hooks
def cmd_hook(a):
    """Claude Code hooks. Reads hook JSON on stdin. Never fails loudly."""
    try:
        data = json.load(sys.stdin)
    except Exception:
        data = {}
    if not DB.exists():
        return
    c = connect()
    tk = os.environ.get("BL_TICKET")
    sid = data.get("session_id") or os.environ.get("CLAUDE_CODE_SESSION_ID") or ""
    me = os.environ.get("BL_AGENT") or (f"cc:{sid[:8]}" if sid else None)
    if a.event == "session-start":
        if tk:
            t = c.execute("SELECT * FROM tickets WHERE key=?", (tk,)).fetchone()
            if t:
                print(build_prompt(c, t, compact=data.get("source") == "compact"))
            return
        if me:
            mine = c.execute("SELECT key,title FROM tickets WHERE state='in_progress' AND claimed_by=?", (me,)).fetchall()
            if mine:
                print("Backlog: this session holds " + ", ".join(f"{m['key']} ({m['title']})" for m in mine) +
                      ". Finish each with bl done / bl fail / bl release.")
    elif a.event == "stop":
        op = os.environ.get("BL_ORCH_PROJECT")
        if op and not tk and not data.get("stop_hook_active") and not quota_until(c):
            ag = os.environ.get("BL_AGENT")
            mine = c.execute("SELECT key FROM tickets WHERE state='in_progress' AND claimed_by=?", (ag,)).fetchall()
            rd = ready(c, op, ag, None, "session")
            if mine or rd:
                print(json.dumps({"decision": "block", "reason":
                    f"You are the orchestrator for {op}: " + (f"{len(rd)} tickets are ready" if rd else "") +
                    (f"{' and ' if rd else ''}{', '.join(m['key'] for m in mine)} still in progress" if mine else "") +
                    ". Keep going: claim, dispatch subagents, record results."}))
            return
        if not tk or data.get("stop_hook_active"):
            return
        t = c.execute("SELECT * FROM tickets WHERE key=?", (tk,)).fetchone()
        if t and t["state"] == "in_progress" and t["claimed_by"] == os.environ.get("BL_AGENT"):
            print(json.dumps({"decision": "block", "reason":
                f"Ticket {tk} is still in_progress. Report it before stopping: `bl done {tk} -m \"...\"`, "
                f"`bl fail {tk} -m \"...\"`, or `bl release {tk} --reason \"...\"`."}))
    elif a.event == "beat":
        # PostToolUse: keep leases of tickets this session holds alive (cheap; throttled by lease math)
        if me and c.execute("SELECT 1 FROM projects WHERE owner=? LIMIT 1", (me,)).fetchone():
            with tx(c):
                c.execute("UPDATE projects SET owner_heartbeat=? WHERE owner=?", (now(), me))
        if me and c.execute("SELECT 1 FROM tickets WHERE state='in_progress' AND claimed_by=? LIMIT 1", (me,)).fetchone():
            with tx(c):
                c.execute("UPDATE tickets SET lease_until=? WHERE state='in_progress' AND claimed_by=? AND lease_until < ?",
                          (later(setting(c, "lease_minutes")), me, later(setting(c, "lease_minutes") - 5)))


# ---------------------------------------------------------------- argparse
def main():
    ap = argparse.ArgumentParser(prog="bl", description="local backlog: tickets, DAG deps, leases, orchestrator")
    sp = ap.add_subparsers(dest="cmd", required=True)
    def P(name, fn, **kw):
        p = sp.add_parser(name, **kw); p.set_defaults(fn=fn); p.add_argument("--json", action="store_true"); return p

    P("init", cmd_init)
    p = P("project", cmd_project)
    p.add_argument("action", choices=["add", "ls", "set", "start", "pause", "resume", "plan", "archive", "done"]); p.add_argument("key", nargs="?")
    p.add_argument("--executor", choices=["daemon", "session", "auto"]); p.add_argument("--evergreen", action="store_true")
    p.add_argument("name", nargs="?"); p.add_argument("--repo"); p.add_argument("--doc"); p.add_argument("--review", choices=["self", "pr", "ask"])
    p.add_argument("fields", nargs="*")
    p = P("add", cmd_add); p.add_argument("project"); p.add_argument("title"); p.add_argument("-b", "--body"); p.add_argument("-f", "--file")
    p.add_argument("--after", help="blockers, comma-separated"); p.add_argument("--blocks", help="tickets that wait on this one")
    p.add_argument("-p", "--priority", type=int, default=2); p.add_argument("-e", "--estimate", type=int)
    p.add_argument("-l", "--labels"); p.add_argument("--lock"); p.add_argument("--assignee"); p.add_argument("--doc")
    p.add_argument("--parent"); p.add_argument("--state", default="todo"); p.add_argument("--max-attempts", type=int)
    p.add_argument("--review", choices=["self", "pr", "ask"]); p.add_argument("--size", choices=["s", "m", "l", "xl"])
    p.add_argument("--model", help="worker model for this ticket, e.g. sonnet for simple work (default: opus)")
    p.add_argument("--executor", choices=["daemon", "session"], help="override the project's executor for this ticket")
    p.add_argument("--milestone", help="milestone key, e.g. PROJ-M1")
    p.add_argument("--force", action="store_true")
    p = P("ls", cmd_ls); p.add_argument("project", nargs="?"); p.add_argument("--state"); p.add_argument("--all", action="store_true")
    p.add_argument("--ready", action="store_true"); p.add_argument("--mine", action="store_true"); p.add_argument("--assignee")
    p = P("show", cmd_show); p.add_argument("key")
    p = P("next", cmd_next); p.add_argument("project", nargs="?")
    p = P("graph", cmd_graph); p.add_argument("project"); p.add_argument("--mermaid", action="store_true"); p.add_argument("--all", action="store_true")
    p = P("dep", cmd_dep); p.add_argument("action", choices=["add", "rm"]); p.add_argument("ticket"); p.add_argument("blocker")
    p.add_argument("--force", action="store_true")
    p = P("claim", cmd_claim); p.add_argument("project", nargs="?"); p.add_argument("key", nargs="?")
    p.add_argument("--lease", type=int); p.add_argument("--force", action="store_true")
    p = P("beat", cmd_beat); p.add_argument("keys", nargs="*"); p.add_argument("--lease", type=int)
    p = P("release", cmd_release); p.add_argument("key"); p.add_argument("--reason"); p.add_argument("--force", action="store_true")
    p = P("resolve", cmd_resolve); p.add_argument("key"); p.add_argument("-m", "--message")
    p.add_argument("--state", choices=["done", "canceled"], default="done"); p.add_argument("--force", action="store_true")
    p = P("brief-prompt", cmd_brief_prompt); p.add_argument("key")
    p = P("handoff", cmd_handoff); p.add_argument("key"); p.add_argument("--packet", help="packet JSON file, or - for stdin")
    p.add_argument("--phase", choices=["preparing", "awaiting", "discussing"]); p.add_argument("--force", action="store_true")
    p = P("done", cmd_done); p.add_argument("key"); p.add_argument("-m", "--message"); p.add_argument("--force", action="store_true")
    p.add_argument("--final", action="store_true", help="skip review: go straight to done")
    p = P("fail", cmd_fail); p.add_argument("key"); p.add_argument("-m", "--message"); p.add_argument("--force", action="store_true")
    p = P("comment", cmd_comment); p.add_argument("key"); p.add_argument("text", nargs="+")
    p = P("move", cmd_move); p.add_argument("key"); p.add_argument("state"); p.add_argument("--reason")
    p.add_argument("--reset", action="store_true", help="with todo: reset attempts")
    p = P("set", cmd_set); p.add_argument("key"); p.add_argument("fields", nargs="+", help="field=value")
    p = P("config", cmd_config); p.add_argument("scope", help="global | MAP | project:MAP | label:ui")
    p.add_argument("key", nargs="?"); p.add_argument("value", nargs="?")
    p = P("prompt", cmd_prompt); p.add_argument("key"); p.add_argument("--compact", action="store_true")
    p = P("worktree", cmd_worktree); p.add_argument("key")
    P("status", cmd_status)
    p = P("log", cmd_log); p.add_argument("project", nargs="?"); p.add_argument("-n", type=int, default=30)
    p = P("export", cmd_export); p.add_argument("project")
    p = P("run", cmd_run); p.add_argument("project"); p.add_argument("--parallel", type=int)
    p.add_argument("--until", choices=["done", "forever"], default="done"); p.add_argument("--dry-run", action="store_true")
    p.add_argument("--force", action="store_true")
    p = P("milestone", cmd_milestone)
    p.add_argument("action", choices=["add", "ls", "show", "set", "showcase", "reach", "cancel", "accept", "reopen"])
    p.add_argument("target", help="project (add, ls) or milestone key"); p.add_argument("title", nargs="?")
    p.add_argument("fields", nargs="*"); p.add_argument("-b", "--body")
    p.add_argument("--trigger", choices=["all", "deploy", "manual"], default="all")
    p.add_argument("--gate", help="ticket whose completion reaches the milestone (with --trigger deploy)")
    p.add_argument("--showcase", choices=["screenshot", "demo", "localhost", "link", "none"], default="screenshot")
    p.add_argument("--due"); p.add_argument("--seq", type=int)
    p.add_argument("--kind", choices=["screenshot", "demo", "localhost", "link", "note"]); p.add_argument("--file"); p.add_argument("--url"); p.add_argument("--note")
    p = P("orchestrate-prompt", cmd_orchestrate_prompt); p.add_argument("project")
    p = P("instructions", cmd_instructions); p.add_argument("project"); p.add_argument("--set", help="new text, or - for stdin; empty clears")
    p = P("quota", cmd_quota); p.add_argument("action", nargs="?", default="status", choices=["status", "clear", "set"])
    p.add_argument("minutes", nargs="?", type=int)
    p = P("daemon", cmd_daemon); p.add_argument("action", choices=["run", "status", "pause", "resume", "install", "uninstall"])
    p = P("hook", cmd_hook); p.add_argument("event", choices=["session-start", "stop", "beat"])

    # convenience aliases for states
    for st, alias in (("reopen", "todo"), ("cancel", "canceled"), ("approve", "done")):
        p = sp.add_parser(st); p.add_argument("key"); p.add_argument("--reason"); p.add_argument("--json", action="store_true")
        p.set_defaults(fn=lambda a, s=alias: (setattr(a, "state", s), setattr(a, "reset", s == "todo"), cmd_move(a)))

    a = ap.parse_args()
    a.fn(a)

if __name__ == "__main__":
    main()
