def milestone(c, key):
    m = c.execute("SELECT * FROM milestones WHERE key=?", (key.upper(),)).fetchone()
    if not m:
        die(f"no milestone {key}")
    return m

def ms_work(c, m):
    """The milestone's own tickets (excluding its showcase ticket)."""
    return c.execute("SELECT * FROM tickets WHERE milestone=? AND key IS NOT ? ORDER BY id",
                     (m["key"], m["showcase_ticket"])).fetchall()

def sync_showcase(c, m):
    """Keep the showcase ticket waiting on the right things, and out of the ready set until there is work."""
    st = m["showcase_ticket"]
    if not st:
        return
    t = c.execute("SELECT * FROM tickets WHERE key=?", (st,)).fetchone()
    if not t or t["state"] not in ("backlog", "todo"):
        return
    if m["trigger"] == "deploy" and m["gate"]:
        need = [m["gate"]]
    else:
        need = [w["key"] for w in ms_work(c, m) if w["state"] != "canceled"]
    for k in need:
        if not c.execute("SELECT 1 FROM deps WHERE ticket=? AND blocker=?", (st, k)).fetchone() and not would_cycle(c, st, k):
            c.execute("INSERT OR IGNORE INTO deps(ticket, blocker) VALUES(?,?)", (st, k))
    want = "todo" if need else "backlog"
    if t["state"] != want:
        c.execute("UPDATE tickets SET state=?, updated=? WHERE key=?", (want, now(), st))

def refresh_milestones(c, project=None):
    q, args = "SELECT * FROM milestones WHERE status NOT IN ('canceled','accepted')", []
    if project:
        q += " AND project=?"; args.append(project)
    for m in c.execute(q, args).fetchall():
        sync_showcase(c, m)
        work = ms_work(c, m)
        shows = json.loads(m["showcases"])
        st_t = c.execute("SELECT * FROM tickets WHERE key=?", (m["showcase_ticket"],)).fetchone() if m["showcase_ticket"] else None
        if m["trigger"] == "deploy":
            g = c.execute("SELECT state FROM tickets WHERE key=?", (m["gate"],)).fetchone() if m["gate"] else None
            reached = bool(g and g["state"] == "done")
        elif m["trigger"] == "manual":
            reached = m["reached"] is not None
        else:
            reached = bool(work) and all(w["state"] in ("done", "canceled") for w in work) and any(w["state"] == "done" for w in work)
        if reached and st_t and st_t["state"] == "done" and not shows and st_t["result"]:
            shows = [{"kind": "note", "note": st_t["result"], "ticket": st_t["key"], "at": now()}]
            c.execute("UPDATE milestones SET showcases=? WHERE key=?", (json.dumps(shows), m["key"]))
        showcase_done = m["showcase_kind"] == "none" or bool(shows) and (not st_t or st_t["state"] in ("done", "canceled"))
        if reached and showcase_done:
            new = "showcased" if shows else "reached"
        elif reached:
            new = "reached"
        elif any(w["state"] in ("in_progress", "in_review", "done") for w in work):
            new = "active"
        else:
            new = "planned"
        if new != m["status"]:
            c.execute("UPDATE milestones SET status=?, reached=CASE WHEN ? IN ('reached','showcased') THEN coalesce(reached, ?) ELSE reached END, "
                      "updated=? WHERE key=?", (new, new, now(), now(), m["key"]))
            event(c, "milestone", project=m["project"], body=f"{m['key']} {m['status']} → {new}: {m['title']}", actor="backlog")

def assign_milestone(c, tkey, mkey):
    if mkey:
        m = milestone(c, mkey)
        t = ticket(c, tkey)
        if m["project"] != t["project"]:
            die(f"{mkey} belongs to {m['project']}, not {t['project']}")
        c.execute("UPDATE tickets SET milestone=? WHERE key=?", (m["key"], tkey))
        sync_showcase(c, milestone(c, mkey))
    else:
        c.execute("UPDATE tickets SET milestone=NULL WHERE key=?", (tkey,))

def project_processes(key, orchestrators_only=False):
    """Live processes working on a project: orchestrator and worker sessions (by their prompt's first line) and
    anything they started that carries BL_ORCH_PROJECT / BL_TICKET in its environment (dev servers, test runs).
    Never this process or its ancestors."""
    mine, pid = set(), os.getpid()
    while pid > 1:
        mine.add(pid)
        try:
            pid = int(subprocess.run(["ps", "-o", "ppid=", "-p", str(pid)], capture_output=True, text=True).stdout.strip() or 0)
        except ValueError:
            break
    k = re.escape(key)
    pats = [rf"# Backlog orchestrator for {k}:", rf"\bBL_ORCH_PROJECT={k}(\s|$)"]
    if not orchestrators_only:
        pats += [rf"-p # Backlog ticket {k}-\d+:", rf"\bBL_TICKET={k}-\d+(\s|$)"]
    rx = re.compile("|".join(pats))
    try:
        out = subprocess.run(["ps", "-axE", "-o", "pid=,command="], capture_output=True, text=True, timeout=10).stdout
    except Exception:
        return []
    found = []
    for line in out.splitlines():
        head, _, rest = line.strip().partition(" ")
        if head.isdigit() and int(head) not in mine and rx.search(rest):
            found.append(int(head))
    return found

def kill_pids(pids):
    """SIGTERM each process (its whole group when it leads one), then SIGKILL what is left after 3 s."""
    for p in pids:
        try:
            os.killpg(p, signal.SIGTERM) if os.getpgid(p) == p else os.kill(p, signal.SIGTERM)
        except (ProcessLookupError, PermissionError):
            pass
    deadline = time.time() + 3
    while time.time() < deadline and any(alive(p) for p in pids):
        time.sleep(0.2)
    for p in pids:
        if alive(p):
            try: os.kill(p, signal.SIGKILL)
            except (ProcessLookupError, PermissionError): pass

def alive(pid):
    try:
        os.kill(pid, 0); return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True

def stop_project_work(c, key, reason, orchestrators_only=False):
    """Stop a project's running work now: kill its orchestrators (and, unless orchestrators_only, its workers and
    whatever they started), then put the tickets they held back to todo without using an attempt. Tickets held by
    an interactive session (cc:...) are left to it. Returns (killed process count, released ticket keys)."""
    p = project_row(c, key)
    pids = set(project_processes(p["key"], orchestrators_only))
    for r in c.execute("SELECT pid FROM runs WHERE project=? AND status='running' AND kind!='daemon'", (p["key"],)):
        if r["pid"] and r["pid"] != os.getpid():
            pids.add(r["pid"])
    held = "claimed_by LIKE 'orch%'" if orchestrators_only else "(claimed_by LIKE 'orch%' OR claimed_by LIKE 'daemon:%')"
    for t in c.execute(f"SELECT key FROM tickets WHERE project=? AND state='in_progress' AND {held}", (p["key"],)).fetchall():
        e = c.execute("SELECT data FROM events WHERE ticket=? AND kind='spawn' ORDER BY id DESC LIMIT 1", (t["key"],)).fetchone()
        wp = json.loads(e["data"]).get("pid") if e and not orchestrators_only else None
        if wp:
            pids.add(int(wp))
    pids = [x for x in pids if alive(x)]
    kill_pids(pids)
    released = []
    with tx(c):
        for t in c.execute(f"SELECT * FROM tickets WHERE project=? AND state='in_progress' AND {held}", (p["key"],)).fetchall():
            release_ticket(c, t, reason, count_failure=False)
            released.append(t["key"])
        c.execute("UPDATE runs SET status='stopped', ended=? WHERE project=? AND status='running' AND kind!='daemon'", (now(), p["key"]))
        c.execute("UPDATE projects SET owner=NULL WHERE key=? AND owner LIKE 'orch%'", (p["key"],))
        if pids or released:
            event(c, "project", project=p["key"], body=f"stopped {len(pids)} processes, released {', '.join(released) or 'no tickets'}: {reason}")
    return len(pids), released

def set_project_status(c, key, new, reason=""):
    p = project_row(c, key)
    if p["status"] == new:
        return
    c.execute("UPDATE projects SET status=?, updated=?" + (", owner=NULL" if new != "executing" else "") + " WHERE key=?",
              (new, now(), p["key"]))
    event(c, "project", project=p["key"], body=f"{p['status']} → {new}" + (f": {reason}" if reason else ""))

def reap(c):
    """Expired leases → back to todo (or failed when out of attempts)."""
    rows = c.execute("SELECT * FROM tickets WHERE state='in_progress' AND lease_until IS NOT NULL AND lease_until < ?",
                     (now(),)).fetchall()
    for t in rows:
        # A lapsed lease usually means the holder went away (closed session, usage limit, sleep), not that the
        # ticket is broken, so it doesn't use an attempt. Workers that exit without reporting do.
        release_ticket(c, t, "lease expired", count_failure=False, actor="reaper")

def unstage_on_release(c, t, reason):
    m = json.loads(t["meta"])
    if not m.get("staged"):
        return
    br = m.pop("staged").get("branch")
    c.execute("UPDATE tickets SET meta=? WHERE key=?", (json.dumps(m), t["key"]))
    for f in c.execute("SELECT t.key FROM deps d JOIN tickets t ON t.key=d.ticket WHERE d.blocker=? AND t.state='in_progress'",
                       (t["key"],)).fetchall():
        event(c, "comment", f["key"], body=f"Your blocker {t['key']} went back ({reason}); its branch {br} may change or vanish. "
                                          "Don't merge until it is done; rebase onto whatever it finally merges.")

def release_ticket(c, t, reason, count_failure=False, actor=None, keep_staged=False):
    if not keep_staged:   # parking keeps its staged branch: its code stands, only the merge waits
        unstage_on_release(c, t, reason)
    maxa = t["max_attempts"] or setting(c, "max_attempts", t["project"], json.loads(t["labels"]))
    if count_failure and t["attempts"] >= maxa:
        new = "failed"
    else:
        new = "todo"
    # a plain release (split / handoff / lease expiry / usage limit) gives the attempt back
    att = t["attempts"] if count_failure else max(0, t["attempts"] - 1)
    c.execute("UPDATE tickets SET state=?, attempts=?, claimed_by=NULL, lease_until=NULL, updated=?, "
              "finished=CASE WHEN ?='failed' THEN ? ELSE finished END WHERE key=?",
              (new, att, now(), new, now(), t["key"]))
    event(c, "state", t["key"], body=f"in_progress → {new}: {reason}", actor=actor)
    return new

QUOTA_RE = re.compile(r"(usage limit (?:reached|hit)|limit reached\||hit your (?:\w+ )?limit|out of (?:extra )?usage|rate_limit_error|overloaded_error|too many requests|\bstatus(?: code)?:? ?429\b|\b429 too many)", re.I)

def quota_until(c, project=None):
    q = setting(c, "quota_until") or ""
    if project:
        pq = setting(c, "quota_until", project) or ""
        q = max(q, pq)
    return q if q and q > now() else None

def detect_quota(text):
    """Return (True, reset_iso or None) when worker output shows a usage/rate limit."""
    if not text or not QUOTA_RE.search(text):
        return False, None
    m = re.search(r"limit reached\|(\d{10})", text)
    if m:
        return True, datetime.fromtimestamp(int(m.group(1)), timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    m = re.search(r"resets?\s+(?:at\s+)?(\d{1,2})(?::(\d{2}))?\s*(am|pm)", text, re.I)
    if m:
        h = int(m.group(1)) % 12 + (12 if m.group(3).lower() == "pm" else 0)
        loc = datetime.now().astimezone()
        t = loc.replace(hour=h, minute=int(m.group(2) or 0), second=0, microsecond=0)
        if t <= loc:
            t += timedelta(days=1)
        return True, t.astimezone(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    return True, None

def note_quota(c, key, text, actor, project=None):
    """Pause the affected project; a projectless event pauses all claims."""
    _, reset = detect_quota(text)
    project = project or (ticket(c, key)["project"] if key else None)
    until = reset or later(setting(c, "quota_backoff_minutes", project))
    cur = quota_until(c, project) or ""
    if until > cur:
        c.execute("INSERT OR REPLACE INTO settings VALUES(?,?,?)", (f"project:{project}" if project else "global", "quota_until", json.dumps(until)))
    line = next((l for l in reversed(text.splitlines()) if QUOTA_RE.search(l)), "")[:200]
    event(c, "quota", key, project=project, body=f"usage limit hit; {'project' if project else 'all'} claims paused until {until}: {line}", actor=actor, data={"until": until})
    return until

def log_tail(lf_name, n=6000):
    try:
        with open(lf_name, "rb") as f:
            f.seek(0, 2); size = f.tell(); f.seek(max(0, size - n))
            return f.read().decode("utf-8", "replace")
    except Exception:
        return ""

def claim(c, project=None, key=None, agent=None, lease=None, force=False, mode="session"):
    agent = agent or agent_id()
    with tx(c):
        reap(c)
        if not force and quota_until(c, project):
            return None, f"paused for usage limit until {quota_until(c, project)}"
        if not force and mode == "daemon":
            if not setting(c, "daemon_enabled"):
                return None, "daemon paused"
            dmax = setting(c, "daemon_max_parallel")
            if c.execute("SELECT count(*) FROM tickets WHERE state='in_progress' AND claimed_by LIKE 'daemon:%'").fetchone()[0] >= dmax:
                return None, f"daemon cap reached ({dmax})"
            today = datetime.now(timezone.utc).strftime("%Y-%m-%dT00:00:00Z")
            runs = c.execute("SELECT count(*) FROM events WHERE kind='claim' AND actor LIKE 'daemon:%' AND at>=?", (today,)).fetchone()[0]
            if runs >= setting(c, "daemon_max_runs_per_day"):
                return None, f"daemon daily limit reached ({runs})"
        if not force:
            gmax = setting(c, "global_max_parallel")
            if c.execute("SELECT count(*) FROM tickets WHERE state='in_progress'").fetchone()[0] >= gmax:
                return None, f"global cap reached ({gmax} in progress)"
            if project:
                pmax = project_cap(c, project)
                if pmax and c.execute("SELECT count(*) FROM tickets WHERE state='in_progress' AND project=?",
                             (project,)).fetchone()[0] >= pmax:
                    return None, f"project cap reached ({pmax} in progress in {project})"
        rows = ready(c, project, agent, key, None if force else mode, include_paused=force)
        if not rows:
            if not force and project:
                pr = c.execute("SELECT status, executor FROM projects WHERE key=?", (project,)).fetchone()
                if pr and pr["status"] != "executing":
                    return None, f"project {project} is {pr['status']} (bl project start {project})"
                if pr and mode == "session" and pr["executor"] == "daemon":
                    return None, f"project {project} is run by the daemon (bl project set {project} executor=session to take over)"
            return None, "nothing ready"
        t = rows[0]
        if mode == "session" and not force:
            # the claiming session/orchestrator owns the project while it works it
            owner = os.environ.get("BL_OWNER") or agent
            c.execute("UPDATE projects SET owner=?, owner_heartbeat=? WHERE key=? AND executor='session'",
                      (owner, now(), t["project"]))
        mins = lease or setting(c, "lease_minutes", t["project"], json.loads(t["labels"]))
        unpark(c, t["key"])
        c.execute("UPDATE tickets SET state='in_progress', claimed_by=?, attempts=attempts+1, lease_until=?, "
                  "started=coalesce(started, ?), updated=? WHERE key=? AND state='todo'",
                  (agent, later(mins), now(), now(), t["key"]))
        event(c, "claim", t["key"], body=f"claimed by {agent} (attempt {t['attempts'] + 1})", actor=agent)
        return ticket(c, t["key"]), None


# ---------------------------------------------------------------- commands
def cmd_init(a):
    c = connect()
    print(f"ok {DB}")

def cmd_project(a):
    if a.action == "report":
        if not a.key:
            die("usage: bl project report KEY [--show|--set FILE|-|--generate|--request|--prompt]")
        return cmd_report(a)
    c = connect()
    if a.action == "add":
        key = a.key.upper()
        with tx(c):
            c.execute("INSERT INTO projects(key,name,repo,doc_slug,status,executor,evergreen,created,updated) "
                      "VALUES(?,?,?,?,'planning',?,?,?,?)",
                      (key, a.name or key, os.path.expanduser(a.repo) if a.repo else None, a.doc,
                       a.executor or "session", 1 if a.evergreen else 0, now(), now()))
            if a.review:
                c.execute("INSERT OR REPLACE INTO settings VALUES(?,?,?)", (f"project:{key}", "review", json.dumps(a.review)))
            event(c, "created", project=key, body=f"project {key}")
        print(key)
    elif a.action == "ls":
        rows = c.execute("""SELECT p.*, (SELECT json_group_object(state, n) FROM
                 (SELECT state, count(*) n FROM tickets WHERE project=p.key GROUP BY state)) counts
                 FROM projects p ORDER BY key""").fetchall()
        out(a, [rowd(r) for r in rows],
            "\n".join(f"{r['key']:16} {r['status']:9} {r['executor']:7}{' evergreen' if r['evergreen'] else ''}  {r['name']}  {r['counts']}  {r['repo'] or ''}"
                      for r in rows) or "(no projects)")
    elif a.action in ("start", "pause", "resume", "plan", "archive", "done"):
        new = {"start": "executing", "resume": "executing", "pause": "paused", "plan": "planning",
               "archive": "archived", "done": "done"}[a.action]
        with tx(c):
            set_project_status(c, a.key, new, " ".join(([a.name] if a.name else []) + a.fields))
        msg = new
        if new in ("paused", "planning", "archived") and not getattr(a, "soft", False):
            n, rel = stop_project_work(c, a.key, f"project {a.action}d" if a.action != "plan" else "project back to planning")
            if n or rel:
                msg += f" (stopped {n} processes; back to todo: {', '.join(rel) or 'none'})"
        print(msg)
    elif a.action == "set":
        p = project_row(c, a.key)
        fields = ([a.name] if a.name else []) + a.fields   # `name` is positional for `add`; here it is the first field
        if not fields or any("=" not in f for f in fields):
            die("usage: bl project set KEY field=value ...")
        with tx(c):
            for kv in fields:
                k, v = kv.split("=", 1)
                if k not in ("name", "repo", "doc_slug", "status", "executor", "evergreen", "instructions"):
                    die(f"unknown project field {k}")
                if k == "executor" and v not in ("daemon", "session", "auto"):
                    die("executor must be session (SO: you start an orchestrator), auto (DSO: the daemon starts orchestrator sessions) or daemon (DQ: queue)")
                if k == "instructions" and v == "-":
                    v = sys.stdin.read().strip()
                if k == "evergreen":
                    v = 1 if v.lower() in ("1", "true", "yes", "on") else 0
                c.execute(f"UPDATE projects SET {k}=?, updated=? WHERE key=?", (v if v != "" else None, now(), p["key"]))
                event(c, "project", project=p["key"], body=f"{k}={v}" if k != "instructions" else f"instructions updated: {(v or '(cleared)')[:200]}")
        msg = "ok"
        if any(kv.split("=", 1) == ["executor", "daemon"] for kv in fields) and p["executor"] != "daemon":
            n, rel = stop_project_work(c, p["key"], "switched to simple (no orchestrator)", orchestrators_only=True)
            if n or rel:
                msg += f" (stopped {n} orchestrator processes; back to todo: {', '.join(rel) or 'none'})"
        print(msg)

def cmd_add(a):
    c = connect()
    proj = project_row(c, a.project)["key"]
    body = Path(a.file).read_text() if a.file else (a.body or "")
    if body == "-":
        body = sys.stdin.read()
    if a.state not in STATES:
        die(f"state must be one of {STATES}")
    with tx(c):
        seq = c.execute("UPDATE projects SET next_seq=next_seq+1 WHERE key=? RETURNING next_seq-1", (proj,)).fetchone()[0]
        key = f"{proj}-{seq}"
        meta = {}
        if a.review: meta["review"] = a.review
        if a.size: meta["size"] = a.size
        if a.model: meta["model"] = a.model
        if a.executor: meta["executor"] = a.executor
        if c.execute("SELECT status FROM projects WHERE key=?", (proj,)).fetchone()["status"] == "done" and a.state == "todo":
            set_project_status(c, proj, "executing", f"new ticket {key}")
        c.execute("""INSERT INTO tickets(key,project,title,body,state,priority,estimate,labels,assignee,doc_slug,parent,
                     locks,max_attempts,meta,created,updated) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)""",
                  (key, proj, a.title, body, a.state, a.priority, a.estimate,
                   json.dumps([l.strip() for l in (a.labels or "").split(",") if l.strip()]),
                   a.assignee, a.doc, a.parent.upper() if a.parent else None,
                   json.dumps([l.strip() for l in (a.lock or "").split(",") if l.strip()]),
                   a.max_attempts, json.dumps(meta), now(), now()))
        event(c, "created", key, proj, body=a.title)
        for b in csv(a.after):
            add_dep(c, key, b)
        for d in csv(a.blocks):
            add_dep(c, d, key, force=a.force)
        if a.milestone:
            assign_milestone(c, key, a.milestone)
    out(a, {"key": key}, key)

def fmt_line(t, extra=""):
    lab = json.loads(t["labels"])
    who = f" @{t['claimed_by']}" if t["claimed_by"] else (f" ({t['assignee']})" if t["assignee"] else "")
    return f"{t['key']:9} {t['state']:11} p{t['priority']} {t['title']}{who}{' [' + ','.join(lab) + ']' if lab else ''}{extra}"

def cmd_ls(a):
    c = connect()
    q, p = "SELECT * FROM tickets WHERE 1=1", []
    if a.project:
        q += " AND project=?"; p.append(a.project.upper())
    if a.state:
        q += f" AND state IN ({','.join('?' * len(a.state.split(',')))})"; p += a.state.split(",")
    elif not a.all:
        q += " AND state NOT IN ('done','canceled')"
    if a.mine:
        q += " AND claimed_by=?"; p.append(agent_id())
    if a.assignee:
        q += " AND assignee=?"; p.append(a.assignee)
    rows = c.execute(q + " ORDER BY project, priority, id", p).fetchall()
    if a.ready:
        rk = {r["key"] for r in ready(c, a.project.upper() if a.project else None)}
        rows = [r for r in rows if r["key"] in rk]
    def extra(t):
        bs = [b["key"] for b in blockers(c, t["key"]) if b["state"] not in SATISFIED]
        return f"  ⟵ {','.join(bs)}" if bs and t["state"] == "todo" else ""
    out(a, [rowd(r) for r in rows], "\n".join(fmt_line(r, extra(r)) for r in rows) or "(none)")

def cmd_show(a):
    c = connect()
    t = ticket(c, a.key)
    bl_ = blockers(c, t["key"]); de = dependents(c, t["key"])
    evs = c.execute("SELECT * FROM events WHERE ticket=? ORDER BY id", (t["key"],)).fetchall()
    d = rowd(t)
    d["blockers"] = [{"key": b["key"], "state": b["state"], "title": b["title"], "result": b["result"]} for b in bl_]
    d["dependents"] = [{"key": x["key"], "state": x["state"], "title": x["title"]} for x in de]
    d["events"] = [dict(e) for e in evs]
    lines = [f"{t['key']}  {t['title']}", f"state={t['state']} priority={t['priority']} attempts={t['attempts']}"
             f"{' claimed_by=' + t['claimed_by'] + ' lease_until=' + t['lease_until'] if t['claimed_by'] else ''}",
             f"labels={t['labels']} locks={t['locks']} assignee={t['assignee']} doc={t['doc_slug']} meta={t['meta']}"]
    if bl_: lines.append("waits on: " + ", ".join(f"{b['key']}({b['state']})" for b in bl_))
    if de: lines.append("blocks:   " + ", ".join(f"{x['key']}({x['state']})" for x in de))
    lines += ["", t["body"] or "(no body)"]
    if t["result"]: lines += ["", "RESULT: " + t["result"]]
    if evs:
        lines += ["", "events:"] + [f"  {e['at']} {e['kind']:8} {e['actor']}: {e['body']}" for e in evs[-15:]]
    out(a, d, "\n".join(lines))

def cmd_next(a):
    c = connect()
    with tx(c):
        reap(c)
    rows = ready(c, a.project.upper() if a.project else None)
    out(a, [rowd(r) for r in rows], "\n".join(fmt_line(r) for r in rows) or "(nothing ready)")

def levels(c, project):
    """Topological waves of the not-yet-final tickets, assuming each one succeeds."""
    rows = c.execute("SELECT * FROM tickets WHERE project=? ORDER BY priority, id", (project,)).fetchall()
    by = {r["key"]: r for r in rows}
    pending = {k for k, r in by.items() if r["state"] not in FINAL + ("backlog",)}
    deps = {k: {d["blocker"] for d in c.execute("SELECT blocker FROM deps WHERE ticket=?", (k,))} for k in pending}
    done = set()
    def ok(b):  # outside-of-project or final blockers count as done; unknown external ones as pending
        if b in done: return True
        if b in by: return by[b]["state"] in SATISFIED
        r = c.execute("SELECT state FROM tickets WHERE key=?", (b,)).fetchone()
        return r and r["state"] in SATISFIED
    waves = []
    while pending:
        w = [k for k in pending if all(ok(b) for b in deps[k])]
        if not w:
            waves.append(sorted(pending, key=lambda k: by[k]["id"])); break   # blocked externally
        w.sort(key=lambda k: (by[k]["priority"], by[k]["id"]))
        waves.append(w); done |= set(w); pending -= set(w)
    return waves, by

def cmd_graph(a):
    c = connect()
    proj = project_row(c, a.project)["key"]
    if a.mermaid:
        rows = c.execute("SELECT * FROM tickets WHERE project=? AND (? OR state NOT IN ('canceled'))", (proj, a.all)).fetchall()
        keys = {r["key"] for r in rows}
        lines = ["graph TD"]
        for r in rows:
            title = r["title"].replace('"', "'")
            lines.append(f'  {r["key"].replace("-", "_")}["{r["key"]} {title}<br/><i>{r["state"]}</i>"]:::{r["state"]}')
        for d in c.execute("SELECT * FROM deps"):
            if d["ticket"] in keys:
                lines.append(f'  {d["blocker"].replace("-", "_")} --> {d["ticket"].replace("-", "_")}')
        lines += ["  classDef done fill:#d4edda,stroke:#28a745", "  classDef in_progress fill:#fff3cd,stroke:#e0a800",
                  "  classDef failed fill:#f8d7da,stroke:#dc3545", "  classDef in_review fill:#d1ecf1,stroke:#17a2b8",
                  "  classDef backlog fill:#eee,stroke:#999,color:#777", "  classDef canceled fill:#eee,stroke:#ccc,color:#aaa",
                  "  classDef todo fill:#fff,stroke:#555"]
        print("\n".join(lines)); return
    waves, by = levels(c, proj)
    fin = [k for k, r in by.items() if r["state"] in FINAL]
    if fin:
        print(f"final ({len(fin)}): " + ", ".join(fin))
    bk = [k for k, r in by.items() if r["state"] == "backlog"]
    if bk:
        print(f"backlog, not scheduled ({len(bk)}): " + ", ".join(bk))
    for i, w in enumerate(waves):
        print(f"wave {i + 1}:")
        for k in w:
            bs = [d["blocker"] for d in c.execute("SELECT blocker FROM deps WHERE ticket=?", (k,))]
            print("  " + fmt_line(by[k], f"  ⟵ {','.join(bs)}" if bs else ""))

def cmd_dep(a):
    c = connect()
    with tx(c):
        if a.action == "add":
            for b in csv(a.blocker):
                add_dep(c, a.ticket, b, force=a.force)
        else:
            for b in csv(a.blocker):
                c.execute("DELETE FROM deps WHERE ticket=? AND blocker=?", (a.ticket.upper(), b))
                event(c, "dep", a.ticket.upper(), body=f"no longer waits on {b}")
    print("ok")

def cmd_claim(a):
    c = connect()
    proj = a.project.upper() if a.project else None
    key = a.key.upper() if a.key else None
    if key and not proj:
        proj = ticket(c, key)["project"]
    t, why = claim(c, proj, key, lease=a.lease, force=a.force)
    if not t:
        if a.json: print(json.dumps({"claimed": None, "reason": why}))
        else: print(f"(no claim: {why})")
        sys.exit(3)
    out(a, rowd(t), fmt_line(t))

def own_check(t, a):
    if t["state"] != "in_progress":
        die(f"{t['key']} is {t['state']}, not in_progress")
    if t["claimed_by"] != agent_id() and not getattr(a, "force", False):
        die(f"{t['key']} is claimed by {t['claimed_by']}, not {agent_id()} (pass --force)")

def cmd_beat(a):
    c = connect()
    with tx(c):
        keys = [k.upper() for k in a.keys] or [r["key"] for r in c.execute(
            "SELECT key FROM tickets WHERE state='in_progress' AND claimed_by=?", (agent_id(),))]
        for k in keys:
            t = ticket(c, k)
            mins = a.lease or setting(c, "lease_minutes", t["project"], json.loads(t["labels"]))
            c.execute("UPDATE tickets SET lease_until=? WHERE key=? AND state='in_progress'", (later(mins), k))
    print("ok " + " ".join(keys))

def cmd_release(a):
    c = connect()
    with tx(c):
        t = ticket(c, a.key); own_check(t, a)
        new = release_ticket(c, t, a.reason or "released")
    print(new)

PR_URL = re.compile(r"https://github\.com/([\w.-]+/[\w.-]+)/pull/(\d+)")

def pr_state(repo, num):
    """MERGED / OPEN / CLOSED, or None if gh can't tell (offline, no auth)."""
    try:
        r = subprocess.run(["gh", "pr", "view", num, "-R", repo, "--json", "state", "-q", ".state"],
                           capture_output=True, text=True, timeout=8)
        return r.stdout.strip() or None if r.returncode == 0 else None
    except Exception:
        return None

def unmerged_prs(*texts):
    """PRs named in a ticket's result that are not merged. A ticket isn't done until its PR is merged."""
    seen, bad = set(), []
    for repo, num in PR_URL.findall(" ".join(x for x in texts if x)):
        if (repo, num) in seen:
            continue
        seen.add((repo, num))
        st = pr_state(repo, num)
        if st != "MERGED":
            bad.append(f"{repo}#{num} ({(st or 'unknown').lower()})")
    return bad

def merge_gate(t, message=None, force=False):
    """Refuse done while a linked PR is unmerged: the ticket stays with the human (in_review) instead."""
    if force or os.environ.get("BL_SKIP_MERGE_GATE"):
        return None
    bad = unmerged_prs(message, t["result"])
    return ("not merged: " + ", ".join(bad) + ". A ticket is done only once its PR is merged; merge it "
            "(or close the PR and say why in the result), or pass --force-merge") if bad else None

def review_policy(c, t):
    m = json.loads(t["meta"])
    return m.get("review") or setting(c, "review", t["project"], json.loads(t["labels"]))

def cmd_done(a):
    c = connect()
    why = blockers_unfinished_reason(c, a.key.upper())
    if why and not a.force:
        die(f"{a.key.upper()}: {why} (or pass --force)")
    gate = merge_gate(ticket(c, a.key), a.message, getattr(a, "force_merge", False))   # outside the write lock
    with tx(c):
        t = ticket(c, a.key)
        if t["state"] == "in_review":
            new = "done"
        else:
            own_check(t, a)
            pol = "self" if a.final else review_policy(c, t)
            new = "done" if pol == "self" else "in_review"
        gate = gate if new == "done" else None
        if gate:
            new = "in_review"
        tl = check_tldr(a.tldr) if a.tldr else None
        c.execute("UPDATE tickets SET state=?, result=coalesce(?, result), claimed_by=NULL, lease_until=NULL, updated=?, "
                  "finished=CASE WHEN ?='done' THEN ? ELSE finished END WHERE key=?",
                  (new, a.message, now(), new, now(), t["key"]))
        if tl or a.message:   # a new result replaces the old TL;DR (the daemon writes one if none was given)
            set_tldr(c, t["key"], tl, "worker")
        note = f" (needs you: {gate})" if gate else ""
        if not gate and new == "in_review" and review_policy(c, t) == "ask":
            note = " (no review policy for this repo: needs a human to approve, or set one with `bl config project:"\
                   f"{t['project']} review self|pr`)"
        event(c, "state", t["key"], body=f"{t['state']} → {new}{note}" + (f": {a.message}" if a.message else ""))
        finalize_projects(c)
    print(new + note)

def cmd_fail(a):
    c = connect()
    with tx(c):
        t = ticket(c, a.key); own_check(t, a)
        tl = check_tldr(a.tldr) if a.tldr else None
        if tl or a.message:
            set_tldr(c, t["key"], tl, "worker")
        if a.message:
            event(c, "comment", t["key"], body="FAIL: " + a.message)
            c.execute("UPDATE tickets SET result=? WHERE key=?", ("FAILED: " + a.message, t["key"]))
        t = ticket(c, a.key)
        new = release_ticket(c, t, a.message or "failed", count_failure=True)
    print(new)

def cmd_comment(a):
    c = connect()
    with tx(c):
        t = ticket(c, a.key)
        event(c, "comment", t["key"], body=" ".join(a.text))
    print("ok")

def cmd_move(a):
    c = connect()
    if a.state not in STATES:
        die(f"state must be one of {STATES}")
    if a.state == "done":
        t = ticket(c, a.key)
        gate = merge_gate(t, None, getattr(a, "force_merge", False))
        if gate:
            die(f"{t['key']} stays {t['state']}: {gate}")
    with tx(c):
        t = ticket(c, a.key)
        fin = now() if a.state in FINAL + ("failed",) else None
        c.execute("UPDATE tickets SET state=?, claimed_by=NULL, lease_until=NULL, updated=?, finished=? WHERE key=?",
                  (a.state, now(), fin, t["key"]))
        if a.state == "todo" and a.reset:
            c.execute("UPDATE tickets SET attempts=0 WHERE key=?", (t["key"],))
        event(c, "state", t["key"], body=f"{t['state']} → {a.state}" + (f": {a.reason}" if a.reason else ""))
        if a.state == "todo" and project_row(c, t["project"])["status"] == "done":
            set_project_status(c, t["project"], "executing", f"{t['key']} reopened")
        finalize_projects(c)
    print(a.state)

def cmd_set(a):
    c = connect()
    allowed = {"title", "body", "priority", "estimate", "assignee", "doc_slug", "parent", "max_attempts", "result"}
    with tx(c):
        t = ticket(c, a.key)
        meta = json.loads(t["meta"])
        for kv in a.fields:
            k, v = kv.split("=", 1)
            if k in ("labels", "locks"):
                c.execute(f"UPDATE tickets SET {k}=? WHERE key=?", (json.dumps([x for x in v.split(",") if x]), t["key"]))
            elif k in allowed:
                c.execute(f"UPDATE tickets SET {k}=? WHERE key=?", (v if v != "" else None, t["key"]))
            elif k == "milestone":
                assign_milestone(c, t["key"], v or None)
            elif k.startswith("meta.") or k in ("review", "size", "model", "harness", "executor"):
                mk = k[5:] if k.startswith("meta.") else k
                if mk == "harness" and v and v not in ("claude", "codex", "pi"):
                    die("harness must be claude, codex or pi")
                if v == "": meta.pop(mk, None)
                else:
                    try: meta[mk] = json.loads(v)
                    except Exception: meta[mk] = v
            else:
                die(f"unknown field {k}")
        c.execute("UPDATE tickets SET meta=?, updated=? WHERE key=?", (json.dumps(meta), now(), t["key"]))
        event(c, "edit", t["key"], body=" ".join(a.fields)[:300])
    print("ok")

def cmd_config(a):
    c = connect()
    scope = a.scope if a.scope == "global" or ":" in a.scope else f"project:{a.scope.upper()}"
    if a.key is None:
        rows = c.execute("SELECT * FROM settings WHERE scope=? ORDER BY key", (scope,)).fetchall()
        eff = {k: setting(c, k, scope.split(":", 1)[1] if scope.startswith("project:") else None) for k in DEFAULTS}
        out(a, {"set": {r["key"]: json.loads(r["value"]) for r in rows}, "effective": eff},
            "\n".join(f"{k:24} {json.dumps(v)}{'  *' if any(r['key'] == k for r in rows) else ''}" for k, v in eff.items())
            + "\n(* set at this scope)")
        return
    if len(a.extra) % 2:
        die("config expects key/value pairs")
    pairs = [(a.key, a.value)] + list(zip(a.extra[::2], a.extra[1::2]))
    with tx(c):
        for key, value in pairs:
            if key == "harness" and value is not None and value not in ("claude", "codex", "pi"):
                die("harness must be claude, codex or pi")
            if value is None:
                c.execute("DELETE FROM settings WHERE scope=? AND key=?", (scope, key))
            else:
                try: v = json.loads(value)
                except Exception: v = value
                c.execute("INSERT OR REPLACE INTO settings VALUES(?,?,?)", (scope, key, json.dumps(v)))
    print("ok")

# ---------------------------------------------------------------- main health (is the repo's main green?)
# A job that tests main (outside bl) records it here; workers see a banner, and hooks stop rebases onto and merges
# into a red main, except by the ticket that fixes it. Stored per repo: settings scope repo:<path>, key main_health.
def repo_of_cwd():
    try:
        d = subprocess.run(["git", "rev-parse", "--path-format=absolute", "--git-common-dir"], capture_output=True,
                           text=True, timeout=5).stdout.strip()
        return str(Path(d).parent.resolve()) if d else None
    except Exception:
        return None

def main_repo(c, repo=None):
    if repo:
        return str(Path(os.path.expanduser(repo)).resolve())
    tk = os.environ.get("BL_TICKET")
    if tk:
        r = c.execute("SELECT p.repo FROM tickets t JOIN projects p ON p.key=t.project WHERE t.key=?", (tk.upper(),)).fetchone()
        if r and r["repo"]:
            return str(Path(os.path.expanduser(r["repo"])).resolve())
    return repo_of_cwd()

def main_health(c, repo):
    if not repo:
        return None
    r = c.execute("SELECT value FROM settings WHERE scope=? AND key='main_health'", (f"repo:{repo}",)).fetchone()
    return json.loads(r["value"]) if r else None

def main_red(c, repo):
    h = main_health(c, repo)
    return h if h and h.get("state") == "red" else None

def red_banner(h, me=None):
    g = (h.get("green_sha") or "")[:9] or "(unknown)"
    L = ["## MAIN IS RED: step back from main",
         f"main fails tests since {(h.get('red_sha') or '')[:9]} (failing: {h.get('suites') or '?'}; last green {g}; "
         f"fix ticket {h.get('ticket') or '(being filed)'}; since {h.get('since', '')}).", ""]
    if me and me == h.get("ticket"):
        L += ["You are the fix ticket: make main green (fix forward, or revert the culprit commit), run the failing "
              "suites, and merge as soon as they pass. Then `bl main green --sha <merged sha>` is set by the next check.", ""]
    else:
        L += [f"- Don't rebase onto or merge into origin/main. Base your branch on the last green commit (`git rebase {g}`) "
              "and test there; hooks refuse `git rebase origin/main` and `gh pr merge` while main is red.",
              "- Failures in code you didn't touch are main's, not yours: don't chase them.",
              "- PR ready? `bl park $BL_TICKET --pr <url>`: it frees your slot, and you are resumed (same session) "
              "when main is green, to rebase, re-test and merge.", ""]
    return L

def cmd_main(a):
    c = connect()
    repo = main_repo(c, a.repo)
    if not repo:
        die("no repo: pass --repo or run inside a git checkout")
    scope = f"repo:{repo}"
    if a.action in ("red", "green"):
        if not a.sha:
            die("--sha is required")
        old = main_health(c, repo) or {}
        h = {"state": a.action, "at": now(), "red_sha": None, "suites": None, "ticket": None, "since": None,
             "green_sha": a.sha if a.action == "green" else (a.green_sha or old.get("green_sha"))}
        if a.action == "red":
            h.update(red_sha=a.sha if old.get("state") != "red" else old.get("red_sha") or a.sha, last_sha=a.sha,
                     suites=a.suites, ticket=(a.ticket or old.get("ticket") or None),
                     since=old.get("since") if old.get("state") == "red" else now())
        with tx(c):
            c.execute("INSERT OR REPLACE INTO settings VALUES(?,?,?)", (scope, "main_health", json.dumps(h)))
            if old.get("state") != a.action:
                event(c, "main", body=f"{repo}: main {a.action} at {a.sha[:9]}" + (f" ({a.suites})" if a.suites else ""))
        print(a.action); return
    h = main_health(c, repo)
    if a.action == "wait":
        deadline = time.time() + a.timeout
        while main_red(c, repo) and time.time() < deadline:
            time.sleep(30)
        h = main_health(c, repo)
    if a.json:
        print(json.dumps({"repo": repo, **(h or {"state": "unknown"})}, indent=1))
    elif h and h.get("state") == "red":
        print(f"RED since {(h.get('red_sha') or '')[:9]} ({h.get('since')}): {h.get('suites')}; last green "
              f"{(h.get('green_sha') or '?')[:9]}; fix ticket {h.get('ticket') or '-'}")
    else:
        print(f"{(h or {}).get('state', 'unknown')}" + (f" at {(h.get('green_sha') or '')[:9]} ({h.get('at')})" if h else ""))
    sys.exit(1 if h and h.get("state") == "red" else 0)

GUARD_MERGE = re.compile(r"\bgh\s+pr\s+merge\b")
GUARD_REBASE = re.compile(r"\bgit\s+(?:-C\s+\S+\s+)?(?:rebase|pull)\b[^;&|\n]*\b(?:origin/main|main|--rebase)\b")

def pre_tool_guard(c, data):
    """PreToolUse (Bash): while the worker's repo has a red main, refuse merging and rebasing onto main,
    except for the fix ticket. Returns a reason to deny, or None."""
    tk = (os.environ.get("BL_TICKET") or "").upper()
    if not tk or data.get("tool_name") != "Bash":
        return None
    cmd = (data.get("tool_input") or {}).get("command") or ""
    what = "merge" if GUARD_MERGE.search(cmd) else "rebase onto main" if GUARD_REBASE.search(cmd) else None
    if not what:
        return None
    if what == "merge":
        why = blockers_unfinished_reason(c, tk)
        if why:
            return f"{tk} is {why}. Don't wait in the session: `bl park {tk} --pr <url>` frees your slot and resumes you when they are done."
    h = main_red(c, main_repo(c))
    if not h or h.get("ticket") == tk:
        return None
    g = (h.get("green_sha") or "")[:9]
    return (f"main is red since {(h.get('red_sha') or '')[:9]} (failing: {h.get('suites')}; fix ticket {h.get('ticket') or 'being filed'}). "
            f"Don't {what} now. Work on the last green commit (`git rebase {g}`), and when your PR is ready run "
            f"`bl park {tk} --pr <url>`: you are resumed when main is green.")

def area_notes(c, project, kind, days=None, limit=30):
    q = "SELECT * FROM notes WHERE project=? AND kind=? AND archived IS NULL"
    args = [project, kind]
    if days:
        q += " AND created >= ?"; args.append((datetime.now(timezone.utc) - timedelta(days=days)).strftime("%Y-%m-%dT%H:%M:%SZ"))
    return c.execute(q + " ORDER BY id DESC LIMIT ?", (*args, limit)).fetchall()

def touching_of(c, project):
    """What each in-flight ticket said it is changing (a note of a ticket that is no longer in flight drops out)."""
    rows = c.execute("SELECT n.ticket, n.body FROM notes n JOIN tickets t ON t.key=n.ticket WHERE n.project=? AND "
                     "n.kind='touching' AND n.archived IS NULL AND t.state='in_progress' ORDER BY n.id", (project,)).fetchall()
    return {r["ticket"]: r["body"] for r in rows}

def area_lines(c, project, me=None, recent=8):
    """The project area: memory, messages, who is touching what, recently done. In worker prompts and `bl area`."""
    clip = lambda x, n: (x if len(x) <= n else x[:n - 1] + "…")
    L = [f"## Project area: {project} (shared by every worker here; `bl area {project}`)"]
    mem = area_notes(c, project, "memory", limit=60)
    older = c.execute("SELECT count(*) FROM notes WHERE project=? AND kind='memory' AND archived IS NULL", (project,)).fetchone()[0] - len(mem)
    L.append("Project memory (facts and decisions to follow; add with `bl memo`):" if mem else
             "Project memory: none yet. Record durable facts and decisions with `bl memo`.")
    L += [f"- #{n['id']} {n['created'][:10]}{' ' + n['ticket'] if n['ticket'] else ''}: {clip(n['body'], 500)}" for n in mem]
    if older > 0:
        L.append(f"- ({older} older not shown: `bl area {project} --json`; retire stale ones with `bl forget ID`)")
    msgs = area_notes(c, project, "msg", days=7, limit=10)
    if msgs:
        L.append("Messages, last 7 days (newest first; add with `bl say`):")
        L += [f"- {n['created'][:16].replace('T', ' ')} {n['ticket'] or n['actor']}: {clip(n['body'], 300)}" for n in msgs]
    touch = touching_of(c, project)
    others = c.execute("SELECT key, title FROM tickets WHERE project=? AND state='in_progress' AND key IS NOT ? ORDER BY started",
                       (project, me)).fetchall()
    L.append("In flight" + (" alongside you (check their PRs before changing the same files):" if me else ":") if others
             else "Nothing else in this project is in flight." if me else "Nothing in flight.")
    L += [f"- {o['key']} {o['title']}" + (f" · touching: {touch[o['key']]}" if o["key"] in touch else "") for o in others]
    done = c.execute("SELECT key, title, result FROM tickets WHERE project=? AND state='done' ORDER BY finished DESC LIMIT ?",
                     (project, recent)).fetchall()
    if done:
        L.append("Recently done:")
        L += [f"- {r['key']} {r['title']}: {clip(((r['result'] or '').splitlines() or [''])[0], 160)}" for r in done]
    L += [f"More: `bl ls {project} --all`, `bl show KEY`, `bl log {project}`; open PRs: `gh pr list`.", ""]
    return L

def project_now(c, t):
    return area_lines(c, t["project"], me=t["key"])

def area_target(c, ref):
    """A project key or a ticket key: (project, ticket or None)."""
    r = c.execute("SELECT key, project FROM tickets WHERE key=?", (ref.upper(),)).fetchone()
    if r:
        return r["project"], r["key"]
    return project_row(c, ref)["key"], None

def cmd_area(a):
    c = connect()
    proj, _ = area_target(c, a.project)
    if a.json:
        rows = c.execute("SELECT * FROM notes WHERE project=? AND archived IS NULL ORDER BY id DESC", (proj,)).fetchall()
        print(json.dumps({"project": proj, "notes": [dict(r) for r in rows], "touching": touching_of(c, proj)}, indent=1)); return
    p = project_row(c, proj)
    head = [f"# {p['key']}: {p['name']}"]
    if p["doc_slug"]:
        head.append(f"Design doc: {p['doc_slug']}")
    if (p["instructions"] or "").strip():
        head += ["", "## Standing instructions", p["instructions"].strip()]
    print("\n".join(head + [""] + area_lines(c, proj)))

def add_note(a, kind):
    c = connect()
    proj, tk = area_target(c, a.target)
    tk = tk or (os.environ.get("BL_TICKET") or "").upper() or None
    if tk and not c.execute("SELECT 1 FROM tickets WHERE key=? AND project=?", (tk, proj)).fetchone():
        tk = None
    body = " ".join(a.text).strip()
    if body == "-":
        body = sys.stdin.read().strip()
    if not body:
        die("empty note")
    if kind == "touching" and not tk:
        die("bl touching needs a ticket key")
    with tx(c):
        if kind == "touching":   # one current line per ticket
            c.execute("UPDATE notes SET archived=? WHERE kind='touching' AND ticket=? AND archived IS NULL", (now(), tk))
        cur = c.execute("INSERT INTO notes(project,kind,ticket,body,actor,created) VALUES(?,?,?,?,?,?)",
                        (proj, kind, tk, body, agent_id(), now()))
        event(c, "note", tk, project=proj, body=f"{kind}: {body[:200]}", data={"note": cur.lastrowid})
    print(f"#{cur.lastrowid}")

def cmd_forget(a):
    c = connect()
    with tx(c):
        n = c.execute("SELECT * FROM notes WHERE id=?", (a.id,)).fetchone()
        if not n:
            die(f"no note #{a.id}")
        c.execute("UPDATE notes SET archived=? WHERE id=?", (now(), a.id))
        event(c, "note", n["ticket"], project=n["project"], body=f"forgot {n['kind']} #{a.id}: {n['body'][:160]}")
    print("ok")

def build_prompt(c, t, compact=False):
    p = project_row(c, t["project"])
    bl_ = blockers(c, t["key"])
    comments = c.execute("SELECT * FROM events WHERE ticket=? AND kind='comment' ORDER BY id DESC LIMIT 10",
                         (t["key"],)).fetchall()
    meta = json.loads(t["meta"])
    L = [f"# Backlog ticket {t['key']}: {t['title']}", "",
         f"Project {p['key']} ({p['name']}), repo: {p['repo'] or 'n/a'}. Attempt {t['attempts']}. "
         f"Review policy: {review_policy(c, t)}. Size hint: {meta.get('size', 'unspecified')}.", ""]
    red = main_red(c, str(Path(os.path.expanduser(p["repo"])).resolve())) if p["repo"] else None
    if red:
        L += red_banner(red, t["key"])
    if (p["instructions"] or "").strip():
        L += ["## Standing instructions for this project", p["instructions"].strip(), ""]
    docs = [d for d in (p["doc_slug"], t["doc_slug"]) if d]
    if docs:
        L.append(f"{setting(c, 'doc_hint', p['key'])}: " + ", ".join(docs)); L.append("")
    if not compact:
        L += ["## Spec", t["body"] or "(no body: the title is the spec)", ""]
        if bl_:
            L.append("## Upstream tickets (what they delivered)")
            for b in bl_:
                L.append(f"- {b['key']} [{b['state']}] {b['title']}: {b['result'] or '(no result recorded)'}")
            L.append("")
        bases = speculative_bases(c, t["key"])
        if bases:
            L += ["## Speculative start: your blockers are still testing",
                  "These blockers have written their code and opened their PRs but are not merged yet. You start on top of them:",
                  *[f"- {k}: branch `{br}`" + (f", {pr}" if pr else "") for k, br, pr in bases],
                  f"Your worktree starts from `origin/{bases[0][1]}`" + (" (merge the other branches in too)." if len(bases) > 1 else "."),
                  "- Work and test as usual. If a blocker's branch moves (a comment or `bl say` tells you), rebase onto it.",
                  "- Do NOT merge until every blocker is done (`bl show KEY`); the hook and `bl done` refuse. Then rebase onto "
                  "origin/main, re-run your scoped tests, and merge.",
                  f"- When your PR is ready and a blocker is still running: `bl park {t['key']} --pr <url>`. That frees your "
                  "slot; the daemon resumes this same session once every blocker is done, to rebase onto main, re-test and merge.", ""]
        L += project_now(c, t)
        if comments:
            L.append("## Notes on this ticket (newest first)")
            L += [f"- {e['at']} {e['actor']}: {e['body']}" for e in comments]
            L.append("")
        if t["milestone"]:
            m = c.execute("SELECT * FROM milestones WHERE key=?", (t["milestone"],)).fetchone()
            if m:
                L += [f"Milestone: {m['key']} {m['title']}" + (f" (due {m['due']})" if m["due"] else ""), ""]
        if meta.get("showcase_for"):
            m = c.execute("SELECT * FROM milestones WHERE key=?", (meta["showcase_for"],)).fetchone()
            if m:
                work = ms_work(c, m)
                L += [f"## Showcase for milestone {m['key']}: {m['title']}",
                      "This ticket produces the portfolio piece for the milestone: proof of what was built, for a human to look at.",
                      SHOWCASE_HOW.get(m["showcase_kind"], SHOWCASE_HOW["screenshot"]).format(m=m["key"]),
                      SHOWCASE_PAGE.format(m=m["key"], slug=f"{m['key'].lower()}-showcase", project=m["project"].lower()),
                      "Cover every ticket below that is done; say what changed and how to see it. Files are copied into the backlog's showcase folder.",
                      *[f"- {w['key']} [{w['state']}] {w['title']}: {(w['result'] or '')[:300]}" for w in work], ""]
        if t["parent"]:
            par = c.execute("SELECT title FROM tickets WHERE key=?", (t["parent"],)).fetchone()
            L += [f"Parent: {t['parent']} {par['title'] if par else ''}", ""]
    L += ["## Protocol (backlog-worker skill)",
          f"- Progress notes: `bl comment {t['key']} \"...\"`. Found more work: `bl add {p['key']} \"title\" --after {t['key']}` "
          f"(or `--blocks {t['key']}` then `bl release {t['key']} --reason split`). Don't widen your own scope.",
          f"- Finish with exactly one: `bl done {t['key']} -m \"what changed, PR url, how verified\"` | "
          f"`bl fail {t['key']} -m \"why, what to try next\"` | `bl release {t['key']} --reason ...`.",
          "- The -m text is what downstream tickets will see. Write it for the next agent.",
          "- Also pass --tldr \"...\" to bl done and bl fail: what the human sees on the board if this lands on them (a review, "
          "a failure). " + TLDR_RULE,
          "- Review policy self = test it yourself and merge per the repo's rules; pr = open the PR and stop; "
          "ask = open the PR and stop, a human decides.",
          "- Never deploy, spend money or push to main unless the spec says so."]
    if setting(c, "speculate", p["key"]):
        L.append(f"- Speculation is on in {p['key']}: as soon as your code is written, pushed and its PR is open, BEFORE your final "
                 f"tests, run `bl stage {t['key']} --branch <your branch> --pr <PR url>` so tickets waiting on you can start on top of "
                 f"it. If you push changes after that, run `bl stage` again (it tells them to rebase). If your approach falls apart, "
                 f"`bl stage {t['key']} --clear`.")
    return "\n".join(L)

def brief_prompt(c, t):
    p = project_row(c, t["project"])
    key = t["key"]
    return f"""{build_prompt(c, t)}

# You are preparing {key} for the human

{key} is assigned to the human: only they can do it (a review, a decision, a test, an answer). Your job in this
first turn is to make that as easy as possible, then hand over. You will be resumed later in this same session with
the human at the keyboard, so everything you learn now stays useful.

Now:
1. Gather the context: the spec above, what every upstream ticket delivered (its result, PR and branch), the design doc
   if there is one, and the repo ({p['repo'] or 'none'}). Read enough to explain it, not to redo it.
2. Make it easy to see: work out exactly how the human checks the work (a local preview URL and the command that starts
   it, a PR link, a screenshot, a file to open). If the spec asks for a local preview and it is safe and cheap, start it
   and leave it running; otherwise give the exact command.
3. Compile the handoff packet and record it. It is a short document the human reads on the board, shaped to THIS
   ticket: a decision, a review of built work, or an errand only they can do (a form, an account, a call) all read
   differently, so pick the sections that fit and name them yourself. Fields:
   - tldr (required): the line the board shows on "Waiting on you". The human reads only this before deciding to open
     it: {TLDR_RULE}
   - pics (optional, use them): [{{"file": "/abs/path.png", "caption": "..."}}] screenshots, before/after shots or a mock
     of the options. The human will not read long text; anything that takes more than the TL;DR to explain should be
     shown as a picture (take a screenshot of the preview, or draw a quick mock) rather than written out.
   - summary (required): what this is and what they decide or do, one or two sentences
   - body (required): Markdown, short. Use the headings this task needs, for example "How to see it", "What's built",
     "Steps", "What to check", "Known gaps", "Background". No empty or forced sections; skip what doesn't apply.
   - see (optional): {{"url": ..., "how": ...}} when there is something to open (a preview, a page)
   - links (optional): [{{"label": ..., "url": ...}}]: PRs, docs, the official page
   - checklist (optional): [{{"item": ..., "detail": ...}}] steps they can tick off as they go, titled by
     checklist_title (for example "Steps", "Before you merge"; default "Checklist")
   - asks (required, 1 to 3): what you need from them, the last one the decision. Each is
     {{"q": "...", "options": ["A: ...", "B: ..."], "note": "what each answer triggers"}}, or {{"q": "...", "kind": "text"}} for a
     free answer (a name, a number). The board shows options as choices next to a free-text box.
   Record it with a heredoc: `bl handoff {key} --packet - <<'EOF'` + the JSON + `EOF`. That moves the ticket to
   "awaiting" and notifies the human.
4. Your final message repeats the packet in readable form (the summary, the body and the asks).

Do not mark the ticket done and do not change other tickets in this first turn.

When the human answers (in this session, later):
- First run `bl handoff {key} --phase discussing` so the board shows you are on it.
- Interview briefly if their answer is ambiguous; one question at a time.
- Turn every problem they report into a ticket: `bl add {p['key']} "<fix>" -b "<what they saw, where, what they expect>" --blocks {key}`
  (so this decision waits for the fixes), or `--after {key}` when it can follow.
- Record their words: `bl comment {key} "<decision and reasons>"`.
- When they give the decision, close it: `bl resolve {key} -m "<decision, by the human, and what follows>"`.
  If fixes were filed first, leave {key} open; it comes back to them when the fixes land."""

TLDR_RULE = ("at most 3 short sentences of plain words; if it needs more, use '- ' bullets (at most 6, one line each). "
             "Lead with what the human must do or decide. Anything longer belongs in a picture or mock, not prose.")

HANDOFF_FIELDS = {
    "tldr": "required: what the board shows on the 'Waiting on you' row. " + TLDR_RULE,
    "pics": "optional: [{\"file\": \"/abs/path/shot.png\", \"caption\": \"...\"}] or [{\"url\": ...}]: screenshots and mocks, shown before the text",
    "summary": "one or two sentences: what this is and what you decide or do",
    "body": "Markdown shaped to this ticket, with the headings it needs (How to see it, Steps, What's built, Known gaps ...)",
    "checklist": "optional: [{\"item\": \"Apply on irs.gov/ein\", \"detail\": \"...\"}] steps to tick off; checklist_title names them",
    "asks": "[{\"q\": \"Trade name?\", \"options\": [\"Mapcouch\", \"Leave blank\"], \"note\": \"...\"}, {\"q\": \"...\", \"kind\": \"text\"}]: 1 to 3, the last the decision",
    "legacy (still accepted)": "done, tests, gaps, questions",
    "see": "how to see it: {\"url\": \"http://localhost:4810\", \"how\": \"the command that starts it, sign-in notes\"}",
    "links": "[{\"label\": \"PR #213\", \"url\": \"https://...\"}] (PRs, design doc, screenshots)",
    "done": "[{\"title\": \"Brush levels\", \"ref\": \"#194\", \"what\": \"what the human will see\"}]: every ticket and PR delivered, workers' too",
    "tests": "[{\"step\": \"brush Faint, Some, Rugged on one stretch\", \"good\": \"...\", \"bad\": \"...\"}]",
    "gaps": "[\"known gap or limitation\"] (may be empty)",
    "questions": "[\"Go / no-go to merge PR #213 (merging deploys)?\", ...]: 1 to 3, the last one the decision",
}

def _obj(x, key, **extra):
    """A plain string becomes {key: string}; a dict passes through."""
    return x if isinstance(x, dict) else {key: str(x), **extra}

def normalize_packet(pk):
    """Briefing sessions often write links, done and tests as plain strings. The board needs objects."""
    out = dict(pk)
    links = []
    for x in pk.get("links") or []:
        if isinstance(x, dict):
            links.append(x)
        else:
            m = re.search(r"https?://\S+", str(x))
            if m:   # "https://x (what it is)" or "what it is: https://x"
                url = m.group(0).rstrip(").,;")
                label = (str(x).replace(m.group(0), "").strip(" -:()") or url)
                links.append({"label": label, "url": url})
            # a link with no URL (like "MC-PAYMENT-2 is waiting on this") is dropped
    out["links"] = links
    out["done"] = [_obj(x, "title") for x in pk.get("done") or []]
    out["tests"] = [_obj(x, "step") for x in pk.get("tests") or []]
    out["gaps"] = [str(x) for x in pk.get("gaps") or []]
    out["questions"] = [str(x) for x in pk.get("questions") or []]
    out["checklist"] = [_obj(x, "item") for x in pk.get("checklist") or []]
    asks = []
    for x in pk.get("asks") or []:
        a = _obj(x, "q")
        a["options"] = [str(o) for o in a.get("options") or []]
        asks.append(a)
    out["asks"] = asks
    return out

def _sentences(text):
    return [x for x in re.split(r"(?<=[.!?。！？])\s+", text.strip()) if x.strip()]

def tldr_problem(text):
    """None if text is a good TL;DR, else what is wrong with it."""
    if isinstance(text, list):
        text = "\n".join("- " + str(x).lstrip("-*• ") for x in text)
    text = (text if isinstance(text, str) else "").strip()
    if not text:
        return "empty"
    lines = [l for l in text.splitlines() if l.strip()]
    bullets = [l for l in lines if re.match(r"\s*([-*•]|\d+[.)])\s+", l)]
    if bullets and len(bullets) == len(lines) or (len(lines) > 1 and len(bullets) == len(lines) - 1 and not re.match(r"\s*([-*•]|\d+[.)])\s+", lines[0])):
        items = bullets
        if len(items) > 6:
            return f"{len(items)} bullets; keep it to 6"
        long = [b for b in items if len(b) > 160]
        if long:
            return "a bullet is over 160 characters; one line each"
        lead = lines[0] if len(bullets) < len(lines) else ""
        if lead and (len(_sentences(lead)) > 2 or len(lead) > 200):
            return "the line before the bullets is long; one short lead-in at most"
        return None
    n = len(_sentences(text))
    if n > 3:
        return f"{n} sentences; at most 3, or switch to '- ' bullets"
    if len(text) > 360:
        return f"{len(text)} characters; keep it under 360, or use bullets"
    return None

def check_tldr(text, what="--tldr"):
    if isinstance(text, list):
        text = "\n".join("- " + str(x).lstrip("-*• ") for x in text)
    if not isinstance(text, str):
        die(f"{what} must be text. A TL;DR is {TLDR_RULE}")
    why = tldr_problem(text)
    if why:
        die(f"{what} is too long ({why}). A TL;DR is {TLDR_RULE}")
    return text.strip()

def set_tldr(c, key, text, source):
    t = ticket(c, key)
    meta = json.loads(t["meta"])
    if text:
        meta["tldr"] = {"text": text.strip(), "at": now(), "by": source}
    else:
        meta.pop("tldr", None)
    c.execute("UPDATE tickets SET meta=? WHERE key=?", (json.dumps(meta), key))

def stash_pics(key, pics):
    """Handoff pictures: files are copied under the showcase dir so the board can serve them; URLs pass through."""
    out = []
    if isinstance(pics, (str, dict)):
        pics = [pics]
    for i, x in enumerate(pics or []):
        x = x if isinstance(x, dict) else {"file": str(x)}
        if x.get("url"):
            out.append({"url": x["url"], "caption": x.get("caption", "")}); continue
        f = x.get("file") or x.get("path")
        if not f:
            continue
        src = Path(f).expanduser()
        if not src.is_absolute():
            src = SHOWCASE_DIR / f
        if not src.is_file():
            die(f"picture not found (or not a file): {f}")
        try:
            rel = src.resolve().relative_to(SHOWCASE_DIR.resolve())
        except ValueError:
            dest = SHOWCASE_DIR / "handoff" / key / f"{i + 1}-{src.name}"
            dest.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(src, dest)
            rel = dest.relative_to(SHOWCASE_DIR)
        out.append({"file": str(rel), "caption": x.get("caption", "")})
    return out

def handoff_of(t):
    return json.loads(t["meta"]).get("handoff") or {}

def set_handoff(c, t, **kw):
    meta = json.loads(t["meta"])
    h = meta.get("handoff") or {}
    h.update({k: v for k, v in kw.items() if v is not None})
    h["updated"] = now()
    meta["handoff"] = h
    c.execute("UPDATE tickets SET meta=?, updated=? WHERE key=?", (json.dumps(meta), now(), t["key"]))
    return h

def notify_human(c, t, msg):
    url = f"{setting(c, 'board_url')}/{t['project']}/{t['key']}"
    env = {**os.environ, "BL_MSG": msg, "BL_TICKET": t["key"], "BL_URL": url, "BL_PROJECT": t["project"]}
    cmd = setting(c, "notify_human_cmd", t["project"])
    if cmd:
        subprocess.Popen(cmd, shell=True, env=env)
    elif sys.platform == "darwin":
        script = 'on run argv\ndisplay notification (item 1 of argv) with title "Backlog needs you" subtitle (item 2 of argv) sound name "Glass"\nend run'
        subprocess.Popen(["osascript", "-e", script, msg, t["key"]], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    proj_cmd = setting(c, "notify_cmd", t["project"])
    if proj_cmd:
        subprocess.Popen(proj_cmd, shell=True, env=env)

def cmd_handoff(a):
    """Record the handoff packet for a human ticket (or move its phase)."""
    c = connect()
    with tx(c):
        t = ticket(c, a.key)
        if t["assignee"] != "human" and not a.force:
            die(f"{t['key']} is not assigned to human")
        if a.packet:
            raw = sys.stdin.read() if a.packet == "-" else Path(a.packet).read_text()
            try:
                pk = json.loads(raw)
            except Exception as e:
                die(f"packet is not JSON: {e}")
            pk = normalize_packet(pk) if isinstance(pk, dict) else pk
            if pk.get("body") or pk.get("asks"):   # the flexible packet
                missing = [k for k in ("tldr", "summary", "body", "asks") if not pk.get(k)]
            else:                                   # the older fixed packet
                missing = [k for k in ("summary", "see", "done", "tests", "questions") if not pk.get(k)]
            if missing:
                die("packet is missing " + ", ".join(missing) + ". Fields:\n" + "\n".join(f"  {k}: {v}" for k, v in HANDOFF_FIELDS.items()))
            if pk.get("tldr"):
                pk["tldr"] = check_tldr(pk["tldr"], "the packet's tldr")
            if pk.get("pics"):
                pk["pics"] = stash_pics(t["key"], pk["pics"])
            sid = session_id()
            if pk.get("tldr"):
                set_tldr(c, t["key"], pk["tldr"], "handoff"); t = ticket(c, a.key)
            h = set_handoff(c, t, packet=pk, phase="awaiting", session=sid or handoff_of(t).get("session"), ready_at=now())
            event(c, "handoff", t["key"], body=f"handoff ready: {pk['summary'][:200]}", data={"phase": "awaiting"})
            notify_human(c, t, (pk.get("tldr") or pk["summary"])[:180])
            print("awaiting: the human has been notified")
        elif a.phase:
            set_handoff(c, t, phase=a.phase, **({"answered_at": now()} if a.phase == "discussing" else {}))
            event(c, "handoff", t["key"], body=f"handoff phase: {a.phase}")
            print(a.phase)
        else:
            print(json.dumps(handoff_of(t), indent=1))

def cmd_tldr(a):
    """Show or set the TL;DR the board shows for a ticket waiting on the human."""
    c = connect()
    with tx(c):
        t = ticket(c, a.key)
        if a.text is None:
            print((json.loads(t["meta"]).get("tldr") or {}).get("text", "")); return
        text = sys.stdin.read() if a.text == "-" else a.text
        set_tldr(c, t["key"], check_tldr(text, "the TL;DR") if text.strip() else None, a.by or os.environ.get("BL_AGENT") or "human")
    print("ok")

def cmd_brief_prompt(a):
    c = connect()
    print(brief_prompt(c, ticket(c, a.key)))

def cmd_resolve(a):
    """Close a human ticket with the human's decision (no claim needed)."""
    c = connect()
    if a.state == "done":
        gate = merge_gate(ticket(c, a.key), a.message, getattr(a, "force_merge", False))
        if gate:
            die(f"{a.key} stays open: {gate}")
    with tx(c):
        t = ticket(c, a.key)
        if t["state"] in FINAL:
            die(f"{t['key']} is already {t['state']}")
        if t["assignee"] != "human" and not a.force:
            die(f"{t['key']} is not assigned to human; workers finish with bl done (or pass --force)")
        new = a.state
        c.execute("UPDATE tickets SET state=?, result=coalesce(?, result), claimed_by=NULL, lease_until=NULL, updated=?, finished=? WHERE key=?",
                  (new, a.message, now(), now(), t["key"]))
        event(c, "state", t["key"], body=f"{t['state']} → {new} (human decision)" + (f": {a.message}" if a.message else ""))
        if handoff_of(t):
            set_handoff(c, ticket(c, t["key"]), phase="done", decided_at=now())
        finalize_projects(c)
    print(new)

def orchestrator_prompt(c, proj, agent):
    p = project_row(c, proj)
    n = project_cap(c, proj) or setting(c, "global_max_parallel")
    docs = f"\nDesign doc: {p['doc_slug']} ({setting(c, 'doc_hint', proj)})." if p["doc_slug"] else ""
    ins = (p["instructions"] or "").strip()
    standing = (f"\n\n## Standing instructions from the user\nFollow these over the defaults below (the safety rule at the end still holds). Pass the ones that matter to each subagent.\n{ins}\n"
                if ins else "")
    return f"""# Backlog orchestrator for {proj}: {p['name']}

You are the orchestrator session for backlog project {proj} (repo: {p['repo'] or 'n/a'}). Nobody is watching; do not ask questions.{docs}
Your bl identity is {agent}; you own the project while you run. Read ~/.backlog/LOCAL.md first if it exists.{standing}
The user can change standing instructions while you run: `bl instructions {proj}` prints the current ones; check it at the start of every round.

Loop until nothing is ready and none of your tickets are in progress:
1. `bl next {proj} --json` lists ready tickets. `bl status` shows the rest.
2. Claim up to {n} at a time: `bl claim {proj} KEY --json` (exit 3 = cap reached or nothing ready; that's fine).
3. For every claimed ticket, dispatch one subagent (Agent tool), all in the same message so they run in parallel. Brief = the full output of `bl prompt KEY`, plus: "Follow the backlog-worker contract. Work in the repo's conventions. Finish with `bl done KEY -m ...`, `bl fail KEY -m ...` or `bl release KEY --reason ...` yourself." Use the ticket's `model` if it sets one (bl show KEY --json → meta.model), else opus. A ticket that is size xl may get its own subagents.
4. When subagents return, check each ticket (`bl show KEY --json`). If one is still in_progress, record the outcome from its report with bl done/fail.
5. Between rounds, use judgment: read what finished tickets delivered, tighten specs of downstream tickets (`bl set KEY body=...`, `bl comment`), add missing tickets (`bl add {proj} ... --after KEY`; no deploy ticket after every ticket: scheduled deploys ship merged work, and a deploy on demand is for when something must be live sooner), and leave anything that needs a human to them (`--assignee human`).
6. Repeat. If claims stop with "paused for usage limit", stop: the daemon resumes the project later.

Never deploy, spend money or push to main unless a ticket says so and isn't assigned to human. End with a short summary of what got done and what is left."""

def cmd_instructions(a):
    c = connect()
    p = project_row(c, a.project)
    if a.set is not None:
        v = sys.stdin.read().strip() if a.set == "-" else a.set.strip()
        with tx(c):
            c.execute("UPDATE projects SET instructions=?, updated=? WHERE key=?", (v or None, now(), p["key"]))
            event(c, "project", project=p["key"], body=f"instructions updated: {(v or '(cleared)')[:200]}")
        print("ok"); return
    print((p["instructions"] or "").strip() or "(no standing instructions)")

def cmd_orchestrate_prompt(a):
    c = connect()
    print(orchestrator_prompt(c, project_row(c, a.project)["key"], os.environ.get("BL_AGENT") or agent_id()))

def cmd_quota(a):
    c = connect()
    with tx(c):
        if a.action == "clear":
            c.execute("DELETE FROM settings WHERE scope='global' AND key='quota_until'")
            event(c, "quota", body="cleared")
        elif a.action == "set":
            until = later(a.minutes or setting(c, "quota_backoff_minutes"))
            c.execute("INSERT OR REPLACE INTO settings VALUES('global','quota_until',?)", (json.dumps(until),))
            event(c, "quota", body=f"paused by hand until {until}")
    q = quota_until(c)
    print(f"paused for usage limit until {q}" if q else "no usage-limit pause")

def cmd_prompt(a):
    c = connect()
    print(build_prompt(c, ticket(c, a.key), compact=a.compact))

# ---------------------------------------------------------------- speculation (stacked branches)
# A worker whose code is written and whose PR is open runs `bl stage KEY --branch B` before its final tests. In a
# project with `speculate` on, tickets waiting on it then become ready and start on branch B instead of main. They
# may not merge (the PreToolUse hook and bl done refuse) until every blocker is done; then they rebase onto main,
# re-run their scoped tests and merge. If a blocker goes back to todo or fails, its followers are told.
def open_blockers(c, key):
    return c.execute("SELECT b.* FROM deps d JOIN tickets b ON b.key=d.blocker WHERE d.ticket=? "
                     "AND b.state NOT IN ('done','canceled') ORDER BY b.id", (key,)).fetchall()

def staged_of(t):
    return json.loads(t["meta"]).get("staged") if t else None

def speculative_bases(c, key):
    """(blocker key, branch, pr) for every unfinished blocker this ticket is starting on top of."""
    return [(b["key"], staged_of(b)["branch"], staged_of(b).get("pr")) for b in open_blockers(c, key)
            if (b["state"] == "in_progress" or json.loads(b["meta"]).get("parked")) and (staged_of(b) or {}).get("branch")]

def cmd_stage(a):
    c = connect()
    with tx(c):
        t = ticket(c, a.key); own_check(t, a)
        if t["state"] != "in_progress":
            die(f"{t['key']} is {t['state']}; only an in-progress ticket can be staged")
        m = json.loads(t["meta"])
        if a.clear:
            m.pop("staged", None)
            body = "unstaged: followers must not build on its branch any more"
        else:
            if not a.branch:
                die("--branch is required (the pushed branch your PR is on)")
            m["staged"] = {"branch": a.branch, "pr": a.pr, "at": now(), "by": agent_id()}
            body = f"staged on {a.branch}" + (f" ({a.pr})" if a.pr else "") + ": code done, tests running; followers may start on it"
        c.execute("UPDATE tickets SET meta=?, updated=? WHERE key=?", (json.dumps(m), now(), t["key"]))
        event(c, "stage", t["key"], body=body)
        # tell followers already running on top of it
        for f in c.execute("SELECT t.key FROM deps d JOIN tickets t ON t.key=d.ticket WHERE d.blocker=? AND t.state='in_progress'",
                           (t["key"],)).fetchall():
            event(c, "comment", f["key"], body=f"{t['key']} {body}. If you build on its branch, rebase onto origin/{a.branch or '(its PR)'} now.")
    print("unstaged" if a.clear else f"staged {t['key']} on {a.branch}")

def blockers_unfinished_reason(c, key):
    ob = open_blockers(c, key)
    if not ob:
        return None
    return ("blocked by unfinished " + ", ".join(f"{b['key']} ({b['state']}{', staged' if staged_of(b) else ''})" for b in ob) +
            ": merge only after they are done, then rebase onto origin/main and re-run your scoped tests")

def worktree_for(c, t):
    p = project_row(c, t["project"])
    if not p["repo"]:
        if os.environ.get("BL_DAEMON"):
            d = HOME / "work" / t["key"]
            d.mkdir(parents=True, exist_ok=True)
            return str(d)
        return os.getcwd()
    repo = Path(p["repo"]).expanduser()
    if not setting(c, "worktree", p["key"], json.loads(t["labels"])):
        return str(repo)
    wt = repo.parent / f"{repo.name}-wt" / t["key"]
    if not wt.exists():
        wt.parent.mkdir(parents=True, exist_ok=True)
        branch = f"bl/{t['key'].lower()}"
        start = []
        bases = speculative_bases(c, t["key"])
        if bases:   # speculative start: on top of the first staged blocker's branch (the prompt says to merge any others)
            f = subprocess.run(["git", "-C", str(repo), "fetch", "-q", "origin", bases[0][1]], capture_output=True, text=True)
            if f.returncode == 0:
                start = [f"origin/{bases[0][1]}"]
        r = subprocess.run(["git", "-C", str(repo), "worktree", "add", str(wt), "-b", branch, *start],
                           capture_output=True, text=True)
        if r.returncode:
            r = subprocess.run(["git", "-C", str(repo), "worktree", "add", str(wt), branch], capture_output=True, text=True)
        if r.returncode:
            die(f"worktree failed: {r.stderr.strip()}")
    return str(wt)

def cmd_worktree(a):
    c = connect()
    print(worktree_for(c, ticket(c, a.key)))

def cmd_status(a):
    c = connect()
    with tx(c):
        reap(c)
    projs = c.execute("SELECT * FROM projects WHERE status!='archived' ORDER BY key").fetchall()
    res, lines = [], []
    for p in projs:
        cnt = {r["state"]: r["n"] for r in c.execute("SELECT state, count(*) n FROM tickets WHERE project=? GROUP BY state", (p["key"],))}
        tot = sum(cnt.values())
        rd = ready(c, p["key"])
        human = c.execute("""SELECT key,title,state FROM tickets t WHERE project=? AND (state IN ('failed','in_review')
                 OR (state='todo' AND assignee='human' AND NOT EXISTS (SELECT 1 FROM deps d JOIN tickets b ON b.key=d.blocker
                     WHERE d.ticket=t.key AND b.state NOT IN ('done','canceled'))))""", (p["key"],)).fetchall()
        runs = c.execute("SELECT * FROM runs WHERE project=? AND status='running'", (p["key"],)).fetchall()
        orphan = bool(c.execute(f"SELECT 1 FROM projects p WHERE key=? AND status='executing' AND executor='session' AND {orphan_sql(c)}",
                                (p["key"],)).fetchone()) and not runs
        res.append({"project": p["key"], "status": p["status"], "executor": p["executor"], "evergreen": bool(p["evergreen"]),
                    "owner": p["owner"], "orphaned": orphan, "counts": cnt, "ready": [r["key"] for r in rd],
                    "needs_human": [dict(h) for h in human], "runs": [dict(r) for r in runs]})
        lines.append(f"{p['key']} [{p['status']}, {p['executor']}{', evergreen' if p['evergreen'] else ''}"
                     f"{', ORPHANED' if orphan else ''}]: {cnt.get('done', 0)}/{tot} done · " +
                     " ".join(f"{s}={cnt[s]}" for s in STATES if s in cnt and s != "done") +
                     (f" · ready: {','.join(r['key'] for r in rd[:6])}" if rd else "") +
                     (f" · run pid {runs[0]['pid']}" if runs else ""))
        nxt = c.execute("SELECT * FROM milestones WHERE project=? AND status IN ('planned','active','reached') ORDER BY seq LIMIT 1",
                        (p["key"],)).fetchone()
        if nxt:
            w = ms_work(c, nxt)
            lines.append(f"   next milestone: {nxt['key']} {nxt['title']} [{nxt['status']}, "
                         f"{sum(1 for x in w if x['state'] == 'done')}/{len(w)} done{', due ' + nxt['due'] if nxt['due'] else ''}]")
        for h in human:
            lines.append(f"   needs you: {h['key']} [{h['state']}] {h['title']}")
        for m in c.execute("SELECT * FROM milestones WHERE project=? AND status='showcased'", (p["key"],)).fetchall():
            lines.append(f"   needs you: review the showcase of {m['key']} {m['title']} (bl milestone accept|reopen {m['key']})")
    d = daemon_info(c)
    q = quota_until(c)
    head = (f"{'USAGE LIMIT: claims paused until ' + q + ' (bl quota clear) · ' if q else ''}"
            f"daemon: {'running' if d['alive'] else 'NOT running'}{'' if d['enabled'] else ' (paused)'} · "
            f"{d['workers']} working · {d['runs_today']} runs today · in flight {d['in_flight']}/{setting(c, 'global_max_parallel')}")
    if a.json:
        print(json.dumps({"daemon": d, "projects": res}, indent=1, default=str))
    else:
        print("\n".join([head] + lines) if lines else head)

def daemon_info(c):
    r = c.execute("SELECT * FROM runs WHERE kind='daemon' ORDER BY id DESC LIMIT 1").fetchone()
    alive = False
    if r and r["status"] == "running":
        try:
            os.kill(r["pid"], 0); alive = True
        except ProcessLookupError:
            alive = False
        except PermissionError:
            alive = True
    today = datetime.now(timezone.utc).strftime("%Y-%m-%dT00:00:00Z")
    return {"alive": alive, "pid": r["pid"] if r else None, "heartbeat": r["heartbeat"] if r else None,
            "enabled": bool(setting(c, "daemon_enabled")), "quota_until": quota_until(c),
            "workers": c.execute("SELECT count(*) FROM tickets WHERE state='in_progress' AND claimed_by LIKE 'daemon:%'").fetchone()[0],
            "in_flight": c.execute("SELECT count(*) FROM tickets WHERE state='in_progress'").fetchone()[0],
            "runs_today": c.execute("SELECT count(*) FROM events WHERE kind='claim' AND actor LIKE 'daemon:%' AND at>=?", (today,)).fetchone()[0]}

def cmd_log(a):
    c = connect()
    q, p = "SELECT * FROM events WHERE 1=1", []
    if a.project: q += " AND project=?"; p.append(a.project.upper())
    rows = c.execute(q + " ORDER BY id DESC LIMIT ?", p + [a.n]).fetchall()[::-1]
    out(a, [dict(r) for r in rows], "\n".join(f"{r['at']} {r['ticket'] or r['project'] or '':9} {r['kind']:8} {r['actor']}: {r['body']}" for r in rows))

def cmd_export(a):
    c = connect()
    p = project_row(c, a.project)
    rows = c.execute("SELECT * FROM tickets WHERE project=? ORDER BY priority, id", (p["key"],)).fetchall()
    cnt = {}
    for r in rows: cnt[r["state"]] = cnt.get(r["state"], 0) + 1
    L = [f"# Backlog: {p['name']} ({p['key']})", "",
         f"Exported {now()}. {cnt.get('done', 0)}/{len(rows)} done. " + ", ".join(f"{k} {v}" for k, v in cnt.items()), ""]
    if p["doc_slug"]: L += [f"Design doc: `{p['doc_slug']}`", ""]
    L += ["| Ticket | State | P | Title | Waits on | Result |", "|---|---|---|---|---|---|"]
    for r in rows:
        bs = ",".join(b["key"] for b in blockers(c, r["key"]))
        res = (r["result"] or "").replace("|", "\\|").replace("\n", " ")[:160]
        L.append(f"| {r['key']} | {r['state']} | {r['priority']} | {r['title'].replace('|', '/')} | {bs} | {res} |")
    L += ["", "```mermaid"]
    print("\n".join(L))
    a.mermaid, a.all = True, False
    cmd_graph(a)
    print("```")


# ---------------------------------------------------------------- milestones
def cmd_milestone(a):
    c = connect()
    act = a.action
    if act == "add":
        proj = project_row(c, a.target)["key"]
        if not a.title:
            die("usage: bl milestone add PROJ \"Title\" [--trigger all|deploy|manual] [--gate KEY] [--showcase KIND] [--due DATE]")
        if a.trigger == "deploy" and not a.gate:
            die("--trigger deploy needs --gate KEY (the deploy ticket)")
        with tx(c):
            n = c.execute("SELECT count(*) FROM milestones WHERE project=?", (proj,)).fetchone()[0] + 1
            key = f"{proj}-M{n}"
            while c.execute("SELECT 1 FROM milestones WHERE key=?", (key,)).fetchone():
                n += 1; key = f"{proj}-M{n}"
            seq = a.seq if a.seq is not None else (c.execute("SELECT coalesce(max(seq),0) FROM milestones WHERE project=?", (proj,)).fetchone()[0] + 1)
            c.execute("INSERT INTO milestones(key,project,seq,title,body,trigger,gate,showcase_kind,due,created,updated) VALUES(?,?,?,?,?,?,?,?,?,?,?)",
                      (key, proj, seq, a.title, a.body or "", a.trigger, a.gate.upper() if a.gate else None, a.showcase, a.due, now(), now()))
            if a.gate:
                ticket(c, a.gate)
                c.execute("UPDATE tickets SET milestone=coalesce(milestone, ?) WHERE key=?", (key, a.gate.upper()))
            if a.showcase != "none":
                tseq = c.execute("UPDATE projects SET next_seq=next_seq+1 WHERE key=? RETURNING next_seq-1", (proj,)).fetchone()[0]
                tk = f"{proj}-{tseq}"
                body = (f"Produce the showcase for milestone {key}: {a.title}.\n\nKind: {a.showcase}. "
                        f"Done when: the showcase is recorded with `bl milestone showcase {key} ...` and `bl done` summarizes it.")
                c.execute("""INSERT INTO tickets(key,project,title,body,state,priority,labels,meta,milestone,created,updated)
                             VALUES(?,?,?,?,'backlog',2,'["showcase"]',?,?,?,?)""",
                          (tk, proj, f"Showcase: {a.title}", body,
                           json.dumps({"showcase_for": key, **({"model": "sonnet"} if a.showcase in ("screenshot", "link") else {})}),
                           key, now(), now()))
                c.execute("UPDATE milestones SET showcase_ticket=? WHERE key=?", (tk, key))
                event(c, "created", tk, proj, body=f"Showcase: {a.title}")
            event(c, "milestone", project=proj, body=f"{key} created: {a.title} (trigger {a.trigger}, showcase {a.showcase})")
            refresh_milestones(c, proj)
        out(a, {"key": key}, key)
        return
    if act == "ls":
        proj = project_row(c, a.target)["key"]
        rows = c.execute("SELECT * FROM milestones WHERE project=? ORDER BY seq, id", (proj,)).fetchall()
        res = []
        for m in rows:
            w = ms_work(c, m)
            res.append({**rowd(m), "showcases": json.loads(m["showcases"]), "tickets": [x["key"] for x in w],
                        "done": sum(1 for x in w if x["state"] == "done")})
        out(a, res, "\n".join(f"{m['key']:16} {m['status']:9} {m['trigger']:7} {r['done']}/{len(r['tickets'])} "
                               f"{m['title']}{'  due ' + m['due'] if m['due'] else ''}{'  showcase: ' + str(len(r['showcases'])) if r['showcases'] else ''}"
                               for m, r in zip(rows, res)) or "(no milestones)")
        return
    m = milestone(c, a.target)
    if act == "show":
        w = ms_work(c, m)
        d = {**rowd(m), "showcases": json.loads(m["showcases"]), "tickets": [dict(x) for x in w]}
        lines = [f"{m['key']}  {m['title']}  [{m['status']}]", f"trigger={m['trigger']} gate={m['gate']} showcase={m['showcase_kind']} "
                 f"ticket={m['showcase_ticket']} due={m['due']} reached={m['reached']}", "", m["body"] or "", ""]
        lines += [f"  {x['key']:16} {x['state']:11} {x['title']}" for x in w]
        for sc in json.loads(m["showcases"]):
            lines.append(f"  showcase [{sc.get('kind')}] {sc.get('url') or sc.get('file') or ''} {sc.get('note', '')[:120]}")
        out(a, d, "\n".join(lines)); return
    with tx(c):
        if act == "showcase":
            entry = {"kind": a.kind or m["showcase_kind"], "at": now(), "by": agent_id()}
            if a.note: entry["note"] = a.note
            if a.url: entry["url"] = a.url
            if a.file:
                src = Path(a.file).expanduser()
                if not src.is_file():
                    die(f"no file {src}")
                dst_dir = SHOWCASE_DIR / m["key"]
                dst_dir.mkdir(parents=True, exist_ok=True)
                dst = dst_dir / f"{int(time.time())}-{src.name}"
                dst.write_bytes(src.read_bytes())
                entry["file"] = str(dst.relative_to(SHOWCASE_DIR))
            if len(entry) <= 3:
                die("give at least one of --file, --url, --note")
            shows = json.loads(m["showcases"]) + [entry]
            c.execute("UPDATE milestones SET showcases=?, updated=? WHERE key=?", (json.dumps(shows), now(), m["key"]))
            event(c, "milestone", project=m["project"], body=f"{m['key']} showcase added ({entry['kind']})", data=entry)
        elif act == "reach":
            c.execute("UPDATE milestones SET reached=coalesce(reached, ?), updated=? WHERE key=?", (now(), now(), m["key"]))
            if m["trigger"] != "manual":
                c.execute("UPDATE milestones SET trigger='manual' WHERE key=?", (m["key"],))
        elif act == "cancel":
            c.execute("UPDATE milestones SET status='canceled', updated=? WHERE key=?", (now(), m["key"]))
            event(c, "milestone", project=m["project"], body=f"{m['key']} canceled")
        elif act == "accept":
            c.execute("UPDATE milestones SET status='accepted', updated=? WHERE key=?", (now(), m["key"]))
            event(c, "milestone", project=m["project"], body=f"{m['key']} accepted" + (f": {a.note}" if a.note else ""))
        elif act == "reopen":
            c.execute("UPDATE milestones SET status='active', updated=? WHERE key=?", (now(), m["key"]))
            event(c, "milestone", project=m["project"], body=f"{m['key']} reopened" + (f": {a.note}" if a.note else ""))
        elif act == "set":
            fields = ([a.title] if a.title else []) + a.fields   # `title` is positional for `add`
            if not fields or any("=" not in f for f in fields):
                die("usage: bl milestone set KEY field=value ...")
            a.fields = fields
            for kv in fields:
                k, v = kv.split("=", 1)
                if k not in ("title", "body", "trigger", "gate", "due", "seq", "showcase_kind"):
                    die(f"unknown milestone field {k}")
                c.execute(f"UPDATE milestones SET {k}=?, updated=? WHERE key=?", (v if v != "" else None, now(), m["key"]))
            event(c, "milestone", project=m["project"], body=f"{m['key']} " + " ".join(a.fields))
        refresh_milestones(c, m["project"])
    print("ok")


# ---------------------------------------------------------------- workers (shared by bl run and the daemon)
def previous_session(c, t, cwd):
    """The Claude session of this ticket's last interrupted attempt, to resume instead of starting over: the
    session that wrote events for the previous claim (not one that finished the ticket), whose transcript still
    exists for this worktree. Returns (session_id, why it stopped) or (None, None)."""
    claims = c.execute("SELECT id, actor FROM events WHERE ticket=? AND kind='claim' ORDER BY id DESC LIMIT 2", (t["key"],)).fetchall()
    if len(claims) < 2:
        return None, None
    prev, cur = claims[1], claims[0]
    r = c.execute("SELECT session_id FROM events WHERE ticket=? AND actor=? AND session_id IS NOT NULL AND id>? AND id<? "
                  "ORDER BY id DESC LIMIT 1", (t["key"], prev["actor"], prev["id"], cur["id"])).fetchone()
    if not r:
        return None, None
    why = c.execute("SELECT body FROM events WHERE ticket=? AND kind='state' AND id>? AND id<? ORDER BY id DESC LIMIT 1",
                    (t["key"], prev["id"], cur["id"])).fetchone()
    why = why["body"] if why else "interrupted"
    if "→ done" in why or "→ canceled" in why:
        return None, None
    slug = re.sub(r"[^A-Za-z0-9]", "-", str(Path(cwd).resolve()))
    if not (Path.home() / ".claude" / "projects" / slug / f"{r['session_id']}.jsonl").exists():
        return None, None
    return r["session_id"], why

def resume_prompt(t, why):
    k, p = t["key"], t["project"]
    if why.startswith("in_progress → todo: parked") or "parked:" in why:
        return (f"You are resuming backlog ticket {k} in project {p}: you parked it with your PR ready ({why[:200]}), and what "
                f"it waited for has happened. Now: `git fetch`, rebase your branch onto origin/main (your blockers are merged), "
                f"resolve any conflicts, run your scoped tests again (health, lint, your unit files, your e2e suites, smoke), push, "
                f"merge the PR, and finish with bl done (or bl fail if it no longer works).")
    return (f"You are resuming backlog ticket {k} in project {p} after an interruption ({why[:200]}). Your earlier work "
            f"in this session and in this worktree is still here. You hold the ticket again. Before continuing: run "
            f"`git status` and `git log --oneline -5` to see where you stopped, `bl show {k}` for new notes, and "
            f"`bl area {p}` and `bl main` for what changed meanwhile (other merges, main health). Then carry on from where "
            f"you stopped (don't redo finished steps) and finish with exactly one of bl done, bl fail or bl release.")

def spawn_worker(c, t, ag, actor):
    """Start worker_cmd for a claimed ticket. Returns (Popen, logfile) or None (ticket released)."""
    try:
        cwd = worktree_for(c, t)
    except SystemExit:
        with tx(c):
            release_ticket(c, ticket(c, t["key"]), "could not create worktree", count_failure=True, actor=actor)
        return None
    LOGS.mkdir(parents=True, exist_ok=True)
    lf = open(LOGS / f"{t['key']}.{t['attempts']}.log", "w")
    model = model_for(c, t)
    harness = harness_for(c, t)
    try:
        env = worker_env()
        env.update({"BL_TICKET": t["key"], "BL_AGENT": ag, "BL_DB": str(DB), "BL_MODEL": str(model or ""),
                    "BL_HARNESS": harness, "PATH": f"{Path(__file__).resolve().parent}:{os.environ.get('PATH', '')}"})
        scopes = [f"label:{x}" for x in json.loads(t["labels"])] + [f"project:{t['project']}", "global"]
        custom = next((r for scope in scopes if (r := c.execute(
            "SELECT value FROM settings WHERE scope=? AND key='worker_cmd'", (scope,)).fetchone())), None)
        sid, why = (None, None) if custom or harness != "claude" else previous_session(c, t, cwd)
        if sid:
            cmd = worker_command(c, t, model, resume_prompt(t, why))
            cmd[1:1] = ["--resume", sid]      # claude --resume <sid> -p <prompt> …
        else:
            cmd = json.loads(custom["value"]) if custom else worker_command(c, t, model, build_prompt(c, t))
        pr = subprocess.Popen(cmd, shell=isinstance(cmd, str), cwd=cwd, env=env, stdout=lf,
                              stderr=subprocess.STDOUT, start_new_session=True)
    except (ValueError, OSError) as e:
        lf.write(f"bl: worker could not start: {e}\n"); lf.close()
        with tx(c):
            release_ticket(c, ticket(c, t["key"]), f"worker could not start: {e}", count_failure=True, actor=actor)
        return None
    with tx(c):
        event(c, "spawn", t["key"], body=f"{harness} worker {'resumed session ' + sid[:8] if sid else 'started'} in {cwd} (model {model or 'default'})",
              actor=ag, data={"cwd": cwd, "log": lf.name, "pid": pr.pid, "model": model, "harness": harness, "resumed": sid})
    return pr, lf

def collect_children(c, children, actor, project=None):
    """Handle finished / timed-out workers. children: key -> (Popen, agent, t0, logfile)."""
    for k, (pr, ag, t0, lf) in list(children.items()):
        t = ticket(c, k)
        if pr.poll() is not None:
            del children[k]; lf.close()
            if t["state"] == "in_progress" and t["claimed_by"] == ag:
                tail = log_tail(lf.name)
                hit, _ = detect_quota(tail)
                with tx(c):
                    if hit:
                        until = note_quota(c, k, tail, actor)
                        new = release_ticket(c, ticket(c, k), f"usage limit; retry after {until}", count_failure=False, actor=actor)
                    else:
                        new = release_ticket(c, ticket(c, k), f"worker exited ({pr.returncode}) without reporting",
                                             count_failure=True, actor=actor)
                notify(c, t["project"], f"{k}: usage limit hit, paused until {until}; ticket back to {new}" if hit
                       else f"{k} worker exited without reporting → {new}")
            else:
                notify(c, t["project"], f"{k} → {t['state']}: {(t['result'] or '')[:200]}")
        elif time.monotonic() - t0 > 60 * setting(c, "worker_timeout_minutes", t["project"]):
            try: os.killpg(pr.pid, signal.SIGTERM)
            except Exception: pr.terminate()
            notify(c, t["project"], f"{k} timed out; terminated")

def beat_children(c, children):
    with tx(c):
        for k, (pr, ag, *_r) in children.items():
            t = ticket(c, k)
            c.execute("UPDATE tickets SET lease_until=? WHERE key=? AND claimed_by=?",
                      (later(setting(c, "lease_minutes", t["project"])), k, ag))

def stop_children(c, children, actor, reason):
    for k, (pr, ag, t0, lf) in children.items():
        try: os.killpg(pr.pid, signal.SIGTERM)
        except Exception: pass
        with tx(c):
            t = ticket(c, k)
            if t["state"] == "in_progress" and t["claimed_by"] == ag:
                release_ticket(c, t, reason, actor=actor)


# ---------------------------------------------------------------- orchestrator
def notify(c, project, msg):
    print(f"[{now()}] {msg}", flush=True)
    cmd = setting(c, "notify_cmd", project)
    if cmd:
        subprocess.Popen(cmd, shell=True, env={**os.environ, "BL_MSG": msg, "BL_PROJECT": project or ""})

def cmd_run(a):
    c = connect()
    proj = project_row(c, a.project)["key"]
    if a.parallel:
        with tx(c):
            c.execute("INSERT OR REPLACE INTO settings VALUES(?,?,?)", (f"project:{proj}", "max_parallel", json.dumps(a.parallel)))
    if a.dry_run:
        waves, by = levels(c, proj)
        print(f"{proj}: max_parallel={project_cap(c, proj) or 'unlimited'} global={setting(c, 'global_max_parallel')} "
              f"review={setting(c, 'review', proj)} model={setting(c, 'model', proj)}")
        for i, w in enumerate(waves):
            runnable = [k for k in w if by[k]["state"] == "todo" and by[k]["assignee"] in (None, "")]
            gated = [k for k in w if k not in runnable]
            tag = lambda k: f"{k}:human" if by[k]["assignee"] == "human" else f"{k}:{by[k]['state']}"
            print(f"wave {i + 1}: {' '.join(runnable)}" + (f"   (not auto-run: {' '.join(tag(k) for k in gated)})" if gated else ""))
        return
    pr_ = project_row(c, proj)
    if pr_["executor"] == "daemon" and not a.force:
        die(f"{proj} is run by the daemon. Pause it or `bl project set {proj} executor=session` to run it here.")
    if pr_["status"] != "executing" and not a.force:
        die(f"{proj} is {pr_['status']}. Start it first: bl project start {proj}")
    LOGS.mkdir(parents=True, exist_ok=True)
    me = f"orch:{proj}:{os.getpid()}"
    launcher = session_id()
    os.environ["BL_IN_ORCH"] = "1"
    os.environ["BL_OWNER"] = me
    with tx(c):
        run_id = c.execute("INSERT INTO runs(project,pid,host,agent,started,heartbeat,status,kind) VALUES(?,?,?,?,?,?, 'running','orchestrator') RETURNING id",
                           (proj, os.getpid(), socket.gethostname(), me, now(), now())).fetchone()[0]
        c.execute("UPDATE projects SET owner=?, owner_heartbeat=? WHERE key=?", (me, now(), proj))
        event(c, "run", project=proj, body=f"run {run_id} started (pid {os.getpid()})", actor=me,
              data={"launcher_session": launcher})
    children = {}   # key -> (Popen, agent, started_monotonic, logfile)
    stopping = {"flag": False}

    def stop(*_):
        stopping["flag"] = True
    signal.signal(signal.SIGINT, stop); signal.signal(signal.SIGTERM, stop)
    stuck_reported = None
    status = "done"
    try:
        while not stopping["flag"]:
            with tx(c):
                reap(c)
            collect_children(c, children, me, proj)
            # spawn
            while len(children) < (project_cap(c, proj) or setting(c, "global_max_parallel")):
                ag = f"{me}:{len(children)}:{int(time.time()) % 100000}"
                t, why = claim(c, proj, agent=ag)
                if not t:
                    break
                got = spawn_worker(c, t, ag, me)
                if not got:
                    continue
                children[t["key"]] = (got[0], ag, time.monotonic(), got[1])
                notify(c, proj, f"{t['key']} started ({t['title']}), log {got[1].name}")
            beat_children(c, children)
            with tx(c):
                c.execute("UPDATE runs SET heartbeat=? WHERE id=?", (now(), run_id))
                c.execute("UPDATE projects SET owner=?, owner_heartbeat=? WHERE key=?", (me, now(), proj))
            # termination / stuck
            active = c.execute(f"SELECT key,state,assignee,title FROM tickets WHERE project=? AND state IN ({','.join('?' * len(ACTIVE))})",
                               (proj, *ACTIVE)).fetchall()
            if not active and not children:
                with tx(c):
                    finalize_projects(c)
                if a.until == "done":
                    notify(c, proj, f"{proj}: all tickets final. Done."); status = "done"; break
            elif not children and not ready(c, proj, me):
                sig = tuple(sorted((r["key"], r["state"]) for r in active))
                if sig != stuck_reported:
                    stuck_reported = sig
                    det = "; ".join(f"{r['key']} {r['state']}{' (human)' if r['assignee'] == 'human' else ''}" for r in active)
                    gcap = c.execute("SELECT count(*) FROM tickets WHERE state='in_progress'").fetchone()[0] >= setting(c, "global_max_parallel")
                    notify(c, proj, f"{proj} waiting: {'global cap reached by other projects; ' if gcap else ''}{det}")
                    if setting(c, "on_stuck", proj) == "exit" and not gcap:
                        status = "stuck"; break
            else:
                stuck_reported = None
            time.sleep(setting(c, "poll_seconds", proj))
        else:
            status = "stopped"
    finally:
        stop_children(c, children, me, "orchestrator stopped")
        with tx(c):
            c.execute("UPDATE runs SET ended=?, status=? WHERE id=?", (now(), status, run_id))
            c.execute("UPDATE projects SET owner=NULL WHERE key=? AND owner=?", (proj, me))
            event(c, "run", project=proj, body=f"run {run_id} {status}", actor=me)
    sys.exit(0 if status == "done" else 2)


# ---------------------------------------------------------------- daemon
DAEMON_LABEL = "com.chito.backlog-daemon"
PLIST = Path.home() / "Library" / "LaunchAgents" / f"{DAEMON_LABEL}.plist"
DLOGS = Path.home() / "Library" / "Logs" / "backlog"

def cmd_daemon(a):
    c = connect()
    if a.action == "status":
        d = daemon_info(c)
        rows = c.execute("SELECT key,title,claimed_by,started,meta FROM tickets WHERE state='in_progress' ORDER BY started").fetchall()
        if a.json:
            print(json.dumps({**d, "in_progress": [dict(r) for r in rows]}, indent=1)); return
        print(f"daemon {'running pid ' + str(d['pid']) if d['alive'] else 'NOT running'}"
              f"{'' if d['enabled'] else ' · PAUSED'} · heartbeat {d['heartbeat']} · {d['workers']} workers · "
              f"{d['runs_today']}/{setting(c, 'daemon_max_runs_per_day')} runs today · in flight {d['in_flight']}/{setting(c, 'global_max_parallel')}")
        for r in rows:
            print(f"  {r['key']:20} {r['claimed_by'] or '(by hand, no claim)':34} since {r['started']}  {r['title'][:60]}")
        return
    if a.action in ("pause", "resume"):
        with tx(c):
            c.execute("INSERT OR REPLACE INTO settings VALUES('global','daemon_enabled',?)", (json.dumps(a.action == "resume"),))
            event(c, "daemon", body=a.action)
        print("daemon " + ("resumed" if a.action == "resume" else "paused (running workers finish; nothing new starts)")); return
    if a.action == "install":
        DLOGS.mkdir(parents=True, exist_ok=True)
        path = ":".join([str(Path.home() / ".local" / "bin"), "/opt/homebrew/bin", "/usr/local/bin", "/usr/bin", "/bin", "/usr/sbin", "/sbin"])
        PLIST.write_text(f"""<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>{DAEMON_LABEL}</string>
  <key>ProgramArguments</key><array><string>{sys.executable}</string><string>{Path(__file__).resolve()}</string><string>daemon</string><string>run</string></array>
  <key>WorkingDirectory</key><string>{HOME}</string>
  <key>EnvironmentVariables</key><dict>
    <key>PATH</key><string>{path}</string><key>HOME</key><string>{Path.home()}</string><key>BL_DB</key><string>{DB}</string>
  </dict>
  <key>RunAtLoad</key><true/><key>KeepAlive</key><true/><key>ThrottleInterval</key><integer>15</integer>
  <key>StandardOutPath</key><string>{DLOGS}/daemon.log</string><key>StandardErrorPath</key><string>{DLOGS}/daemon.err.log</string>
</dict></plist>
""")
        uid = os.getuid()
        subprocess.run(["launchctl", "bootout", f"gui/{uid}/{DAEMON_LABEL}"], capture_output=True)
        r = subprocess.run(["launchctl", "bootstrap", f"gui/{uid}", str(PLIST)], capture_output=True, text=True)
        print(f"installed {PLIST}" + (f" (bootstrap: {r.stderr.strip()})" if r.returncode else "; running")); return
    if a.action == "uninstall":
        subprocess.run(["launchctl", "bootout", f"gui/{os.getuid()}/{DAEMON_LABEL}"], capture_output=True)
        if PLIST.exists(): PLIST.unlink()
        print("uninstalled"); return
    # ---- run
    import fcntl
    lock = open(HOME / "daemon.lock", "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        die("another daemon is already running", 0)
    me = f"daemon:{os.getpid()}"
    os.environ["BL_IN_ORCH"] = "1"
    os.environ["BL_DAEMON"] = "1"
    os.environ.pop("BL_OWNER", None)
    with tx(c):
        run_id = c.execute("INSERT INTO runs(project,pid,host,agent,started,heartbeat,status,kind) VALUES(NULL,?,?,?,?,?,'running','daemon') RETURNING id",
                           (os.getpid(), socket.gethostname(), me, now(), now())).fetchone()[0]
        event(c, "daemon", body=f"daemon started (pid {os.getpid()})", actor=me)
    print(f"[{now()}] {me} started; db {DB}", flush=True)
    children = adopt_workers(c, me)
    orchs = {}   # project -> (Popen, agent, t0, logfile) for orchestrator sessions
    briefs = {}  # ticket -> (Popen, agent, t0, logfile) for briefing sessions
    tldrs = {}   # ticket -> (Popen, t0, outfile, ticket.updated) writing a TL;DR
    wraps = {}   # project -> (Popen, t0) writing a wrap-up report
    with tx(c):
        for t in c.execute("SELECT key, meta FROM tickets WHERE meta LIKE '%\"pending\": true%'").fetchall():
            m = json.loads(t["meta"]); m.pop("brief", None)
            c.execute("UPDATE tickets SET meta=? WHERE key=?", (json.dumps(m), t["key"]))
    stopping = {"flag": False}
    def stop(*_): stopping["flag"] = True
    signal.signal(signal.SIGINT, stop); signal.signal(signal.SIGTERM, stop)
    seq = max([int(v[1].rsplit(":", 1)[1]) for v in children.values() if v[1].startswith(me + ":")] or [0])
    last_why = None
    paused_seen = quota_until(c)
    probe = None          # after a usage-limit pause: {"key": ticket, "t0": monotonic} until one worker proves the limit reset
    try:
        while not stopping["flag"]:
            with tx(c):
                reap(c)
                finalize_projects(c)
            q = quota_until(c)
            if q and q != paused_seen:
                paused_seen = q; probe = None
                notify(c, None, f"usage limit: all claims paused until {q}; the daemon resumes on its own")
            elif not q and paused_seen:
                paused_seen = None; probe = {"key": None, "t0": None}
                with tx(c):
                    event(c, "quota", body="pause over; probing with one worker", actor=me)
                notify(c, None, "usage-limit pause over; trying one worker before resuming fully")
            collect_children(c, children, me)
            if not DRAIN["draining"] and source_changed():
                DRAIN["draining"] = True
                with tx(c):
                    event(c, "daemon", body="bl changed on disk: reloading (workers are re-adopted; waiting only for orchestrators, briefings, TL;DR jobs)", actor=me)
                print(f"[{now()}] bl changed on disk: reloading", flush=True)
            if DRAIN["draining"] and not (orchs or briefs or tldrs):
                with tx(c):
                    c.execute("UPDATE runs SET ended=?, status='reloaded' WHERE id=?", (now(), run_id))
                    event(c, "daemon", body="daemon reloading with the new bl", actor=me)
                print(f"[{now()}] reloading", flush=True)
                c.close()
                os.execv(sys.executable, [sys.executable, str(SELF), *sys.argv[1:]])
            if probe is not None:
                k = probe["key"]
                if k and (k not in children or time.monotonic() - probe["t0"] > 90) and not quota_until(c):
                    t = ticket(c, k)
                    if k in children or t["state"] != "todo":
                        probe = None
                        with tx(c):
                            event(c, "quota", body="resumed: the probe worker got through", actor=me)
                        notify(c, None, "usage limit reset confirmed; resuming at full capacity")
                    else:
                        probe["key"] = None   # it was released for another reason; probe again
            # fill slots, round-robin across projects: the project with the fewest of our workers goes first
            cap = setting(c, "daemon_max_parallel")
            if probe is not None:
                cap = len(children) + (0 if probe["key"] else 1)   # one canary at a time until the limit is known to be reset
            while spawning(c, workers=True) and len(children) < cap:
                cands = ready(c, None, me, None, "daemon")
                if not cands:
                    break
                mine = {}
                for k in children:
                    pk = ticket(c, k)["project"]; mine[pk] = mine.get(pk, 0) + 1
                cands = sorted(cands, key=lambda t: (mine.get(t["project"], 0), t["priority"], t["id"]))
                seq += 1
                ag = f"{me}:{seq}"
                t, why = claim(c, cands[0]["project"], cands[0]["key"], agent=ag, mode="daemon")
                if not t:
                    if why != last_why:
                        print(f"[{now()}] not claiming: {why}", flush=True); last_why = why
                    break
                last_why = None
                got = spawn_worker(c, t, ag, me)
                if got:
                    children[t["key"]] = (got[0], ag, time.monotonic(), got[1])
                    if probe is not None and not probe["key"]:
                        probe.update(key=t["key"], t0=time.monotonic())
                    notify(c, t["project"], f"daemon started {t['key']} ({t['title']}) model {model_for(c, t)}" +
                           (" as the usage-limit probe" if probe is not None and probe["key"] == t["key"] else "") + f", log {got[1].name}")
            auto_projects(c, children, orchs, me, lambda: probe is not None)
            if probe is None:
                brief_humans(c, briefs, me)
                tldr_backfill(c, tldrs)
                wrapup_reports(c, wraps, me)
            beat_children(c, children)
            with tx(c):
                for pk, (pr, ag, t0, lf) in orchs.items():
                    c.execute("UPDATE projects SET owner_heartbeat=? WHERE key=? AND owner=?", (now(), pk, ag))
                    c.execute("UPDATE tickets SET lease_until=? WHERE state='in_progress' AND claimed_by=?",
                              (later(setting(c, "lease_minutes")), ag))
                c.execute("UPDATE runs SET heartbeat=? WHERE id=?", (now(), run_id))
            time.sleep(setting(c, "poll_seconds"))
    finally:
        stop_children(c, children, me, "daemon stopped")
        for pk, (pr, ag, t0, lf) in orchs.items():
            try: os.killpg(pr.pid, signal.SIGTERM)
            except Exception: pass
            with tx(c):
                for t in c.execute("SELECT * FROM tickets WHERE state='in_progress' AND claimed_by=?", (ag,)).fetchall():
                    release_ticket(c, t, "daemon stopped", actor=me)
                c.execute("UPDATE projects SET owner=NULL WHERE key=? AND owner=?", (pk, ag))
        with tx(c):
            c.execute("UPDATE runs SET ended=?, status='stopped' WHERE id=?", (now(), run_id))
            event(c, "daemon", body="daemon stopped", actor=me)


def project_has_live_owner(c, p):
    if c.execute("SELECT 1 FROM runs WHERE project=? AND status='running' AND kind='orchestrator'", (p["key"],)).fetchone():
        return True
    if not p["owner"]:
        return False
    hb = p["owner_heartbeat"] or ""
    return hb > (datetime.now(timezone.utc) - timedelta(minutes=setting(c, "lease_minutes"))).strftime("%Y-%m-%dT%H:%M:%SZ")

def human_ready(c):
    return c.execute("""SELECT t.* FROM tickets t JOIN projects p ON p.key=t.project
        WHERE t.state='todo' AND t.assignee='human' AND p.status='executing'
          AND NOT EXISTS (SELECT 1 FROM deps d JOIN tickets b ON b.key=d.blocker
                          WHERE d.ticket=t.key AND b.state NOT IN ('done','canceled'))
        ORDER BY t.priority, t.id""").fetchall()

# Self-reload: when bl changes on disk (a merge), the daemon stops starting new work, lets every worker, orchestrator,
# briefing and TL;DR job it started finish, then re-executes itself, so new prompt and protocol code takes effect
# without killing running workers (a plain restart terminates its children).
SELF = Path(__file__).resolve()
def _mtime():
    try:
        return SELF.stat().st_mtime
    except OSError:
        return None
DRAIN = {"mtime": _mtime(), "draining": False}   # the code this process loaded

def source_changed():
    m = _mtime()
    return m is not None and DRAIN["mtime"] is not None and m != DRAIN["mtime"]

def spawning(c, workers=False):
    """Workers keep starting while a reload waits (they are re-adopted after it); orchestrators, briefings and
    TL;DR jobs (not adoptable) don't."""
    return bool(setting(c, "daemon_enabled")) and (workers or not DRAIN["draining"])

class Adopted:
    """A worker started by an earlier daemon process (before a reload, or a crash): polled by pid."""
    def __init__(self, pid):
        self.pid, self.returncode = pid, None
    def poll(self):
        if self.returncode is not None:
            return self.returncode
        try:
            got, st = os.waitpid(self.pid, os.WNOHANG)   # still our child after an exec
            if got == 0:
                return None
            self.returncode = os.waitstatus_to_exitcode(st)
        except ChildProcessError:                        # reparented (the old daemon was killed): poll by pid
            if alive(self.pid):
                return None
            self.returncode = -1
        return self.returncode
    def terminate(self):
        try: os.kill(self.pid, signal.SIGTERM)
        except ProcessLookupError: pass

def adopt_workers(c, me):
    """Take over the live workers of this pid before an exec, or of a daemon that died, so a reload never
    stops or drains them. Returns the children dict."""
    children = {}
    for t in c.execute("SELECT * FROM tickets WHERE state='in_progress' AND claimed_by LIKE 'daemon:%'").fetchall():
        parts = t["claimed_by"].split(":")
        if len(parts) != 3 or not parts[1].isdigit():
            continue
        owner = int(parts[1])
        if owner != os.getpid() and alive(owner):
            continue                                     # another live daemon's worker
        e = c.execute("SELECT data, at FROM events WHERE ticket=? AND kind='spawn' ORDER BY id DESC LIMIT 1", (t["key"],)).fetchone()
        d = json.loads(e["data"]) if e else {}
        pid = d.get("pid")
        if not pid or not alive(int(pid)):
            continue                                     # gone: its lease lapses and the reaper hands it back
        try:
            age = (datetime.now(timezone.utc) - datetime.strptime(e["at"], "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=timezone.utc)).total_seconds()
        except (ValueError, TypeError):
            age = 0
        lf = open(d["log"], "a") if d.get("log") else open(os.devnull, "a")
        children[t["key"]] = (Adopted(int(pid)), t["claimed_by"], time.monotonic() - age, lf)
    if children:
        with tx(c):
            event(c, "daemon", body=f"adopted {len(children)} running workers: {', '.join(children)}", actor=me)
    return children

def brief_humans(c, briefs, me):
    """For every unblocked human ticket without one, start a briefing session: context, how to see it, the questions."""
    for k, (pr, ag, t0, lf) in list(briefs.items()):
        if pr.poll() is None:
            if time.monotonic() - t0 > 60 * 30:
                try: os.killpg(pr.pid, signal.SIGTERM)
                except Exception: pr.terminate()
            continue
        del briefs[k]; lf.close()
        tail = log_tail(lf.name)
        hit, _ = detect_quota(tail)
        with tx(c):
            t = ticket(c, k)
            meta = json.loads(t["meta"])
            sid = c.execute("SELECT session_id FROM events WHERE ticket=? AND actor=? AND session_id IS NOT NULL ORDER BY id DESC LIMIT 1",
                            (k, ag)).fetchone()
            if hit:
                note_quota(c, k, tail, me)
                meta.pop("brief", None)                       # try again after the pause
            elif sid:
                meta["brief"] = {"session": sid["session_id"], "at": now(), "log": lf.name}
                h = meta.get("handoff") or {}
                h["session"] = h.get("session") or sid["session_id"]
                if h.get("phase") == "preparing":   # the session never recorded a packet: hand over the chat anyway
                    h["phase"] = "awaiting"; h["ready_at"] = now()
                    meta["handoff"] = h
                    c.execute("UPDATE tickets SET meta=? WHERE key=?", (json.dumps(meta), k))
                    notify_human(c, t, "A briefing is ready (no packet; read the session)")
                meta["handoff"] = h
                event(c, "brief", k, body="briefing ready: resume its session to answer", actor=ag,
                      data={"session": sid["session_id"]})
            else:
                meta["brief"] = {"error": f"briefing exited ({pr.returncode}) without recording a session", "at": now(), "log": lf.name}
            c.execute("UPDATE tickets SET meta=? WHERE key=?", (json.dumps(meta), k))
        notify(c, t["project"], f"{k}: " + ("briefing ready; it needs you" if sid and not hit else "briefing did not finish"))
    if not setting(c, "brief_humans") or not spawning(c) or quota_until(c):
        return
    for t in human_ready(c):
        meta = json.loads(t["meta"])
        if t["key"] in briefs or meta.get("brief") or (meta.get("handoff") or {}).get("packet"):
            continue
        if len(briefs) >= 2:
            return
        p = project_row(c, t["project"])
        ag = f"brief:{t['key']}"
        cwd = p["repo"] if p["repo"] and Path(p["repo"]).exists() else str(HOME)
        LOGS.mkdir(parents=True, exist_ok=True)
        lf = open(LOGS / f"brief-{t['key']}-{int(time.time())}.log", "w")
        env = {k: v for k, v in os.environ.items() if k not in ("BL_IN_ORCH", "CLAUDE_CODE_SESSION_ID", "BL_TICKET", "BL_DAEMON", "BL_OWNER", "BL_ORCH_PROJECT")}
        env.update({"BL_AGENT": ag, "BL_DB": str(DB), "PATH": f"{Path(__file__).resolve().parent}:{os.environ.get('PATH', '')}"})
        model = str(setting(c, "brief_model", p["key"]))
        pr = subprocess.Popen(["claude", "-p", brief_prompt(c, t), "--model", model, "--permission-mode", "bypassPermissions",
                               "--append-system-prompt", f"You are preparing backlog ticket {t['key']} for the human: brief them and ask; don't decide for them."],
                              cwd=cwd, env=env, stdout=lf, stderr=subprocess.STDOUT, start_new_session=True)
        briefs[t["key"]] = (pr, ag, time.monotonic(), lf)
        with tx(c):
            meta["brief"] = {"pending": True, "at": now(), "log": lf.name}
            meta["handoff"] = {**(meta.get("handoff") or {}), "phase": "preparing", "updated": now()}
            c.execute("UPDATE tickets SET meta=? WHERE key=?", (json.dumps(meta), t["key"]))
            event(c, "brief", t["key"], body="preparing a briefing session for the human", actor=ag, data={"pid": pr.pid, "log": lf.name})
        notify(c, t["project"], f"{t['key']}: preparing a briefing for you ({t['title']})")

def waiting_without_tldr(c):
    """Tickets on the human's plate with no TL;DR yet (and no failed attempt at one for this result)."""
    rows = c.execute("""SELECT * FROM tickets WHERE state IN ('failed','in_review')
                        OR (assignee='human' AND state NOT IN ('done','canceled'))""").fetchall()
    out = []
    for t in rows:
        meta = json.loads(t["meta"])
        pk = (meta.get("handoff") or {}).get("packet")
        tr_ = meta.get("tldr_try") or {}
        if meta.get("tldr") or (tr_.get("updated") == t["updated"] and tr_.get("tries", 1) >= 2):
            continue
        if t["result"] or pk:
            out.append((t, pk))
    return out

def tldr_prompt(t, pk):
    tr_ = json.loads(t["meta"]).get("tldr_try") or {}
    retry = (f"\n\nYour last TL;DR for this was rejected ({tr_['error']}). Write a shorter one."
             if tr_.get("updated") == t["updated"] and tr_.get("error") else "")
    src = []
    if pk:
        src += [f"Handoff summary: {pk.get('summary', '')}", f"Handoff body:\n{pk.get('body', '')}"]
        asks = [a.get("q") if isinstance(a, dict) else str(a) for a in pk.get("asks") or []]
        if asks: src.append("Asked of the human:\n" + "\n".join("- " + q for q in asks if q))
    if t["result"]:
        src.append(f"Result:\n{t['result']}")
    why = {"failed": "it failed and the human decides: retry, fix the spec or cancel",
           "in_review": "it is in review and the human approves it"}.get(t["state"], "only the human can do it")
    return (f"Backlog ticket {t['key']}: {t['title']}. It is waiting on the human because {why}.\n\n"
            + "\n\n".join(src)[:8000] +
            f"\n\nWrite the TL;DR the human reads on the board: {TLDR_RULE} "
            "Plain words, no headings, no preamble, no quotes around it. Reply with the TL;DR only." + retry)

def tldr_backfill(c, jobs):
    """Write a TL;DR (with a small model) for each waiting ticket that has none."""
    for k, (pr, t0, out, upd) in list(jobs.items()):
        if pr.poll() is None:
            if time.monotonic() - t0 > 180:
                pr.kill()
            continue
        del jobs[k]
        text = Path(out).read_text(errors="replace").strip() if Path(out).exists() else ""
        text = re.sub(r"^(TL;?DR:?\s*)", "", text, flags=re.I).strip().strip('"')
        with tx(c):
            t = ticket(c, k)
            meta = json.loads(t["meta"])
            if pr.returncode == 0 and text and not tldr_problem(text) and not meta.get("tldr") and t["updated"] == upd:
                meta["tldr"] = {"text": text, "at": now(), "by": "daemon"}
                meta.pop("tldr_try", None)
            elif not meta.get("tldr"):
                prev = meta.get("tldr_try") or {}
                tries = prev.get("tries", 1) + 1 if prev.get("updated") == upd else 1
                meta["tldr_try"] = {"at": now(), "updated": upd, "tries": tries, "error": tldr_problem(text) or f"exit {pr.returncode}"}
            c.execute("UPDATE tickets SET meta=? WHERE key=?", (json.dumps(meta), k))
    if jobs or not setting(c, "tldr_backfill") or not spawning(c) or quota_until(c):
        return
    for t, pk in waiting_without_tldr(c)[:1]:
        LOGS.mkdir(parents=True, exist_ok=True)
        out = LOGS / f"tldr-{t['key']}.txt"
        env = {k: v for k, v in os.environ.items() if not k.startswith("BL_") and k != "CLAUDE_CODE_SESSION_ID"}
        try:
            with open(out, "w") as f:
                pr = subprocess.Popen(["claude", "-p", tldr_prompt(t, pk), "--model", str(setting(c, "tldr_model"))],
                                      cwd=str(Path.home()), env=env, stdout=f, stderr=subprocess.DEVNULL, start_new_session=True)
        except OSError as e:   # no claude on PATH: note it once per result, keep the daemon alive
            with tx(c):
                meta = json.loads(ticket(c, t["key"])["meta"])
                meta["tldr_try"] = {"at": now(), "updated": t["updated"], "error": str(e)[:200]}
                c.execute("UPDATE tickets SET meta=? WHERE key=?", (json.dumps(meta), t["key"]))
            return
        jobs[t["key"]] = (pr, time.monotonic(), str(out), t["updated"])

# ---------------------------------------------------------------- project wrap-up report
# When a project finishes (status done, or nothing runnable left: every ticket final, or only parked backlog and
# human tickets remain), the daemon runs ONE small `claude -p --model sonnet` session that turns what bl collected
# (tickets, results, PRs, memory, milestones, links, deploy state, leftovers) into a one-screen Markdown report.
# Stored in projects.meta.report; chito shows it on the project page and in "Recently finished". A finish is
# identified by its signature (ticket count + the last finish time), so adding tickets and finishing again regenerates it.
WRAPUP_SECTIONS = ["TL;DR", "Before → After", "What shipped", "Key artifacts", "Decisions and dropped work", "Left over", "Live?"]
ARTI_URL = re.compile(r"https://arti\.voltcouch\.com/s/[\w./%-]+")
RUNNABLE = ("todo", "in_progress", "in_review", "failed")

def project_finish(c, p):
    """(signature, finished_at) when the project counts as finished, else None."""
    if p["status"] not in ("executing", "paused", "done"):
        return None
    tks = c.execute("SELECT state, assignee, finished, updated FROM tickets WHERE project=?", (p["key"],)).fetchall()
    if not any(t["state"] == "done" for t in tks):
        return None
    if p["status"] != "done":
        if p["evergreen"]:
            return None
        if any(t["state"] in RUNNABLE and not (t["assignee"] == "human" and t["state"] == "todo") for t in tks):
            return None
    last = max((t["finished"] or t["updated"] or "") for t in tks if t["state"] in FINAL)
    return f"{len(tks)}:{last}", last

def _clip(x, n):
    x = (x or "").strip()
    return x if len(x) <= n else x[:n - 1] + "…"

def _last_reason(c, key):
    r = c.execute("SELECT body FROM events WHERE ticket=? AND kind IN ('state','comment') AND body<>'' ORDER BY id DESC LIMIT 1", (key,)).fetchone()
    return r["body"] if r else ""

def _pr_info(repo, num):
    try:
        r = subprocess.run(["gh", "pr", "view", num, "-R", repo, "--json", "title,state,mergedAt,mergeCommit"],
                           capture_output=True, text=True, timeout=12)
        return json.loads(r.stdout) if r.returncode == 0 and r.stdout.strip() else None
    except Exception:
        return None

def _deploy_state(p, prs):
    """For repos that tag their deploys (prod/*): the earliest prod tag that contains the last merge."""
    repo = p["repo"]
    merged = sorted((x for x in prs if x.get("mergedAt") and (x.get("mergeCommit") or {}).get("oid")), key=lambda x: x["mergedAt"])
    if not repo or not Path(repo, ".git").exists():
        return "No local repo: deploy state unknown."
    if not merged:
        return "No merged PR found: nothing to deploy."
    last = merged[-1]
    sha = last["mergeCommit"]["oid"]
    try:
        subprocess.run(["git", "-C", repo, "fetch", "--tags", "--quiet"], capture_output=True, timeout=30)
        tags = subprocess.run(["git", "-C", repo, "tag", "--list", "prod/*"], capture_output=True, text=True, timeout=10).stdout.split()
        if not tags:
            return f"Last merge {sha[:9]} (PR #{last['num']}, {last['mergedAt']}); this repo has no prod/* deploy tags, so deploy state is unknown."
        has = subprocess.run(["git", "-C", repo, "tag", "--contains", sha, "--list", "prod/*", "--sort=creatordate"],
                             capture_output=True, text=True, timeout=10).stdout.split()
    except Exception as e:
        return f"Could not read deploy tags: {e}"
    if has:
        return f"DEPLOYED: the last merge {sha[:9]} (PR #{last['num']}) is in prod tag {has[0]} (newest prod tag: {sorted(tags)[-1]})."
    return f"NOT DEPLOYED: the last merge {sha[:9]} (PR #{last['num']}, {last['mergedAt']}) is in no prod tag yet (newest prod tag: {sorted(tags)[-1]})."

def wrapup_inputs(c, key, gh=True, limit=24000):
    """Everything the wrap-up session summarizes, collected here so the session only writes."""
    p = project_row(c, key)
    fin = project_finish(c, p)
    tks = c.execute("SELECT * FROM tickets WHERE project=? ORDER BY id", (p["key"],)).fetchall()
    L = [f"# Project {p['key']}: {p['name']}", f"Status: {p['status']}{' (evergreen)' if p['evergreen'] else ''}. "
         f"Finished: {fin[1] if fin else 'not yet'}. Created {p['created']}. Repo: {p['repo'] or '-'}."]
    if p["doc_slug"]:
        L.append(f"Design doc: https://arti.voltcouch.com/s/{p['doc_slug']}")
    if (p["instructions"] or "").strip():
        L += ["", "## Description and standing instructions", _clip(p["instructions"], 2000)]
    mem = area_notes(c, p["key"], "memory", limit=30)
    if mem:
        L += ["", "## Project memory (facts and decisions)"] + [f"- {n['created'][:10]}{' ' + n['ticket'] if n['ticket'] else ''}: {_clip(n['body'], 300)}" for n in mem]
    ms = c.execute("SELECT * FROM milestones WHERE project=? ORDER BY seq", (p["key"],)).fetchall()
    if ms:
        L += ["", "## Milestones and showcases"]
        for m in ms:
            L.append(f"- {m['key']} [{m['status']}] {m['title']}" + (f" (reached {m['reached']})" if m["reached"] else ""))
            for sc in json.loads(m["showcases"] or "[]"):
                L.append(f"  - {sc.get('kind')}: {sc.get('url') or sc.get('file') or ''} {_clip(sc.get('note'), 200)}")
    # PRs named in results, with their titles and merge state from GitHub (bounded).
    pr_by_ticket, seen, prs = {}, {}, []
    for t in tks:
        for repo, num in PR_URL.findall(f"{t['result'] or ''}"):
            pr_by_ticket.setdefault(t["key"], []).append((repo, num))
            if (repo, num) not in seen and len(seen) < 40:
                info = (_pr_info(repo, num) if gh else None) or {}
                info.update(repo=repo, num=num, ticket=t["key"])
                seen[(repo, num)] = info; prs.append(info)
    per_result = max(300, min(900, (limit // 2) // max(1, len(tks))))
    L += ["", f"## Tickets ({len(tks)})"]
    for t in tks:
        head = f"- {t['key']} [{t['state']}]{' (human)' if t['assignee'] == 'human' else ''} {t['title']}"
        if t["finished"]:
            head += f" (finished {t['finished'][:16]})"
        L.append(head)
        for repo, num in pr_by_ticket.get(t["key"], []):
            i = seen.get((repo, num)) or {}
            L.append(f"  PR https://github.com/{repo}/pull/{num}: {i.get('state', '?')} {i.get('title', '')}".rstrip())
        if t["state"] in ("done", "in_review") and t["result"]:
            L.append("  Result: " + _clip(t["result"], per_result).replace("\n", " "))
        elif t["state"] in ("canceled", "failed"):
            L.append("  Last reason: " + _clip(t["result"] or _last_reason(c, t["key"]), 400).replace("\n", " "))
        elif t["state"] == "backlog" or (t["assignee"] == "human" and t["state"] not in FINAL):
            L.append("  Parked, waiting on: " + _clip(_last_reason(c, t["key"]) or t["body"] or "(no reason given)", 300).replace("\n", " "))
    links = set()
    for t in tks:
        links.update(ARTI_URL.findall(f"{t['body']} {t['result'] or ''}"))
        if t["doc_slug"]:
            links.add(f"https://arti.voltcouch.com/s/{t['doc_slug']}")
    if links:
        L += ["", "## Arti docs and links found in tickets"] + [f"- {u.rstrip('.,);')}" for u in sorted(links)][:40]
    L += ["", "## Deploy state", _deploy_state(p, prs) if gh else "(not checked)"]
    text = "\n".join(L)
    return text if len(text) <= limit else text[:limit - 40] + "\n…(truncated)"

def wrapup_prompt(c, key, gh=True):
    return (
        "You write the wrap-up report of a finished backlog project, for its owner to read at a glance. Use ONLY the facts below; "
        "never invent numbers, PRs or links. Reply with the Markdown report only (no preamble, no code fence), about one screen, "
        "with exactly these sections as `## ` headings, in this order:\n"
        "## TL;DR: at most 3 short sentences, plain words, what the project achieved.\n"
        "## Before → After: what users or the system could do before vs now; use the before/after numbers the results give (timings, sizes, counts).\n"
        "## What shipped: bullets `KEY title → [#N](PR url)`, merged work only, grouped or trimmed to the ones that matter (at most ~12).\n"
        "## Key artifacts: arti docs, showcase pages, screenshots and other links, as Markdown links; 'None' if there are none.\n"
        "## Decisions and dropped work: key decisions from project memory, and canceled or failed tickets with their reasons.\n"
        "## Left over: parked tickets still in backlog or with the human, and what each waits for; 'Nothing' if none.\n"
        "## Live?: deployed (name the prod tag), merged but not deployed, or unknown, from the deploy state below.\n\n"
        + wrapup_inputs(c, key, gh))

def report_tldr(md):
    m = re.search(r"^#+\s*TL;?DR\s*:?\s*\n(.*?)(?=^#+\s|\Z)", md, flags=re.S | re.M | re.I)
    text = (m.group(1) if m else md).strip()
    return _clip(re.sub(r"\s+", " ", text), 600)

def store_report(c, key, md, by, model=None, sig=None):
    p = project_row(c, key)
    meta = json.loads(p["meta"] or "{}")
    fin = project_finish(c, p)
    meta["report"] = {"md": md.strip(), "tldr": report_tldr(md), "at": now(), "by": by, "model": model,
                      "sig": sig or (fin[0] if fin else None), "finished_at": fin[1] if fin else None}
    meta.pop("wrapup", None)
    c.execute("UPDATE projects SET meta=? WHERE key=?", (json.dumps(meta), p["key"]))
    event(c, "report", project=p["key"], body=f"wrap-up report stored ({by}): {meta['report']['tldr'][:200]}", actor=by)

def set_wrapup(c, key, **kw):
    p = project_row(c, key)
    meta = json.loads(p["meta"] or "{}")
    w = {**(meta.get("wrapup") or {}), **kw}
    meta["wrapup"] = {k: v for k, v in w.items() if v is not None}
    c.execute("UPDATE projects SET meta=? WHERE key=?", (json.dumps(meta), p["key"]))

def generate_report(c, key, by):
    """Run the wrap-up session now (blocking) and store its report. Returns the Markdown."""
    p = project_row(c, key)
    fin = project_finish(c, p)
    sig = fin[0] if fin else None
    model = str(setting(c, "wrapup_model", p["key"]))
    with tx(c):
        prev = (json.loads(p["meta"] or "{}").get("wrapup") or {})
        tries = prev.get("tries", 0) + 1 if prev.get("sig") == sig else 1
        set_wrapup(c, p["key"], pid=os.getpid(), started=now(), sig=sig, tries=tries, error=None)
        event(c, "report", project=p["key"], body=f"wrap-up session started ({model}, by {by})", actor=by)
    env = {k: v for k, v in os.environ.items() if not k.startswith("BL_") and k != "CLAUDE_CODE_SESSION_ID"}
    env["BL_DB"] = str(DB)   # it doesn't need bl, but if it looks, it sees the same DB
    err = None
    try:
        r = subprocess.run(["claude", "-p", wrapup_prompt(c, p["key"]), "--model", model], cwd=str(Path.home()), env=env,
                           capture_output=True, text=True, timeout=60 * 10)
        md = r.stdout.strip()
        md = re.sub(r"^```(?:markdown|md)?\s*\n(.*?)\n```\s*$", r"\1", md, flags=re.S)
        if r.returncode != 0 or not md:
            err = f"exit {r.returncode}: {(r.stderr or r.stdout).strip()[:300]}"
        elif "tl;dr" not in md.lower():
            err = f"no TL;DR section in the reply: {md[:200]}"
    except (OSError, subprocess.TimeoutExpired) as e:
        err = str(e)[:300]
    with tx(c):
        if err:
            set_wrapup(c, p["key"], pid=None, error=err, failed=now())
            event(c, "report", project=p["key"], body=f"wrap-up failed: {err}", actor=by)
        else:
            store_report(c, p["key"], md, by, model=model, sig=sig)
    if err:
        die(f"wrap-up failed: {err}")
    return md

def wrapup_due(c):
    """Finished projects whose current finish has no report yet (within the window, not running, not given up)."""
    days = setting(c, "wrapup_window_days")
    since = (datetime.now(timezone.utc) - timedelta(days=days)).strftime("%Y-%m-%dT%H:%M:%SZ")
    out = []
    for p in c.execute("SELECT * FROM projects WHERE status IN ('executing','paused','done') ORDER BY key").fetchall():
        meta = json.loads(p["meta"] or "{}")
        w = meta.get("wrapup") or {}
        if w.get("pid") and alive(w["pid"]):
            continue
        requested = bool(w.get("requested"))
        fin = project_finish(c, p)
        if not requested and (not fin or fin[1] < since or (meta.get("report") or {}).get("sig") == fin[0]):
            continue
        if not requested and w.get("sig") == (fin and fin[0]) and w.get("tries", 0) >= 2:
            continue   # gave up on this finish; Regenerate (requested) tries again
        out.append(p)
    return out

def wrapup_reports(c, jobs, me):
    """Daemon: one wrap-up session at a time, each a detached `bl project report KEY --generate`."""
    for k, (pr, t0) in list(jobs.items()):
        if pr.poll() is None:
            if time.monotonic() - t0 > 60 * 12:
                try: os.killpg(pr.pid, signal.SIGTERM)
                except Exception: pr.kill()
            continue
        del jobs[k]
    if jobs or not setting(c, "wrapup_reports") or not spawning(c) or quota_until(c):
        return
    for p in wrapup_due(c)[:1]:
        LOGS.mkdir(parents=True, exist_ok=True)
        with tx(c):
            set_wrapup(c, p["key"], requested=None, pid=None)
        try:
            with open(LOGS / f"wrapup-{p['key']}.log", "w") as f:
                pr = subprocess.Popen([sys.executable, str(SELF), "project", "report", p["key"], "--generate", "--by", me],
                                      cwd=str(HOME), stdout=f, stderr=subprocess.STDOUT, start_new_session=True)
        except OSError as e:
            with tx(c):
                set_wrapup(c, p["key"], error=str(e)[:200], failed=now())
            return
        jobs[p["key"]] = (pr, time.monotonic())
        notify(c, p["key"], f"{p['key']} finished: writing its wrap-up report ({setting(c, 'wrapup_model', p['key'])})")

def cmd_report(a):
    c = connect()
    p = project_row(c, a.key)
    if a.prompt:
        print(wrapup_prompt(c, p["key"], gh=not a.no_gh)); return
    if a.set is not None:
        md = sys.stdin.read() if a.set == "-" else Path(a.set).read_text()
        if not md.strip():
            die("empty report")
        with tx(c):
            store_report(c, p["key"], md, a.by or agent_id())
        print("ok"); return
    if a.request:   # chito's Regenerate: the daemon picks it up on its next pass (or start it now with --generate)
        with tx(c):
            set_wrapup(c, p["key"], requested=now(), tries=0, error=None)
            event(c, "report", project=p["key"], body="wrap-up report requested", actor=a.by or agent_id())
        print("requested: the daemon writes the report on its next pass"); return
    if a.generate:
        md = generate_report(c, p["key"], a.by or agent_id())
        print(md); return
    rep = json.loads(p["meta"] or "{}").get("report")
    if a.json:
        print(json.dumps({"report": rep, "wrapup": json.loads(p["meta"] or "{}").get("wrapup"),
                          "finish": project_finish(c, p)}, indent=1)); return
    if not rep:
        die(f"{p['key']} has no wrap-up report yet (bl project report {p['key']} --generate)", 0)
    print(f"<!-- {p['key']} wrap-up, {rep['at']} by {rep['by']}{' (' + rep['model'] + ')' if rep.get('model') else ''} -->\n{rep['md']}")

ORCH_QUICK_SECONDS = 60   # an orchestrator that fails faster than this did not get to work (login, flags, API errors)
ORCH_BACKOFF = {}          # project -> (crashes in a row, monotonic time before which no new orchestrator starts)

def auto_projects(c, children, orchs, me, probe_active=None):
    """executor=auto: start a coordinator for ready tickets, or a queue worker below the threshold."""
    # finished orchestrators
    for pk, (pr, ag, t0, lf) in list(orchs.items()):
        if pr.poll() is None:
            if time.monotonic() - t0 > 60 * setting(c, "worker_timeout_minutes", pk) * 3:
                try: os.killpg(pr.pid, signal.SIGTERM)
                except Exception: pr.terminate()
                notify(c, pk, f"{pk} orchestrator timed out; terminated")
            continue
        del orchs[pk]; lf.close()
        tail = log_tail(lf.name)
        hit, _ = detect_quota(tail) if pr.returncode != 0 else (False, None)
        # Quick and fruitless: failed fast, or exited fast while its tickets are still ready (it did no work).
        quick = not hit and time.monotonic() - t0 < ORCH_QUICK_SECONDS and \
            (pr.returncode != 0 or bool(ready(c, pk, me, None, "auto1")))
        with tx(c):
            left = c.execute("SELECT * FROM tickets WHERE state='in_progress' AND claimed_by=?", (ag,)).fetchall()
            until = note_quota(c, None, tail, me, project=pk) if hit else None
            for t in left:
                release_ticket(c, t, "usage limit" if hit else f"orchestrator exited ({pr.returncode})", count_failure=not hit, actor=me)
            c.execute("UPDATE projects SET owner=NULL WHERE key=? AND owner=?", (pk, ag))
            event(c, "run", project=pk, body=f"orchestrator session ended ({pr.returncode})" + (f"; usage limit until {until}" if hit else ""), actor=ag)
        if quick:
            n = ORCH_BACKOFF.get(pk, (0, 0))[0] + 1
            wait = min(60, 2 ** (n - 1))
            ORCH_BACKOFF[pk] = (n, time.monotonic() + wait * 60)
            last = " / ".join(l.strip() for l in tail.strip().splitlines()[-3:])[:300] or "no output"
            with tx(c):
                event(c, "run", project=pk, body=f"orchestrator ended after under a minute ({pr.returncode}) with tickets still ready, {n} in a row; next try in {wait} min: {last}", actor=me)
            notify(c, pk, f"{pk}: orchestrator ended ({pr.returncode}) within a minute without working the ready tickets, {n} in a row; retrying in {wait} min. Log: {lf.name}. Last output: {last}")
            continue
        ORCH_BACKOFF.pop(pk, None)
        notify(c, pk, f"{pk} orchestrator session finished" + (f" (usage limit, paused until {until})" if hit else ""))
    if not spawning(c) or quota_until(c) or (probe_active and probe_active()):
        return
    adopt = setting(c, "orphan_policy") == "adopt"
    quiet_since = (datetime.now(timezone.utc) - timedelta(minutes=setting(c, "adopt_after_minutes"))).strftime("%Y-%m-%dT%H:%M:%SZ")
    for p in c.execute("SELECT * FROM projects WHERE status='executing' AND executor IN ('auto','session') ORDER BY key").fetchall():
        if p["key"] in orchs or project_has_live_owner(c, p):
            continue
        if ORCH_BACKOFF.get(p["key"], (0, 0))[1] > time.monotonic():
            continue
        adopting = p["executor"] == "session"
        if adopting:
            if not adopt:
                continue
            busy = c.execute("SELECT 1 FROM events WHERE project=? AND at>? LIMIT 1", (p["key"], quiet_since)).fetchone() or \
                   c.execute("SELECT 1 FROM tickets WHERE project=? AND state='in_progress' LIMIT 1", (p["key"],)).fetchone()
            if busy:
                continue
        rd = ready(c, p["key"], me, None, "adopt" if adopting else "auto1")
        if not rd:
            continue
        cap = setting(c, "daemon_max_parallel")
        if len(children) + len(orchs) >= cap:
            return
        if adopting or len(rd) >= setting(c, "orchestrate_min_ready", p["key"]):
            ag = f"orchs:{p['key']}:{int(time.time()) % 1000000}"
            cwd = p["repo"] if p["repo"] and Path(p["repo"]).exists() else str(HOME)
            LOGS.mkdir(parents=True, exist_ok=True)
            lf = open(LOGS / f"orchestrator-{p['key']}-{int(time.time())}.log", "w")
            env = {k: v for k, v in os.environ.items() if k not in ("BL_IN_ORCH", "CLAUDE_CODE_SESSION_ID", "BL_TICKET", "BL_DAEMON")}
            env.update({"BL_AGENT": ag, "BL_OWNER": ag, "BL_ORCH_PROJECT": p["key"], "BL_DB": str(DB),
                        "BL_MODEL": str(setting(c, "orchestrator_model", p["key"])),
                        "PATH": f"{Path(__file__).resolve().parent}:{os.environ.get('PATH', '')}"})
            claude_only = all(harness_for(c, t) == "claude" for t in rd)
            if claude_only:
                prompt = orchestrator_prompt(c, p["key"], ag)
                cmd = ["claude", "-p", prompt, "--model", env["BL_MODEL"], "--permission-mode", "bypassPermissions",
                       "--append-system-prompt", f"You are the backlog orchestrator for {p['key']}. Keep going until nothing is ready."]
            else:
                # bl run coordinates the DAG and launches each ticket with its effective harness/model.
                cmd = [sys.executable, str(Path(__file__).resolve()), "run", p["key"], "--until", "done"]
                env.pop("BL_AGENT", None)
                env.pop("BL_OWNER", None)
                env["BL_DAEMON"] = "1"
            pr = subprocess.Popen(cmd,
                                  cwd=cwd, env=env, stdout=lf, stderr=subprocess.STDOUT, start_new_session=True)
            orchs[p["key"]] = (pr, ag, time.monotonic(), lf)
            with tx(c):
                if claude_only:
                    c.execute("UPDATE projects SET owner=?, owner_heartbeat=? WHERE key=?", (ag, now(), p["key"]))
                event(c, "run", project=p["key"], body=(f"daemon adopted the stalled project: " if adopting else "") +
                      f"{'Claude session' if claude_only else 'bl run'} orchestrator started for {len(rd)} ready tickets", actor=ag,
                      data={"pid": pr.pid, "log": lf.name, "cwd": cwd, "adopted": adopting, "kind": "claude" if claude_only else "bl-run"})
            notify(c, p["key"], f"{p['key']}: {'adopted (no live session); ' if adopting else ''}started {'Claude session' if claude_only else 'bl run'} orchestrator for {len(rd)} ready tickets, log {lf.name}")
        else:
            ag = f"{me}:a{int(time.time()) % 100000}"
            t, why = claim(c, p["key"], rd[0]["key"], agent=ag, mode="auto1")
            if not t:
                continue
            got = spawn_worker(c, t, ag, me)
            if got:
                children[t["key"]] = (got[0], ag, time.monotonic(), got[1])
                notify(c, p["key"], f"daemon started {t['key']} ({t['title']}) as a single ticket")


# ---------------------------------------------------------------- hooks
def cmd_hook(a):
    """Claude Code hooks. Reads hook JSON on stdin. Never fails loudly."""
    try:
        data = json.load(sys.stdin)
    except Exception:
        data = {}
    if not DB.exists():
        return
    c = connect()
    tk = os.environ.get("BL_TICKET")
    sid = data.get("session_id") or os.environ.get("CLAUDE_CODE_SESSION_ID") or ""
    me = os.environ.get("BL_AGENT") or (f"cc:{sid[:8]}" if sid else None)
    if a.event == "session-start":
        if tk:
            t = c.execute("SELECT * FROM tickets WHERE key=?", (tk,)).fetchone()
            if t:
                print(build_prompt(c, t, compact=data.get("source") == "compact"))
            return
        if me:
            mine = c.execute("SELECT key,title FROM tickets WHERE state='in_progress' AND claimed_by=?", (me,)).fetchall()
            if mine:
                print("Backlog: this session holds " + ", ".join(f"{m['key']} ({m['title']})" for m in mine) +
                      ". Finish each with bl done / bl fail / bl release.")
    elif a.event == "stop":
        op = os.environ.get("BL_ORCH_PROJECT")
        if op and not tk and not data.get("stop_hook_active") and not quota_until(c):
            ag = os.environ.get("BL_AGENT")
            mine = c.execute("SELECT key FROM tickets WHERE state='in_progress' AND claimed_by=?", (ag,)).fetchall()
            rd = ready(c, op, ag, None, "session")
            if mine or rd:
                print(json.dumps({"decision": "block", "reason":
                    f"You are the orchestrator for {op}: " + (f"{len(rd)} tickets are ready" if rd else "") +
                    (f"{' and ' if rd else ''}{', '.join(m['key'] for m in mine)} still in progress" if mine else "") +
                    ". Keep going: claim, dispatch subagents, record results."}))
            return
        if not tk or data.get("stop_hook_active"):
            return
        t = c.execute("SELECT * FROM tickets WHERE key=?", (tk,)).fetchone()
        if t and t["state"] == "in_progress" and t["claimed_by"] == os.environ.get("BL_AGENT"):
            print(json.dumps({"decision": "block", "reason":
                f"Ticket {tk} is still in_progress. Report it before stopping: `bl done {tk} -m \"...\"`, "
                f"`bl fail {tk} -m \"...\"`, or `bl release {tk} --reason \"...\"`."}))
    elif a.event == "pre-tool":
        why = pre_tool_guard(c, data)
        if why:
            print(json.dumps({"hookSpecificOutput": {"hookEventName": "PreToolUse", "permissionDecision": "deny",
                                                     "permissionDecisionReason": why}}))
        return
    elif a.event == "beat":
        # PostToolUse: keep leases of tickets this session holds alive (cheap; throttled by lease math)
        if me and c.execute("SELECT 1 FROM projects WHERE owner=? LIMIT 1", (me,)).fetchone():
            with tx(c):
                c.execute("UPDATE projects SET owner_heartbeat=? WHERE owner=?", (now(), me))
        if me and c.execute("SELECT 1 FROM tickets WHERE state='in_progress' AND claimed_by=? LIMIT 1", (me,)).fetchone():
            with tx(c):
                c.execute("UPDATE tickets SET lease_until=? WHERE state='in_progress' AND claimed_by=? AND lease_until < ?",
                          (later(setting(c, "lease_minutes")), me, later(setting(c, "lease_minutes") - 5)))


# ---------------------------------------------------------------- argparse
def main():
    ap = argparse.ArgumentParser(prog="bl", description="local backlog: tickets, DAG deps, leases, orchestrator")
    sp = ap.add_subparsers(dest="cmd", required=True)
    def P(name, fn, **kw):
        p = sp.add_parser(name, **kw); p.set_defaults(fn=fn); p.add_argument("--json", action="store_true"); return p

    P("init", cmd_init)
    p = P("project", cmd_project)
    p.add_argument("action", choices=["add", "ls", "set", "start", "pause", "resume", "plan", "archive", "done", "report"]); p.add_argument("key", nargs="?")
    p.add_argument("--executor", choices=["daemon", "session", "auto"]); p.add_argument("--evergreen", action="store_true")
    p.add_argument("name", nargs="?"); p.add_argument("--repo"); p.add_argument("--doc"); p.add_argument("--review", choices=["self", "pr", "ask"])
    p.add_argument("--soft", action="store_true", help="pause/plan/archive: let running work finish instead of stopping it now")
    p.add_argument("--set", help="report: store this Markdown file (- for stdin) as the report")
    p.add_argument("--generate", action="store_true", help="report: run the wrap-up session now and store its report")
    p.add_argument("--request", action="store_true", help="report: ask the daemon to (re)write the report on its next pass")
    p.add_argument("--prompt", action="store_true", help="report: print the wrap-up prompt (the collected inputs) instead")
    p.add_argument("--no-gh", dest="no_gh", action="store_true", help="report --prompt: skip GitHub and git lookups")
    p.add_argument("--by", help="report: who wrote it (default: this agent)")
    p.add_argument("fields", nargs="*")
    p = P("add", cmd_add); p.add_argument("project"); p.add_argument("title"); p.add_argument("-b", "--body"); p.add_argument("-f", "--file")
    p.add_argument("--after", help="blockers, comma-separated"); p.add_argument("--blocks", help="tickets that wait on this one")
    p.add_argument("-p", "--priority", type=int, default=2); p.add_argument("-e", "--estimate", type=int)
    p.add_argument("-l", "--labels"); p.add_argument("--lock"); p.add_argument("--assignee"); p.add_argument("--doc")
    p.add_argument("--parent"); p.add_argument("--state", default="todo"); p.add_argument("--max-attempts", type=int)
    p.add_argument("--review", choices=["self", "pr", "ask"]); p.add_argument("--size", choices=["s", "m", "l", "xl"])
    p.add_argument("--model", help="worker model for this ticket, e.g. sonnet for simple work (default: opus)")
    p.add_argument("--executor", choices=["daemon", "session"], help="override the project's executor for this ticket")
    p.add_argument("--milestone", help="milestone key, e.g. PROJ-M1")
    p.add_argument("--force", action="store_true")
    p = P("ls", cmd_ls); p.add_argument("project", nargs="?"); p.add_argument("--state"); p.add_argument("--all", action="store_true")
    p.add_argument("--ready", action="store_true"); p.add_argument("--mine", action="store_true"); p.add_argument("--assignee")
    p = P("show", cmd_show); p.add_argument("key")
    p = P("next", cmd_next); p.add_argument("project", nargs="?")
    p = P("graph", cmd_graph); p.add_argument("project"); p.add_argument("--mermaid", action="store_true"); p.add_argument("--all", action="store_true")
    p = P("dep", cmd_dep); p.add_argument("action", choices=["add", "rm"]); p.add_argument("ticket"); p.add_argument("blocker")
    p.add_argument("--force", action="store_true")
    p = P("claim", cmd_claim); p.add_argument("project", nargs="?"); p.add_argument("key", nargs="?")
    p.add_argument("--lease", type=int); p.add_argument("--force", action="store_true")
    p = P("beat", cmd_beat); p.add_argument("keys", nargs="*"); p.add_argument("--lease", type=int)
    p = P("release", cmd_release); p.add_argument("key"); p.add_argument("--reason"); p.add_argument("--force", action="store_true")
    p = P("resolve", cmd_resolve); p.add_argument("key"); p.add_argument("-m", "--message")
    p.add_argument("--state", choices=["done", "canceled"], default="done"); p.add_argument("--force", action="store_true")
    p.add_argument("--force-merge", dest="force_merge", action="store_true", help="mark done even though a linked PR is not merged")
    p = P("brief-prompt", cmd_brief_prompt); p.add_argument("key")
    p = P("tldr", cmd_tldr); p.add_argument("key"); p.add_argument("text", nargs="?", help="the TL;DR, - for stdin, '' to clear; none prints it")
    p.add_argument("--by")
    p = P("handoff", cmd_handoff); p.add_argument("key"); p.add_argument("--packet", help="packet JSON file, or - for stdin")
    p.add_argument("--phase", choices=["preparing", "awaiting", "discussing"]); p.add_argument("--force", action="store_true")
    p = P("done", cmd_done); p.add_argument("key"); p.add_argument("-m", "--message"); p.add_argument("--tldr", help="for the human, if it lands on them (review): " + TLDR_RULE); p.add_argument("--force", action="store_true")
    p.add_argument("--final", action="store_true", help="skip review: go straight to done")
    p.add_argument("--force-merge", dest="force_merge", action="store_true", help="mark done even though a linked PR is not merged")
    p = P("fail", cmd_fail); p.add_argument("key"); p.add_argument("-m", "--message"); p.add_argument("--tldr", help="for the human: " + TLDR_RULE); p.add_argument("--force", action="store_true")
    p = P("park", cmd_park, help="PR ready but can't merge yet (blockers or red main): free the slot; resume when it can")
    p.add_argument("key"); p.add_argument("--pr"); p.add_argument("--until", choices=["blockers", "main", "both"])
    p.add_argument("--force", action="store_true")
    p = P("stage", cmd_stage, help="code done and PR open, tests running: let dependents start on your branch (speculate)")
    p.add_argument("key"); p.add_argument("--branch"); p.add_argument("--pr"); p.add_argument("--clear", action="store_true")
    p.add_argument("--force", action="store_true")
    p = P("comment", cmd_comment); p.add_argument("key"); p.add_argument("text", nargs="+")
    p = P("move", cmd_move); p.add_argument("key"); p.add_argument("state"); p.add_argument("--reason")
    p.add_argument("--force-merge", dest="force_merge", action="store_true", help="mark done even though a linked PR is not merged")
    p.add_argument("--reset", action="store_true", help="with todo: reset attempts")
    p = P("set", cmd_set); p.add_argument("key"); p.add_argument("fields", nargs="+", help="field=value")
    p = P("config", cmd_config); p.add_argument("scope", help="global | MAP | project:MAP | repo:/path/to/repo | label:ui")
    p.add_argument("key", nargs="?"); p.add_argument("value", nargs="?"); p.add_argument("extra", nargs="*")
    p = P("prompt", cmd_prompt); p.add_argument("key"); p.add_argument("--compact", action="store_true")
    p = P("worktree", cmd_worktree); p.add_argument("key")
    P("status", cmd_status)
    p = P("log", cmd_log); p.add_argument("project", nargs="?"); p.add_argument("-n", type=int, default=30)
    p = P("export", cmd_export); p.add_argument("project")
    p = P("run", cmd_run); p.add_argument("project"); p.add_argument("--parallel", type=int)
    p.add_argument("--until", choices=["done", "forever"], default="done"); p.add_argument("--dry-run", action="store_true")
    p.add_argument("--force", action="store_true")
    p = P("milestone", cmd_milestone)
    p.add_argument("action", choices=["add", "ls", "show", "set", "showcase", "reach", "cancel", "accept", "reopen"])
    p.add_argument("target", help="project (add, ls) or milestone key"); p.add_argument("title", nargs="?")
    p.add_argument("fields", nargs="*"); p.add_argument("-b", "--body")
    p.add_argument("--trigger", choices=["all", "deploy", "manual"], default="all")
    p.add_argument("--gate", help="ticket whose completion reaches the milestone (with --trigger deploy)")
    p.add_argument("--showcase", choices=["screenshot", "demo", "localhost", "link", "none"], default="screenshot")
    p.add_argument("--due"); p.add_argument("--seq", type=int)
    p.add_argument("--kind", choices=["screenshot", "demo", "localhost", "link", "note"]); p.add_argument("--file"); p.add_argument("--url"); p.add_argument("--note")
    p = P("orchestrate-prompt", cmd_orchestrate_prompt); p.add_argument("project")
    p = P("area", cmd_area, help="the project area: memory, messages, who is touching what, recently done")
    p.add_argument("project", help="project or ticket key")
    for name, kind, hlp in (("memo", "memory", "add a durable project fact or decision"),
                            ("say", "msg", "post a heads-up to everyone working on the project"),
                            ("touching", "touching", "say which files or areas your ticket is changing")):
        p = P(name, lambda a, k=kind: add_note(a, k), help=hlp); p.add_argument("target", help="project or ticket key")
        p.add_argument("text", nargs="+", help="the note, or - for stdin")
    p = P("forget", cmd_forget, help="archive a project-area note"); p.add_argument("id", type=int)
    p = P("instructions", cmd_instructions); p.add_argument("project"); p.add_argument("--set", help="new text, or - for stdin; empty clears")
    p = P("quota", cmd_quota); p.add_argument("action", nargs="?", default="status", choices=["status", "clear", "set"])
    p.add_argument("minutes", nargs="?", type=int)
    p = P("daemon", cmd_daemon); p.add_argument("action", choices=["run", "status", "pause", "resume", "install", "uninstall"])
    p = P("hook", cmd_hook); p.add_argument("event", choices=["session-start", "stop", "beat", "pre-tool"])
    p = P("main", cmd_main, help="is the repo's main green? status (exit 1 when red), wait, or record red/green")
    p.add_argument("action", nargs="?", default="status", choices=["status", "wait", "red", "green"])
    p.add_argument("--repo"); p.add_argument("--sha"); p.add_argument("--green-sha", dest="green_sha")
    p.add_argument("--suites"); p.add_argument("--ticket"); p.add_argument("--timeout", type=int, default=1800)

    # convenience aliases for states
    for st, alias in (("reopen", "todo"), ("cancel", "canceled"), ("approve", "done")):
        p = sp.add_parser(st); p.add_argument("key"); p.add_argument("--reason"); p.add_argument("--json", action="store_true")
        p.add_argument("--force-merge", dest="force_merge", action="store_true", help="approve: mark done even though a linked PR is not merged")
        p.set_defaults(fn=lambda a, s=alias: (setattr(a, "state", s), setattr(a, "reset", s == "todo"), cmd_move(a)))

    a = ap.parse_args()
    a.fn(a)

if __name__ == "__main__":
    main()
